// main.klx — KylixAdmin console (v0.11.0 P3)
//
// The program file is now just the shell: authentication (v0.10.0 P2) and the
// dashboard live here; every data table is served by the generic CRUD engine in
// controllers/entity.klx, driven by the [Entity] metadata declared in
// entities/admin_entities.klx.
//
// Multi-file build (both backends, same sources):
//   kylix build stdlib/stringutil.klx stdlib/template_engine.klx \
//     entities/admin_entities.klx lib/admindb.klx lib/adminsec.klx \
//     lib/audit.klx lib/crud.klx lib/crudrender.klx lib/crudhooks.klx \
//     lib/adminpage.klx controllers/entity.klx controllers/dashboard.klx \
//     controllers/profile.klx controllers/theme.klx main.klx
//
// Run from apps/admin/ (views/ + static/ are relative paths); KYADMIN_DB and
// KYADMIN_PASSWORD override the database path and seed password.
// v0.12.0: bake the templates and static assets into the binary. ReadFile and
// the boot static handler consult the embedded table first, so the built
// binary needs no views/ or static/ directory beside it.
[Embed('views', 'static')]
program KylixAdmin;

uses boot, db, admindb, adminsec, audit, template, sysutil, adminpage,
  entity, dashboard, profile, theme;

[Controller('')]
type
  TAuthController = class
    [Get('/login')]
    function LoginPage(req: TRequest): TResponse;
    var
      eng: TTemplateEngine;
    begin
      eng := TTemplateEngine.Create();
      eng.AddVar('page_title', 'Sign in');
      eng.AddVar('user', '');
      eng.AddVar('csrf', req.SessionCSRFToken());
      eng.AddVar('error', '');
      eng.AddVar('nav', '');
      AddThemeVars(eng, req);
      result := BootHTML(200, RenderView(eng, 'login'));
    end;

    [Post('/login')]
    function LoginSubmit(req: TRequest): TResponse;
    var
      eng: TTemplateEngine;
      db: TDatabase;
      user: String;
      pass: String;
      errMsg: String;
    begin
      user := req.Form('username');
      pass := req.Form('password');
      db := AdminOpen('admin.db');
      errMsg := DoLogin(db, req, user, pass);
      if errMsg <> '' then
      begin
        eng := TTemplateEngine.Create();
        eng.AddVar('page_title', 'Sign in');
        eng.AddVar('user', '');
        eng.AddVar('csrf', req.SessionCSRFToken());
        eng.AddVar('error', errMsg);
        eng.AddVar('nav', '');
        AddThemeVars(eng, req);
        result := BootHTML(200, RenderView(eng, 'login'));
      end
      else
        result := BootHTML(302, '').Redirect('/dashboard');
    end;

    [Post('/logout')]
    function Logout(req: TRequest): TResponse;
    begin
      DoLogout(req);
      result := BootHTML(302, '').Redirect('/login');
    end;
  end;

var
  db: TDatabase;
  port: Integer;

begin
  db := AdminOpen('admin.db');
  EnsureSchema(db);
  SeedIfEmpty(db);
  BootUseCSRF();
  BootStatic('static');
  BootNotFoundPage('<html><body><h1>404 Not Found</h1><p><a href="/login">Sign in</a></p></body></html>');
  port := StrToInt(GetEnv('KYADMIN_PORT'));
  if port = 0 then
    port := 8090;
  // One startup line an operator can act on: which database, which dialect,
  // which port. The templates and static assets are baked into the binary
  // ([Embed]), so there is nothing else to report.
  WriteLn('[kyadmin] dialect=' + SqlDialect() + ' db=' + AdminDBPath() + ' port=' + IntToStr(port));
  BootRun(port);
end.
