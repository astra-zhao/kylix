// main.klx — KylixAdmin console (v0.10.0 P2)
//
// Phase 2 slice: login/logout/lockout/remember-me + session-first
// [Authenticated]. Phase 3 slice: RBAC pages — users/roles management and
// the audit log viewer, guarded by per-page permission checks against the
// __perms session snapshot.
//
// Multi-file build (both backends, same sources):
//   kylix build stdlib/stringutil.klx stdlib/template_engine.klx \
//     lib/admindb.klx lib/adminsec.klx lib/audit.klx main.klx
//
// Run from apps/admin/ (views/ + static/ are relative paths); KYADMIN_DB
// and KYADMIN_PASSWORD override the database path and seed password.
program KylixAdmin;

uses boot, db, admindb, adminsec, audit, template, sysutil;

// AddPageVars sets the layout variables shared by every authenticated page:
// identity, CSRF token and the per-permission sidebar flags.
procedure AddPageVars(eng: TTemplateEngine; req: TRequest; title: String; perms: String);
begin
  eng.AddVar('page_title', title);
  eng.AddVar('user', req.SessionGet('__user'));
  eng.AddVar('csrf', req.SessionCSRFToken());
  eng.AddVar('nav_dashboard', '1');
  eng.AddVar('nav_users', BoolStr(HasPerm(perms, 'users.read')));
  eng.AddVar('nav_roles', BoolStr(HasPerm(perms, 'roles.read')));
  eng.AddVar('nav_logs', BoolStr(HasPerm(perms, 'logs.read')));
  eng.AddVar('perms', perms);
end;

// RenderView registers the base layout and renders one page template by
// name (ReadFile('views/<name>.tpl')).
function RenderView(eng: TTemplateEngine; name: String): String;
begin
  eng.AddTemplate('base', ReadFile('views/base.tpl'));
  result := eng.RenderString(ReadFile('views/' + name + '.tpl'));
end;

[Controller('')]
type
  TAuthController = class
    [Get('/login')]
    function LoginPage(req: TRequest): TResponse;
    var
      eng: TTemplateEngine;
    begin
      eng := TTemplateEngine.Create();
      eng.AddVar('page_title', 'Sign in');
      eng.AddVar('user', '');
      eng.AddVar('csrf', req.SessionCSRFToken());
      eng.AddVar('error', '');
      eng.AddVar('nav_dashboard', '0');
      eng.AddVar('nav_users', '0');
      eng.AddVar('nav_roles', '0');
      eng.AddVar('nav_logs', '0');
      result := BootHTML(200, RenderView(eng, 'login'));
    end;

    [Post('/login')]
    function LoginSubmit(req: TRequest): TResponse;
    var
      eng: TTemplateEngine;
      db: TDatabase;
      user: String;
      pass: String;
      errMsg: String;
    begin
      user := req.Form('username');
      pass := req.Form('password');
      db := AdminOpen('admin.db');
      errMsg := DoLogin(db, req, user, pass);
      if errMsg <> '' then
      begin
        eng := TTemplateEngine.Create();
        eng.AddVar('page_title', 'Sign in');
        eng.AddVar('user', '');
        eng.AddVar('csrf', req.SessionCSRFToken());
        eng.AddVar('error', errMsg);
        eng.AddVar('nav_dashboard', '0');
        eng.AddVar('nav_users', '0');
        eng.AddVar('nav_roles', '0');
        eng.AddVar('nav_logs', '0');
        result := BootHTML(200, RenderView(eng, 'login'));
      end
      else
        result := BootHTML(302, '').Redirect('/dashboard');
    end;

    [Post('/logout')]
    function Logout(req: TRequest): TResponse;
    begin
      DoLogout(req);
      result := BootHTML(302, '').Redirect('/login');
    end;
  end;

  TPageController = class
    [Get('/dashboard')]
    [Authenticated]
    function Dashboard(req: TRequest): TResponse;
    var
      eng: TTemplateEngine;
      db: TDatabase;
      perms: String;
    begin
      db := AdminOpen('admin.db');
      perms := req.SessionGet('__perms');
      eng := TTemplateEngine.Create();
      AddPageVars(eng, req, 'Dashboard', perms);
      result := BootHTML(200, RenderView(eng, 'dashboard'));
    end;
  end;

  TUsersController = class
    [Get('/users')]
    [Authenticated]
    function UsersList(req: TRequest): TResponse;
    var
      eng: TTemplateEngine;
      db: TDatabase;
      perms: String;
      page: Integer;
      size: Integer;
      off: Integer;
      total: Integer;
      i: Integer;
      uid: String;
      uname: String;
      disp: String;
      act: String;
      rowHtml: String;
      err: String;
      e: String;
      canWrite: String;
    begin
      perms := req.SessionGet('__perms');
      if not HasPerm(perms, 'users.read') then
        result := Forbidden('You do not have permission to view users')
      else
      begin
        db := AdminOpen('admin.db');
        page := PageOf(req);
        size := 10;
        off := OffsetOf(page, size);
        canWrite := BoolStr(HasPerm(perms, 'users.write'));
        e := req.Query('e');
        err := '';
        if e = 'self' then
          err := 'You cannot delete your own account'
        else if e = 'admin' then
          err := 'The seed admin account cannot be deleted'
        else if e = 'dupe' then
          err := 'That username already exists';
        var rows := DbQueryRows(db, 'SELECT id, username, display_name, is_active FROM users ORDER BY id LIMIT ? OFFSET ?', IntToStr(size), IntToStr(off));
        total := StrToInt(DbQueryScalar(db, 'SELECT COUNT(*) FROM users'));
        rowHtml := '';
        i := 0;
        while i < Length(rows) do
        begin
          uid := VariantToStr(rows[i]['id']);
          uname := VariantToStr(rows[i]['username']);
          disp := VariantToStr(rows[i]['display_name']);
          if VariantToStr(rows[i]['is_active']) = '1' then
            act := 'active'
          else
            act := 'disabled';
          rowHtml := rowHtml + '<tr><td>' + H(uid) + '</td><td>' + H(uname) + '</td><td>' + H(disp) + '</td><td>' + act + '</td>';
          if canWrite = '1' then
            rowHtml := rowHtml + '<td class="actions"><a href="/users/edit?id=' + uid + '">Edit</a> <form method="post" action="/users/delete" class="inline"><input type="hidden" name="_csrf" value="' + req.SessionCSRFToken() + '"><input type="hidden" name="id" value="' + uid + '"><button type="submit">Delete</button></form></td>';
          rowHtml := rowHtml + '</tr>';
          i := i + 1;
        end;
        eng := TTemplateEngine.Create();
        AddPageVars(eng, req, 'Users', perms);
        eng.AddVar('user_rows', rowHtml);
        eng.AddVar('pager', BootPagerHTML('/users', page, size, total, 5));
        eng.AddVar('can_write', canWrite);
        eng.AddVar('err', err);
        result := BootHTML(200, RenderView(eng, 'users_list'));
      end;
    end;

    [Get('/users/new')]
    [Authenticated]
    function UsersNew(req: TRequest): TResponse;
    var
      eng: TTemplateEngine;
      perms: String;
    begin
      perms := req.SessionGet('__perms');
      if not HasPerm(perms, 'users.write') then
        result := Forbidden('You do not have permission to manage users')
      else
      begin
        eng := TTemplateEngine.Create();
        AddPageVars(eng, req, 'New user', perms);
        eng.AddVar('mode_create', '1');
        eng.AddVar('mode_edit', '0');
        eng.AddVar('form_action', '/users');
        eng.AddVar('f_id', '');
        eng.AddVar('f_username', '');
        eng.AddVar('f_display', '');
        eng.AddVar('f_active', '1');
        eng.AddVar('err', '');
        result := BootHTML(200, RenderView(eng, 'users_form'));
      end;
    end;

    [Post('/users')]
    [Authenticated]
    function UsersCreate(req: TRequest): TResponse;
    var
      eng: TTemplateEngine;
      db: TDatabase;
      perms: String;
      uname: String;
      pass: String;
      disp: String;
      hash: String;
    begin
      perms := req.SessionGet('__perms');
      if not HasPerm(perms, 'users.write') then
        result := Forbidden('You do not have permission to manage users')
      else
      begin
        db := AdminOpen('admin.db');
        uname := req.Form('username');
        pass := req.Form('password');
        disp := req.Form('display_name');
        if (uname = '') or (pass = '') then
        begin
          eng := TTemplateEngine.Create();
          AddPageVars(eng, req, 'New user', perms);
          eng.AddVar('mode_create', '1');
          eng.AddVar('mode_edit', '0');
          eng.AddVar('form_action', '/users');
          eng.AddVar('f_id', '');
          eng.AddVar('f_username', uname);
          eng.AddVar('f_display', disp);
          eng.AddVar('f_active', '1');
          eng.AddVar('err', 'Username and password are required');
          result := BootHTML(200, RenderView(eng, 'users_form'));
        end
        else if DbQueryScalar(db, 'SELECT COUNT(*) FROM users WHERE username = ?', uname) <> '0' then
        begin
          eng := TTemplateEngine.Create();
          AddPageVars(eng, req, 'New user', perms);
          eng.AddVar('mode_create', '1');
          eng.AddVar('mode_edit', '0');
          eng.AddVar('form_action', '/users');
          eng.AddVar('f_id', '');
          eng.AddVar('f_username', uname);
          eng.AddVar('f_display', disp);
          eng.AddVar('f_active', '1');
          eng.AddVar('err', 'That username already exists');
          result := BootHTML(200, RenderView(eng, 'users_form'));
        end
        else
        begin
          hash := Pbkdf2Hash(pass, 210000);
          DbExec(db, 'INSERT INTO users (username, password, display_name, is_active, failed_attempts, locked_until, created_at, updated_at) VALUES (?, ?, ?, 1, 0, 0, ?, ?)', uname, hash, disp, IntToStr(Now().Unix()), IntToStr(Now().Unix()));
          WriteOpLog(db, req, 'POST', '/users', 200);
          result := BootHTML(302, '').Redirect('/users');
        end;
      end;
    end;

    [Get('/users/edit')]
    [Authenticated]
    function UsersEdit(req: TRequest): TResponse;
    var
      eng: TTemplateEngine;
      db: TDatabase;
      perms: String;
      id: String;
    begin
      perms := req.SessionGet('__perms');
      if not HasPerm(perms, 'users.write') then
        result := Forbidden('You do not have permission to manage users')
      else
      begin
        db := AdminOpen('admin.db');
        id := req.Query('id');
        var rows := DbQueryRows(db, 'SELECT id, username, display_name, is_active FROM users WHERE id = ?', id);
        if Length(rows) = 0 then
          result := BootHTML(302, '').Redirect('/users')
        else
        begin
          eng := TTemplateEngine.Create();
          AddPageVars(eng, req, 'Edit user', perms);
          eng.AddVar('mode_create', '0');
          eng.AddVar('mode_edit', '1');
          eng.AddVar('form_action', '/users/update');
          eng.AddVar('f_id', VariantToStr(rows[0]['id']));
          eng.AddVar('f_username', VariantToStr(rows[0]['username']));
          eng.AddVar('f_display', VariantToStr(rows[0]['display_name']));
          eng.AddVar('f_active', VariantToStr(rows[0]['is_active']));
          eng.AddVar('err', '');
          result := BootHTML(200, RenderView(eng, 'users_form'));
        end;
      end;
    end;

    [Post('/users/update')]
    [Authenticated]
    function UsersUpdate(req: TRequest): TResponse;
    var
      db: TDatabase;
      perms: String;
      eng: TTemplateEngine;
      id: String;
      uname: String;
      pass: String;
      disp: String;
      now: Integer;
    begin
      perms := req.SessionGet('__perms');
      if not HasPerm(perms, 'users.write') then
        result := Forbidden('You do not have permission to manage users')
      else
      begin
        db := AdminOpen('admin.db');
        id := req.Form('id');
        uname := req.Form('username');
        pass := req.Form('password');
        disp := req.Form('display_name');
        now := Now().Unix();
        if (id = '') or (uname = '') or (DbQueryScalar(db, 'SELECT COUNT(*) FROM users WHERE username = ? AND id <> ?', uname, id) <> '0') then
        begin
          eng := TTemplateEngine.Create();
          AddPageVars(eng, req, 'Edit user', perms);
          eng.AddVar('mode_create', '0');
          eng.AddVar('mode_edit', '1');
          eng.AddVar('form_action', '/users/update');
          eng.AddVar('f_id', id);
          eng.AddVar('f_username', uname);
          eng.AddVar('f_display', disp);
          eng.AddVar('f_active', BoolStr(req.Form('is_active') = '1'));
          eng.AddVar('err', 'Username is required and must be unique');
          result := BootHTML(200, RenderView(eng, 'users_form'));
        end
        else
        begin
          if req.Form('is_active') = '1' then
          begin
            if pass <> '' then
              DbExec(db, 'UPDATE users SET username = ?, display_name = ?, is_active = 1, password = ?, updated_at = ? WHERE id = ?', uname, disp, Pbkdf2Hash(pass, 210000), IntToStr(now), id)
            else
              DbExec(db, 'UPDATE users SET username = ?, display_name = ?, is_active = 1, updated_at = ? WHERE id = ?', uname, disp, IntToStr(now), id);
          end
          else
          begin
            if pass <> '' then
              DbExec(db, 'UPDATE users SET username = ?, display_name = ?, is_active = 0, password = ?, updated_at = ? WHERE id = ?', uname, disp, Pbkdf2Hash(pass, 210000), IntToStr(now), id)
            else
              DbExec(db, 'UPDATE users SET username = ?, display_name = ?, is_active = 0, updated_at = ? WHERE id = ?', uname, disp, IntToStr(now), id);
          end;
          WriteOpLog(db, req, 'POST', '/users/update', 200);
          result := BootHTML(302, '').Redirect('/users');
        end;
      end;
    end;

    [Post('/users/delete')]
    [Authenticated]
    function UsersDelete(req: TRequest): TResponse;
    var
      db: TDatabase;
      perms: String;
      id: String;
      uname: String;
    begin
      perms := req.SessionGet('__perms');
      if not HasPerm(perms, 'users.write') then
        result := Forbidden('You do not have permission to manage users')
      else
      begin
        db := AdminOpen('admin.db');
        id := req.Form('id');
        uname := DbQueryScalar(db, 'SELECT username FROM users WHERE id = ?', id);
        if id = '1' then
          result := BootHTML(302, '').Redirect('/users?e=admin')
        else if uname = req.SessionGet('__user') then
          result := BootHTML(302, '').Redirect('/users?e=self')
        else
        begin
          DbExec(db, 'DELETE FROM user_roles WHERE user_id = ?', id);
          DbExec(db, 'DELETE FROM users WHERE id = ?', id);
          WriteOpLog(db, req, 'POST', '/users/delete', 200);
          result := BootHTML(302, '').Redirect('/users');
        end;
      end;
    end;
  end;

  TRolesController = class
    [Get('/roles')]
    [Authenticated]
    function RolesList(req: TRequest): TResponse;
    var
      eng: TTemplateEngine;
      db: TDatabase;
      perms: String;
      page: Integer;
      size: Integer;
      off: Integer;
      total: Integer;
      i: Integer;
      j: Integer;
      rid: String;
      rperms: String;
      rowHtml: String;
      canWrite: String;
    begin
      perms := req.SessionGet('__perms');
      if not HasPerm(perms, 'roles.read') then
        result := Forbidden('You do not have permission to view roles')
      else
      begin
        db := AdminOpen('admin.db');
        page := PageOf(req);
        size := 10;
        off := OffsetOf(page, size);
        canWrite := BoolStr(HasPerm(perms, 'roles.write'));
        var rows := DbQueryRows(db, 'SELECT id, name, description FROM roles ORDER BY id LIMIT ? OFFSET ?', IntToStr(size), IntToStr(off));
        total := StrToInt(DbQueryScalar(db, 'SELECT COUNT(*) FROM roles'));
        rowHtml := '';
        i := 0;
        while i < Length(rows) do
        begin
          rid := VariantToStr(rows[i]['id']);
          rperms := '';
          var prows := DbQueryRows(db, 'SELECT p.code AS code FROM permissions p JOIN role_permissions rp ON rp.permission_id = p.id WHERE rp.role_id = ?', rid);
          j := 0;
          while j < Length(prows) do
          begin
            if rperms <> '' then
              rperms := rperms + ', ';
            rperms := rperms + VariantToStr(prows[j]['code']);
            j := j + 1;
          end;
          rowHtml := rowHtml + '<tr><td>' + H(rid) + '</td><td>' + H(VariantToStr(rows[i]['name'])) + '</td><td>' + H(VariantToStr(rows[i]['description'])) + '</td><td><code>' + H(rperms) + '</code></td>';
          if canWrite = '1' then
            rowHtml := rowHtml + '<td class="actions"><a href="/roles/edit?id=' + rid + '">Edit</a> <form method="post" action="/roles/delete" class="inline"><input type="hidden" name="_csrf" value="' + req.SessionCSRFToken() + '"><input type="hidden" name="id" value="' + rid + '"><button type="submit">Delete</button></form></td>';
          rowHtml := rowHtml + '</tr>';
          i := i + 1;
        end;
        eng := TTemplateEngine.Create();
        AddPageVars(eng, req, 'Roles', perms);
        eng.AddVar('role_rows', rowHtml);
        eng.AddVar('pager', BootPagerHTML('/roles', page, size, total, 5));
        eng.AddVar('can_write', canWrite);
        eng.AddVar('err', '');
        result := BootHTML(200, RenderView(eng, 'roles_list'));
      end;
    end;

    [Get('/roles/new')]
    [Authenticated]
    function RolesNew(req: TRequest): TResponse;
    var
      eng: TTemplateEngine;
      db: TDatabase;
      perms: String;
      i: Integer;
      code: String;
      cbHtml: String;
    begin
      perms := req.SessionGet('__perms');
      if not HasPerm(perms, 'roles.write') then
        result := Forbidden('You do not have permission to manage roles')
      else
      begin
        db := AdminOpen('admin.db');
        var prows := DbQueryRows(db, 'SELECT code, description FROM permissions ORDER BY id');
        cbHtml := '';
        i := 0;
        while i < Length(prows) do
        begin
          code := VariantToStr(prows[i]['code']);
          cbHtml := cbHtml + '<label class="check"><input type="checkbox" name="perm_' + code + '" value="1"> ' + H(code) + '</label>';
          i := i + 1;
        end;
        eng := TTemplateEngine.Create();
        AddPageVars(eng, req, 'New role', perms);
        eng.AddVar('mode_create', '1');
        eng.AddVar('mode_edit', '0');
        eng.AddVar('form_action', '/roles');
        eng.AddVar('f_id', '');
        eng.AddVar('f_name', '');
        eng.AddVar('f_description', '');
        eng.AddVar('perm_rows', cbHtml);
        eng.AddVar('err', '');
        result := BootHTML(200, RenderView(eng, 'roles_form'));
      end;
    end;

    [Post('/roles')]
    [Authenticated]
    function RolesCreate(req: TRequest): TResponse;
    var
      eng: TTemplateEngine;
      db: TDatabase;
      perms: String;
      rname: String;
      desc: String;
      i: Integer;
      code: String;
      cbHtml: String;
      rid: String;
    begin
      perms := req.SessionGet('__perms');
      if not HasPerm(perms, 'roles.write') then
        result := Forbidden('You do not have permission to manage roles')
      else
      begin
        db := AdminOpen('admin.db');
        rname := req.Form('name');
        desc := req.Form('description');
        if rname = '' then
        begin
          var prows := DbQueryRows(db, 'SELECT code, description FROM permissions ORDER BY id');
          cbHtml := '';
          i := 0;
          while i < Length(prows) do
          begin
            code := VariantToStr(prows[i]['code']);
            if req.Form('perm_' + code) = '1' then
              cbHtml := cbHtml + '<label class="check"><input type="checkbox" name="perm_' + code + '" value="1" checked> ' + H(code) + '</label>'
            else
              cbHtml := cbHtml + '<label class="check"><input type="checkbox" name="perm_' + code + '" value="1"> ' + H(code) + '</label>';
            i := i + 1;
          end;
          eng := TTemplateEngine.Create();
          AddPageVars(eng, req, 'New role', perms);
          eng.AddVar('mode_create', '1');
          eng.AddVar('mode_edit', '0');
          eng.AddVar('form_action', '/roles');
          eng.AddVar('f_id', '');
          eng.AddVar('f_name', rname);
          eng.AddVar('f_description', desc);
          eng.AddVar('perm_rows', cbHtml);
          eng.AddVar('err', 'Role name is required');
          result := BootHTML(200, RenderView(eng, 'roles_form'));
        end
        else
        begin
          DbExec(db, 'INSERT INTO roles (name, description) VALUES (?, ?)', rname, desc);
          rid := DbQueryScalar(db, 'SELECT id FROM roles WHERE name = ?', rname);
          var allperms := DbQueryRows(db, 'SELECT code FROM permissions ORDER BY id');
          i := 0;
          while i < Length(allperms) do
          begin
            code := VariantToStr(allperms[i]['code']);
            if req.Form('perm_' + code) = '1' then
              DbExec(db, 'INSERT INTO role_permissions (role_id, permission_id) SELECT ?, id FROM permissions WHERE code = ?', rid, code);
            i := i + 1;
          end;
          WriteOpLog(db, req, 'POST', '/roles', 200);
          result := BootHTML(302, '').Redirect('/roles');
        end;
      end;
    end;

    [Get('/roles/edit')]
    [Authenticated]
    function RolesEdit(req: TRequest): TResponse;
    var
      eng: TTemplateEngine;
      db: TDatabase;
      perms: String;
      id: String;
      i: Integer;
      code: String;
      cbHtml: String;
      rolePerms: String;
    begin
      perms := req.SessionGet('__perms');
      if not HasPerm(perms, 'roles.write') then
        result := Forbidden('You do not have permission to manage roles')
      else
      begin
        db := AdminOpen('admin.db');
        id := req.Query('id');
        var rows := DbQueryRows(db, 'SELECT id, name, description FROM roles WHERE id = ?', id);
        if Length(rows) = 0 then
          result := BootHTML(302, '').Redirect('/roles')
        else
        begin
          rolePerms := '';
          var rperms := DbQueryRows(db, 'SELECT p.code AS code FROM permissions p JOIN role_permissions rp ON rp.permission_id = p.id WHERE rp.role_id = ?', id);
          i := 0;
          while i < Length(rperms) do
          begin
            if rolePerms <> '' then
              rolePerms := rolePerms + ',';
            rolePerms := rolePerms + VariantToStr(rperms[i]['code']);
            i := i + 1;
          end;
          var prows := DbQueryRows(db, 'SELECT code, description FROM permissions ORDER BY id');
          cbHtml := '';
          i := 0;
          while i < Length(prows) do
          begin
            code := VariantToStr(prows[i]['code']);
            if HasPerm(rolePerms, code) then
              cbHtml := cbHtml + '<label class="check"><input type="checkbox" name="perm_' + code + '" value="1" checked> ' + H(code) + '</label>'
            else
              cbHtml := cbHtml + '<label class="check"><input type="checkbox" name="perm_' + code + '" value="1"> ' + H(code) + '</label>';
            i := i + 1;
          end;
          eng := TTemplateEngine.Create();
          AddPageVars(eng, req, 'Edit role', perms);
          eng.AddVar('mode_create', '0');
          eng.AddVar('mode_edit', '1');
          eng.AddVar('form_action', '/roles/update');
          eng.AddVar('f_id', VariantToStr(rows[0]['id']));
          eng.AddVar('f_name', VariantToStr(rows[0]['name']));
          eng.AddVar('f_description', VariantToStr(rows[0]['description']));
          eng.AddVar('perm_rows', cbHtml);
          eng.AddVar('err', '');
          result := BootHTML(200, RenderView(eng, 'roles_form'));
        end;
      end;
    end;

    [Post('/roles/update')]
    [Authenticated]
    function RolesUpdate(req: TRequest): TResponse;
    var
      db: TDatabase;
      perms: String;
      id: String;
      rname: String;
      desc: String;
      i: Integer;
      code: String;
    begin
      perms := req.SessionGet('__perms');
      if not HasPerm(perms, 'roles.write') then
        result := Forbidden('You do not have permission to manage roles')
      else
      begin
        db := AdminOpen('admin.db');
        id := req.Form('id');
        rname := req.Form('name');
        desc := req.Form('description');
        if (id = '') or (rname = '') then
          result := BootHTML(302, '').Redirect('/roles')
        else
        begin
          DbExec(db, 'UPDATE roles SET name = ?, description = ? WHERE id = ?', rname, desc, id);
          DbExec(db, 'DELETE FROM role_permissions WHERE role_id = ?', id);
          var allperms := DbQueryRows(db, 'SELECT code FROM permissions ORDER BY id');
          i := 0;
          while i < Length(allperms) do
          begin
            code := VariantToStr(allperms[i]['code']);
            if req.Form('perm_' + code) = '1' then
              DbExec(db, 'INSERT INTO role_permissions (role_id, permission_id) SELECT ?, id FROM permissions WHERE code = ?', id, code);
            i := i + 1;
          end;
          WriteOpLog(db, req, 'POST', '/roles/update', 200);
          result := BootHTML(302, '').Redirect('/roles');
        end;
      end;
    end;

    [Post('/roles/delete')]
    [Authenticated]
    function RolesDelete(req: TRequest): TResponse;
    var
      db: TDatabase;
      perms: String;
      id: String;
    begin
      perms := req.SessionGet('__perms');
      if not HasPerm(perms, 'roles.write') then
        result := Forbidden('You do not have permission to manage roles')
      else
      begin
        db := AdminOpen('admin.db');
        id := req.Form('id');
        if id = '1' then
          result := BootHTML(302, '').Redirect('/roles?e=adminrole')
        else
        begin
          DbExec(db, 'DELETE FROM user_roles WHERE role_id = ?', id);
          DbExec(db, 'DELETE FROM role_permissions WHERE role_id = ?', id);
          DbExec(db, 'DELETE FROM roles WHERE id = ?', id);
          WriteOpLog(db, req, 'POST', '/roles/delete', 200);
          result := BootHTML(302, '').Redirect('/roles');
        end;
      end;
    end;
  end;

  TLogsController = class
    [Get('/logs')]
    [Authenticated]
    function LogsPage(req: TRequest): TResponse;
    var
      eng: TTemplateEngine;
      db: TDatabase;
      perms: String;
      page: Integer;
      size: Integer;
      off: Integer;
      i: Integer;
      loginHtml: String;
      opHtml: String;
      totalLogins: Integer;
      totalOps: Integer;
      ok: String;
    begin
      perms := req.SessionGet('__perms');
      if not HasPerm(perms, 'logs.read') then
        result := Forbidden('You do not have permission to view audit logs')
      else
      begin
        db := AdminOpen('admin.db');
        page := PageOf(req);
        size := 15;
        off := OffsetOf(page, size);
        var logins := DbQueryRows(db, 'SELECT username, ip, success, reason, strftime(?, created_at, ?) AS ts FROM login_logs ORDER BY id DESC LIMIT ? OFFSET ?', '%Y-%m-%d %H:%M:%S', 'unixepoch', IntToStr(size), IntToStr(off));
        totalLogins := StrToInt(DbQueryScalar(db, 'SELECT COUNT(*) FROM login_logs'));
        loginHtml := '';
        i := 0;
        while i < Length(logins) do
        begin
          if VariantToStr(logins[i]['success']) = '1' then
            ok := '<span class="ok">success</span>'
          else
            ok := '<span class="bad">failed</span>';
          loginHtml := loginHtml + '<tr><td>' + H(VariantToStr(logins[i]['ts'])) + '</td><td>' + H(VariantToStr(logins[i]['username'])) + '</td><td>' + ok + '</td><td>' + H(VariantToStr(logins[i]['reason'])) + '</td><td>' + H(VariantToStr(logins[i]['ip'])) + '</td></tr>';
          i := i + 1;
        end;
        var ops := DbQueryRows(db, 'SELECT username, method, path, status, ip, strftime(?, created_at, ?) AS ts FROM op_logs ORDER BY id DESC LIMIT ? OFFSET ?', '%Y-%m-%d %H:%M:%S', 'unixepoch', IntToStr(size), IntToStr(off));
        totalOps := StrToInt(DbQueryScalar(db, 'SELECT COUNT(*) FROM op_logs'));
        opHtml := '';
        i := 0;
        while i < Length(ops) do
        begin
          opHtml := opHtml + '<tr><td>' + H(VariantToStr(ops[i]['ts'])) + '</td><td>' + H(VariantToStr(ops[i]['username'])) + '</td><td>' + H(VariantToStr(ops[i]['method'])) + '</td><td>' + H(VariantToStr(ops[i]['path'])) + '</td><td>' + H(VariantToStr(ops[i]['status'])) + '</td><td>' + H(VariantToStr(ops[i]['ip'])) + '</td></tr>';
          i := i + 1;
        end;
        eng := TTemplateEngine.Create();
        AddPageVars(eng, req, 'Audit logs', perms);
        eng.AddVar('login_rows', loginHtml);
        eng.AddVar('op_rows', opHtml);
        eng.AddVar('login_pager', BootPagerHTML('/logs', page, size, totalLogins, 5));
        eng.AddVar('op_pager', BootPagerHTML('/logs', page, size, totalOps, 5));
        result := BootHTML(200, RenderView(eng, 'logs'));
      end;
    end;
  end;

var
  db: TDatabase;
  port: Integer;

begin
  db := AdminOpen('admin.db');
  EnsureSchema(db);
  SeedIfEmpty(db);
  BootUseCSRF();
  BootStatic('static');
  BootNotFoundPage('<html><body><h1>404 Not Found</h1><p><a href="/login">Sign in</a></p></body></html>');
  port := StrToInt(GetEnv('KYADMIN_PORT'));
  if port = 0 then
    port := 8090;
  WriteLn('kylixadmin listening on :' + IntToStr(port));
  BootRun(port);
end.
