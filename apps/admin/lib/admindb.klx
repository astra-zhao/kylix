// admindb.klx — KylixAdmin database layer (v0.10.0 P2)
//
// Schema (7 tables), seed data (admin user + admin/viewer roles + 5
// permission points) and RBAC lookups. Pure Kylix: compiled by the Go and
// LLVM backends from this one source (multi-file build with main.klx).
//
// Conventions:
//   - SQLite only, TEXT/INTEGER columns, every statement parameterized (?).
//   - Timestamps are Unix seconds (INTEGER). Bound as TEXT — SQLite's
//     INTEGER column affinity coerces them back on storage and comparison.
//   - All cross-unit public functions take >= 1 parameter (host Go codegen
//     drops the call parentheses on zero-arg cross-unit calls used as
//     arguments — TECHNICAL_DEBT).
unit admindb;

uses db, crypto, datetime, sysutil, dialect, migrate;

// Process-wide database handle (see AdminOpen).
var
  gAdminDB: TDatabase;
  gAdminOpened: Boolean;

// ---------------------------------------------------------------------------
// schema + seed
// ---------------------------------------------------------------------------

procedure EnsureSchema(db: TDatabase);
var
  wal: String;
  ts: String;
  warn: String;
begin
  // WAL is sqlite-only: SqlWAL returns '' on postgres, and an empty statement
  // is accepted silently by both drivers, so the guard has to be explicit.
  wal := SqlWAL();
  if wal <> '' then
    DbExec(db, wal);
  ts := SqlIntType();
  // Tables without an [Entity] class keep their hand-written DDL: they have
  // composite primary keys, which the metadata model does not express.
  DbExec(db, 'CREATE TABLE IF NOT EXISTS permissions (' + SqlPKColumn('id') + ', code TEXT UNIQUE, description TEXT)');
  DbExec(db, 'CREATE TABLE IF NOT EXISTS user_roles (user_id ' + ts + ', role_id ' + ts + ', PRIMARY KEY (user_id, role_id))');
  DbExec(db, 'CREATE TABLE IF NOT EXISTS role_permissions (role_id ' + ts + ', permission_id ' + ts + ', PRIMARY KEY (role_id, permission_id))');
  // v0.12.0 P5e: the entity tables are generated from the [Entity] metadata —
  // created when missing, extended with ADD COLUMN when the metadata has grown.
  // The pass reports anything it will not change (type drift, a missing
  // primary key) rather than altering it silently.
  MigrateEnsureVersionTable(db);
  warn := MigrateAll(db);
  if warn <> '' then
    WriteLn('[kyadmin] schema warning:' + warn);
  MigrateRecordVersion(db, 1);
end;

procedure SeedIfEmpty(db: TDatabase);
var
  cnt: String;
  pw: String;
  hash: String;
  now: Integer;
  adminRole: String;
  viewerRole: String;
  uid: String;
begin
  cnt := DbQueryScalar(db, 'SELECT COUNT(*) FROM users');
  if cnt = '0' then
  begin
    pw := GetEnv('KYADMIN_PASSWORD');
    if pw = '' then
    begin
      pw := 'Admin@123';
      WriteLn('[kyadmin] WARNING: KYADMIN_PASSWORD is not set; the default password is in use');
    end;
    now := Now().Unix();
    hash := Pbkdf2Hash(pw, 210000);
    DbExec(db, 'INSERT INTO users (username, password, display_name, is_active, failed_attempts, locked_until, created_at, updated_at) VALUES (?, ?, ?, 1, 0, 0, ?, ?)', 'admin', hash, 'Administrator', IntToStr(now), IntToStr(now));
    DbExec(db, 'INSERT INTO roles (name, description) VALUES (?, ?)', 'admin', 'Full access');
    DbExec(db, 'INSERT INTO roles (name, description) VALUES (?, ?)', 'viewer', 'Read-only access');
    // Permission points follow the table names the CRUD engine looks up:
    // <table>.read for lists/forms, <table>.write for mutations. Read-only
    // entities (the two log tables) get a read point only.
    DbExec(db, 'INSERT INTO permissions (code, description) VALUES (?, ?)', 'users.read', 'View users');
    DbExec(db, 'INSERT INTO permissions (code, description) VALUES (?, ?)', 'users.write', 'Manage users');
    DbExec(db, 'INSERT INTO permissions (code, description) VALUES (?, ?)', 'roles.read', 'View roles');
    DbExec(db, 'INSERT INTO permissions (code, description) VALUES (?, ?)', 'roles.write', 'Manage roles');
    DbExec(db, 'INSERT INTO permissions (code, description) VALUES (?, ?)', 'login_logs.read', 'View login log');
    DbExec(db, 'INSERT INTO permissions (code, description) VALUES (?, ?)', 'op_logs.read', 'View operation log');
    DbExec(db, 'INSERT INTO permissions (code, description) VALUES (?, ?)', 'notes.read', 'View notes');
    DbExec(db, 'INSERT INTO permissions (code, description) VALUES (?, ?)', 'notes.write', 'Manage notes');
    adminRole := DbQueryScalar(db, 'SELECT id FROM roles WHERE name = ?', 'admin');
    viewerRole := DbQueryScalar(db, 'SELECT id FROM roles WHERE name = ?', 'viewer');
    uid := DbQueryScalar(db, 'SELECT id FROM users WHERE username = ?', 'admin');
    DbExec(db, 'INSERT INTO user_roles (user_id, role_id) VALUES (?, ?)', uid, adminRole);
    // admin -> all five permission points
    DbExec(db, 'INSERT INTO role_permissions (role_id, permission_id) SELECT ?, id FROM permissions', adminRole);
    // viewer -> the three read points only
    DbExec(db, 'INSERT INTO role_permissions (role_id, permission_id) SELECT ?, id FROM permissions WHERE code = ?', viewerRole, 'users.read');
    DbExec(db, 'INSERT INTO role_permissions (role_id, permission_id) SELECT ?, id FROM permissions WHERE code = ?', viewerRole, 'roles.read');
    DbExec(db, 'INSERT INTO role_permissions (role_id, permission_id) SELECT ?, id FROM permissions WHERE code = ?', viewerRole, 'login_logs.read');
    DbExec(db, 'INSERT INTO role_permissions (role_id, permission_id) SELECT ?, id FROM permissions WHERE code = ?', viewerRole, 'op_logs.read');
  end;
end;

// AdminDBPath reports the sqlite path in use ('' when the process is on
// postgres), for the startup line.
function AdminDBPath(): String;
var
  env: String;
  home: String;
begin
  env := GetEnv('KYADMIN_DB');
  if env <> '' then
    result := env
  else
  begin
    home := GetEnv('HOME');
    if home = '' then
      home := GetEnv('USERPROFILE');
    if home <> '' then
      result := home + '/.kylixadmin/admin.db'
    else
      result := 'admin.db';
  end;
end;

// AdminOpen returns the process-wide database handle, opening it on first use.
//
// v0.12.0: this used to open a fresh handle on every call, and every handler
// calls it per request (15 call sites, no DbClose anywhere). With sqlite that
// merely leaked file descriptors; with postgres each request would leak a TCP
// connection — measured: the 101st unclosed pool already fails with "sorry, too
// many clients already", while the E2E makes 150+ requests.
//
// KYADMIN_DB overrides the path (E2E isolation). The DSN also selects the
// dialect, so SqlUse runs here too.
function AdminOpen(dbPath: String): TDatabase;
var
  env: String;
  dsn: String;
  home: String;
begin
  if gAdminOpened then
    result := gAdminDB
  else
  begin
    env := GetEnv('KYADMIN_DB');
    if env <> '' then
      dbPath := env
    else
    begin
      // A deployed binary should not scatter admin.db into whatever directory
      // it happens to be started from, so the default lives under $HOME
      // (created on first run). KYADMIN_DB still overrides it, and the E2E sets
      // it so each form gets its own file.
      home := GetEnv('HOME');
      if home = '' then
        home := GetEnv('USERPROFILE');
      if home <> '' then
      begin
        if not DirExists(home + '/.kylixadmin') then
          CreateDir(home + '/.kylixadmin');
        dbPath := home + '/.kylixadmin/admin.db';
      end;
    end;
    // The dialect follows the DSN: KYADMIN_DSN selects postgres, otherwise the
    // sqlite file at KYADMIN_DB. DbOpenPg is a separate entry point so the
    // LLVM backend emits the postgres paths (and links libpq) only for programs
    // that use them.
    dsn := GetEnv('KYADMIN_DSN');
    if dsn <> '' then
    begin
      SqlUse(dsn);
      gAdminDB := DbOpenPg(dsn);
    end
    else
    begin
      SqlUse(dbPath);
      gAdminDB := DbOpenSQLite(dbPath);
    end;
    // A single-process admin needs a handful of connections, not a hundred.
    DbSetMaxOpenConns(gAdminDB, 8);
    DbSetMaxIdleConns(gAdminDB, 4);
    DbSetConnMaxLifetime(gAdminDB, 3600);
    EnsureSchema(gAdminDB);
    SeedIfEmpty(gAdminDB);
    gAdminOpened := True;
    result := gAdminDB;
  end;
end;

// ---------------------------------------------------------------------------
// RBAC lookups
// ---------------------------------------------------------------------------

// RolesOf returns the user's role names, comma-joined ('' when none).
function RolesOf(db: TDatabase; username: String): String;
var
  i: Integer;
begin
  result := '';
  var rows := DbQueryRows(db, 'SELECT r.name AS name FROM roles r JOIN user_roles ur ON ur.role_id = r.id JOIN users u ON u.id = ur.user_id WHERE u.username = ?', username);
  i := 0;
  while i < Length(rows) do
  begin
    if result <> '' then
      result := result + ',';
    result := result + VariantToStr(rows[i]['name']);
    i := i + 1;
  end;
end;

// PermsOf returns the user's permission codes, comma-joined ('' when none).
function PermsOf(db: TDatabase; username: String): String;
var
  i: Integer;
begin
  result := '';
  var rows := DbQueryRows(db, 'SELECT p.code AS code FROM permissions p JOIN role_permissions rp ON rp.permission_id = p.id JOIN user_roles ur ON ur.role_id = rp.role_id JOIN users u ON u.id = ur.user_id WHERE u.username = ?', username);
  i := 0;
  while i < Length(rows) do
  begin
    if result <> '' then
      result := result + ',';
    result := result + VariantToStr(rows[i]['code']);
    i := i + 1;
  end;
end;

// WriteLoginLog appends one row to login_logs (success = 1/0).
procedure WriteLoginLog(db: TDatabase; username: String; ip: String; ua: String; ok: Boolean; reason: String);
var
  now: Integer;
  okInt: String;
begin
  now := Now().Unix();
  if ok then
    okInt := '1'
  else
    okInt := '0';
  DbExec(db, 'INSERT INTO login_logs (username, ip, user_agent, success, reason, created_at) VALUES (?, ?, ?, ?, ?, ?)', username, ip, ua, okInt, reason, IntToStr(now));
end;

end.
