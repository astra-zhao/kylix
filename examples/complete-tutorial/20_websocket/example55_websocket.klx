program WebSocketDemo;
uses net, websocket;

begin
  // Single-process echo loopback (v6.5.0): the client connects first (the TCP
  // connection queues in the listener's accept backlog), then the server
  // accepts + handshakes, then the client finishes its handshake — no threads
  // needed. WsDial = WsDialConnect + WsDialFinish.
  var ln := TcpListen(18080);
  var cli := WsDialConnect('127.0.0.1:18080', '/echo');
  if cli = nil then
  begin
    WriteLn('connect failed');
    exit;
  end;
  var tcp := TcpAccept(ln);
  var srv := WsAccept(tcp);
  if not WsDialFinish(cli) then
  begin
    WriteLn('handshake failed');
    exit;
  end;
  WsSend(srv, 'hello from server');
  WriteLn('client got: ' + WsRecv(cli));
  WsClose(cli);
  WsClose(srv);
  TcpListenerClose(ln);
  WriteLn('websocket demo OK');
end.
