program ORMExample;
uses db;

// Database CRUD over SQLite using the real stdlib db unit.
//
// The original version of this file was a design sketch around an API that
// never shipped (TORM / TQueryBuilder / map[string]interface{}); it did not
// compile against any released Kylix. This rewrite uses the API that actually
// exists: DbOpenSQLite / DbExec (parameterized) / DbQueryScalar / DbQueryRows,
// the same surface exercised by examples/complete-tutorial/17_database.
//
// Note: connections and row collections are kept in `:=`-inferred variables —
// stdlib handle types (TDatabase) and row arrays are not nameable in explicit
// type annotations today.
//
// For annotation-based ORM ([Entity]/[Repository]/[Query]), see
// examples/complete-tutorial/12_special_features/example47_orm_annotations.klx.

begin
  // Connect (in-memory SQLite) and create the table
  var conn := DbOpenSQLite(':memory:');
  DbExec(conn, 'CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, email TEXT, age INTEGER)');

  // Create
  DbExec(conn, 'INSERT INTO users (name, email, age) VALUES (?, ?, ?)', 'alice', 'alice@example.com', 30);
  DbExec(conn, 'INSERT INTO users (name, email, age) VALUES (?, ?, ?)', 'bob', 'bob@example.com', 25);
  WriteLn('count after insert: ', Length(DbQueryRows(conn, 'SELECT * FROM users')));

  // Update + read back a single column
  DbExec(conn, 'UPDATE users SET age = ? WHERE id = ?', 26, 2);
  WriteLn('bob email: ', DbQueryScalar(conn, 'SELECT email FROM users WHERE id = 2'));

  // List all rows (each row is a map: rows[i]['col'])
  var rows := DbQueryRows(conn, 'SELECT id, name, age FROM users ORDER BY id');
  var i: Integer;
  WriteLn('all users:');
  for i := 0 to Length(rows) - 1 do
  begin
    WriteLn('  ', rows[i]['name']);
    WriteLn('    age: ', rows[i]['age']);
  end;

  // Delete
  DbExec(conn, 'DELETE FROM users WHERE id = ?', 1);
  WriteLn('count after delete: ', Length(DbQueryRows(conn, 'SELECT * FROM users')));

  DbClose(conn);
  WriteLn('orm example OK');
end.
