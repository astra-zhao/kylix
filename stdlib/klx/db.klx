unit db;

// db — Kylix-friendly database convenience layer (Phase 7).
// SQLite is the default tutorial driver (":memory:" for in-memory).

type
  TDatabase = class
  end;

// Open a database by driver ("sqlite3" | "mysql" | "postgres") and DSN.
function DbOpen(driver: String; dsn: String): TDatabase;
// Open an SQLite database file (":memory:" for in-memory).
function DbOpenSQLite(path: String): TDatabase;
// Open a postgres connection from a DSN. A separate entry point (rather than a
// driver string) so the LLVM backend only emits the postgres code paths for
// programs that use it — and only those link libpq. v0.12.0.
function DbOpenPg(dsn: String): TDatabase;
// Execute INSERT/UPDATE/DELETE/DDL; returns rows affected. Values are bound as
// `?` placeholders (rewritten to $n on postgres inside the db layer).
function DbExec(db: TDatabase; query: String): Integer;
// Run SELECT; returns all rows as array of map (keyed by column name).
function DbQueryRows(db: TDatabase; query: String): array of Variant;
// Run a single-value SELECT; returns first column as String ("" if no rows and
// "" for a NULL column).
function DbQueryScalar(db: TDatabase; query: String): String;
// Close the connection pool.
procedure DbClose(db: TDatabase);

// DbLastError returns the most recent statement error on this connection, or ""
// when the last statement succeeded. The generated code discards the (T, error)
// half of the calls above, so this is how a program notices a failed statement
// — on postgres a silently failed statement is indistinguishable from an empty
// result set. v0.12.0.
function DbLastError(db: TDatabase): String;

// Connection-pool tuning (Go backend). The LLVM backend keeps a single
// connection and accepts these as no-ops, so call sites stay shared. v0.12.0.
procedure DbSetMaxOpenConns(db: TDatabase; n: Integer);
procedure DbSetMaxIdleConns(db: TDatabase; n: Integer);
// DbSetConnMaxLifetime sets the connection lifetime in seconds (0 = no limit).
procedure DbSetConnMaxLifetime(db: TDatabase; seconds: Integer);

end.
