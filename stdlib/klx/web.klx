unit web;

// web — HTTP server for Kylix programs (stdlib wrapper around net/http).
//
// v0.7.0 P2: page-rendering API on TRequest/TResponse. The methods below are
// dispatched by the compiler (TRequest/TResponse map to the boot runtime
// handles); the declarations exist for LSP completion and documentation.

type
  TRequest = class
    // Param returns a URL path parameter value ("/users/:id" → req.Param('id')).
    function Param(name: String): String;
    // Query returns a URL query string value (?name=value).
    function Query(name: String): String;
    // Header returns a request header value.
    function Header(name: String): String;
    // Body returns the raw request body (NUL-terminated string).
    function Body: String;
    // Form returns a value from an urlencoded form body (HTML <form> posts),
    // falling back to the URL query string. %XX and '+' are URL-decoded.
    function Form(name: String): String;
    // Cookie returns a request cookie value ("Cookie: a=1; b=2"), or ''.
    function Cookie(name: String): String;
    // SessionGet returns the server-side session value for key ('' when absent).
    function SessionGet(key: String): String;
    // SessionSet stores a server-side session value.
    procedure SessionSet(key: String; value: String);
    // SessionDelete removes a session key.
    procedure SessionDelete(key: String);
    // SessionMarkRemember flips the session cookie to a 30-day persistent one.
    procedure SessionMarkRemember();
    // SessionRegenerate rotates the session ID, preserving all values — call
    // at login to defeat session fixation.
    procedure SessionRegenerate();
    // SessionDestroy deletes the session server-side and drops the cookie.
    procedure SessionDestroy();
    // SessionCSRFToken returns (minting on first call) the session CSRF token
    // rendered into forms as a hidden _csrf field.
    function SessionCSRFToken(): String;
    // File returns the uploaded file's content for a multipart form field
    // ('' when absent).
    function File(name: String): String;
    // SaveFile writes an uploaded file's content to path on disk.
    procedure SaveFile(name: String; path: String);
  end;

  TResponse = class
    // Html replaces the body with an HTML page (text/html).
    function Html(body: String): TResponse;
    // Send replaces the body as plain text.
    function Send(body: String): TResponse;
    // StatusCode replaces the response status code.
    function StatusCode(status: Integer): TResponse;
    // WithHeader appends a response header (fluent).
    function WithHeader(key: String; value: String): TResponse;
    // WithCookie appends a Set-Cookie header "name=value; Path=/" (fluent).
    function WithCookie(name: String; value: String): TResponse;
    // Redirect sets the response to 302 with a Location header (fluent).
    // Typical handler use: Result := res.Redirect('/login');
    function Redirect(url: String): TResponse;
    // Download sends bytes as a file attachment (Content-Disposition).
    function Download(filename: String; data: String): TResponse;
    // FileBytes sends a file from disk as the response body.
    function FileBytes(path: String): TResponse;
  end;

  TServer = class
  end;

// Create a server listening on the given port.
function NewServer(port: Integer): TServer;

end.
