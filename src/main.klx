program KylixCompiler;

uses token, lexer, parser, generator, llvmgen, error;

var
  SourceFile: String;
  SourceCode: String;
  Lex: TLexer;
  Par: TParser;
  Gen: TGenerator;
  IRGen: TLLVMGenerator;
  Prog: TProgram;
  GoCode: String;
  IRText: String;
  ErrList: TErrorList;
  i: Integer;
  AllOk: Boolean;
  EmitLLVM: Boolean;
  ArgStart: Integer;
  Files: array of String;
  Programs: array of TProgram;

begin
  ErrList := TErrorList.Create;
  EmitLLVM := false;

  // v0.6.9: --emit-llvm switches the bootstrap compiler from Go codegen to the
  // in-Kylix LLVM IR emitter (llvmgen.klx). With this flag, `kylix_self
  // --emit-llvm src/token.klx ...` prints LLVM IR instead of Go — the first
  // step of the no-Go closed loop (IR → llc/clang → native binary next).
  if Length(Args) > 0 then
    if Args[0] = '--emit-llvm' then
      EmitLLVM := true;

  // Use command-line arguments if provided, otherwise fall back to default bootstrap files
  Files := [];
  if Length(Args) > 0 then
  begin
    // v0.6.9: skip the leading --emit-llvm flag (no SetLength in LLVM backend;
    // a start index is the portable way to drop it).
    ArgStart := 0;
    if EmitLLVM then ArgStart := 1;
    for i := ArgStart to Length(Args) - 1 do
      append(Files, Args[i]);
  end
  else
  begin
    append(Files, 'token.klx');
    append(Files, 'error.klx');
    append(Files, 'ast.klx');
    append(Files, 'lexer.klx');
    append(Files, 'parser.klx');
    append(Files, 'generator.klx');
    append(Files, 'llvmgen.klx');
  end;

  Programs := [];
  for i := 0 to Length(Files) - 1 do
    append(Programs, nil);
  AllOk := true;

  for i := 0 to Length(Files) - 1 do
  begin
    SourceFile := Files[i];
    SourceCode := ReadFile(SourceFile);
    if SourceCode = '' then
    begin
      ErrList.AddError(SourceFile, 0, 0, 'cannot read file');
      AllOk := false;
    end
    else
    begin
      Lex := NewLexer(SourceCode);
      Par := NewParser(Lex);
      Programs[i] := Par.ParseProgram();

      if Length(Par.Errors) > 0 then
      begin
        var j: Integer;
        for j := 0 to Length(Par.Errors) - 1 do
        begin
          ErrList.AddError(SourceFile, 0, 0, Par.Errors[j]);
          AllOk := false;
        end;
      end;
    end;
  end;

  if AllOk then
  begin
    if EmitLLVM then
    begin
      // v0.6.9: LLVM IR emitter (in-Kylix). Emit each program's IR in file
      // order and concatenate (P1: single-program IR; multi-program merge is
      // P2). For now emit the first program — the bootstrap emitter P1 handles
      // one program (hello-class) end to end.
      IRGen := TLLVMGenerator.Create;
      if Length(Programs) > 0 then
      begin
        IRGen.EmitProgram(Programs[0]);
        WriteLn(IRGen.Output);
      end;
    end
    else
    begin
      Gen := TGenerator.Create;
      GoCode := Gen.GenerateMulti(Programs);
      WriteLn(GoCode);
    end;
  end
  else
    WriteLn(ErrList.ToString());
end.
