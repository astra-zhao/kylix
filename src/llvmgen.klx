unit llvmgen;
uses token, lexer, ast, error;

// ============================================================================
// LLVM IR emitter (v0.6.9 — bootstrap no-Go closed loop).
// Converts the AST to LLVM IR text, so a Kylix-compiled compiler can emit a
// native binary without the Go toolchain (via llc + clang).
//
// P1 scope (this file): module skeleton + expressions + statements + functions
// — hello-class programs. P2 (llvmgen_class.klx) adds classes/methods/vtables
// + is/as; P3 (llvmgen_stdlib.klx) adds arrays/maps/ReadFile/Args. The whole
// emitter is one unit split across files that all append methods to
// TLLVMGenerator (Kylix units can reopen the same class in later files of the
// same program via separate `unit llvmgen_class;` — actually Kylix units are
// self-contained; we keep the class fully in llvmgen.klx and add the rest as
// standalone procedures + fields as we grow).
//
// Determinism: every register/label is a counter; arrays are iterated by
// index — output is byte-stable, so the self-reproduction fixpoint
// (IR_A ≡ IR_B) is well-defined.
//
// Internal state avoids Kylix maps entirely (the bootstrap parser handles
// maps only for user programs; the emitter's own bookkeeping uses parallel
// arrays + linear scans, exactly like generator.klx's comma-string strategy).
// ============================================================================

type
  TLLVMStringConst = class
    Reg: String;    // "@.str.N"
    Val: String;    // decoded bytes
    Size: Integer;  // len(Val)+1
  end;

  TLLVMGenerator = class
    Output: String;         // IR text accumulator (compat)
    OutputBuf: String;      // P3: chunked output buffer (avoids O(n²) strcpy)
    StmtSeq: Integer;       // v0.6.9 P4: stderr probe sequence counter
    EmitDepth: Integer;     // v0.6.9 P4: call-emit recursion depth (circuit breaker)
    BufLen: Integer;        // v0.6.9 P4: manual flush counter — Length(field)
                            // mis-resolved inside the inline type-block methods,
                            // so the >4096 flush never fired and OutputBuf grew
                            // unbounded (each Write re-malloc'd the whole buffer
                            // → the 6GB self-emit OOM).
    OutputChunks: array of String; // P3: completed 4KB chunks, joined at the end
    StrCount: Integer;
    StrDedup: array of TLLVMStringConst;
    TmpSeq: Integer;
    LblSeq: Integer;
    // locals: parallel arrays (name / llvm type / alloca reg / kylix type)
    LNames: array of String;
    LTypes: array of String;
    LRegs: array of String;
    LKylix: array of String;
    // map vars: name → map value kylix type ('' = not a map). Parallel to
    // LNames so local map reads know how to coerce (Integer→atoll, Boolean→
    // icmp-ne-null, String→ptr). Populated by RegisterMapLocal.
    LMapValueTypes: array of String;
    // global maps: name → map value kylix type (parallel to GNames; '' if the
    // global is not a map). Populated by EmitGlobalVarDecl.
    GMapValueTypes: array of String;
    // constants: parallel name/value
    CNames: array of String;
    CVals: array of Integer;
    // functions: name → return LLVM type ('' = void)
    FNames: array of String;
    FRet: array of String;
    // current function context
    MemberType: String;   // P2: EmitMember/EmitMethodCall return type via field
    LastArrayReg: String; // P3: register back-channel from TryClassFieldArrayIndex
    LastArgTypes: array of String; // P3/#44: arg types from the last EmitCall —
                          // EmitPlainCall coerces each actual to its formal's type
                          // / TryClassFieldMapIndexGet to EmitArrayIndex (these
                          // return Boolean only, so the loaded element register is
                          // smuggled out via this field; without it the String
                          // `result` of EmitArrayIndex stays uninitialized garbage
                          // → crash in WriteLine strlen / empty GEP base).
    LastType: String;     // P2: EmitExprTyped's effective return type (var t is
                           // passed by value in the bootstrap AST — no IsVar)
                           // (host LLVM backend miscompiles var-param writes: `t := x`
                           // stores into the pointer slot instead of through it)
    InFunc: Boolean;
    InReturnFunc: Boolean;
    ResultLLVMType: String;
    FuncExitLabel: String;
    CurClassName: String;
    // flags
    NeedHashtab: Boolean;
    NeedArgs: Boolean;
    NeedMemcpy: Boolean;
    NeedClassRTTI: Boolean;
    NeedReadFile: Boolean;
    NeedToLower: Boolean;
    NeedStrtod: Boolean;
    NeedAtoll: Boolean;
    // P2: top-level globals (name/type/reg, parallel arrays like locals)
    GNames: array of String;
    GTypes: array of String;
    GKylixs: array of String;
    // loop labels (single-level stack, like the host's emitWhile/emitFor)
    LoopHead: String;
    LoopBreak: String;
    // Args builtin global always declared
    ArgsDeclared: Boolean;
    // P2: class layout tables (mirrors host ClassInfo/FieldInfo/MethodInfo)
    ClassNames: array of String;
    ClassEmittedFlags: array of Boolean;
    EmittedNames: array of String; // v0.6.9 P4: emitted-class name list
    ClassParents: array of String;
    ClassFieldNames: array of String;   // per-class field names (comma-string)
    ClassFieldTypes: array of String;   // per-class field LLVM types (comma-string)
    ClassFieldKylix: array of String;   // per-class field Kylix types (comma-string)
    ClassFieldElemKylix: array of String; // per-class field array ELEMENT Kylix type (comma-string; '' when not an array)
    ClassFieldMaps: array of String;    // per-class field map flags (comma "1"/"0")
    ClassMethodNames: array of String;  // per-class method names (vtable order)
    ClassMethodRet: array of String;    // per-class method LLVM return types
    ClassMethodDef: array of String;    // per-class method defining class
    ClassMethodIdx: array of String;    // per-class method vtable idx (comma str)
    // P2: array-of-T metadata (mirrors host arrayInfo)
    ArrNames: array of String;
    ArrDynamic: array of Boolean;
    ArrElem: array of String;
    ArrElemKylix: array of String;
    ArrSize: array of Integer;
    ArrLower: array of Integer;
    // v0.6.9 P3: per-function comma-joined LLVM param types ("i64,i64"),
    // parallel to FNames/FRet — EmitPlainCall needs them to type the call's
    // arguments (LLVM rejects untyped call args).
    FParamTypes: array of String;
    // v0.6.9 P3: stdlib IR segments (see src/stdlib_ir.klx). UsedMods collects
    // every program's `uses` names; UsedSegs is the queue of baked IR segments
    // to append at module end (MarkStdSeg enqueues, EmitStdlibSegments drains).
    UsedMods: array of String;
    UsedSegs: array of String;
    RecordNames: array of String; // v0.6.9 P3: record type names (Pass 0)
    // v0.6.9 P4: flat per-(class,slot) registries. The comma-string accessors
    // below are char-at-a-time O(n²) per call and got hit 1.4M times while
    // self-compiling (MethodCount alone = 1.3GB of never-freed garbage → the
    // self-emit OOM). Flat entries are copied from the parent in MakeClassInfo
    // (child tables are supersets), so lookups never walk the inheritance
    // chain and never build strings. Integer arrays here are append+read only.
    VtCls: array of Integer;   // owning class index
    VtSlot: array of Integer;  // vtable slot
    VtName: array of String;
    VtRet: array of String;    // escaped (',' → '|') like ClassMethodRet
    VtDef: array of String;    // defining class name
    FlCls: array of Integer;   // owning class index
    FlSlot: array of Integer;  // 0-based field slot (struct index = slot+1)
    FlName: array of String;
    FlType: array of String;
    FlKylix: array of String;
    FlElem: array of String;
    FlMap: array of String;    // '1' when the field is a map
    // scratch for the JsonEncode map-arg check (member chains parse; a bare
    // function-parameter `arr[0] as T` does not)
    TmpArg0: TExpression;

    // NOTE: Write/WriteLine are declared AND inlined in the type block (like
    // generator.klx) because `Write` is the reserved word tkWrite — an external
    // implementation `procedure TLLVMGenerator.Write` parses as an expression
    // ("no prefix parse function for write"). Inline bodies disambiguate.
    procedure Write(s: String);
    var big: String;
    begin
      // v0.6.9 P4 DBG: every emitter output funnels through here — catch any
      // runaway line, print its head, and truncate so the run survives.
      big := s;
      if Length(big) > 8192 then
      begin
        self.WriteLine('  ; DBG huge-write len=' + self.IntToStrS(Length(big)) + ' head=' + big[0:100]);
        big := '; TRUNC';
      end;
      self.OutputBuf := self.OutputBuf + big;
      self.BufLen := self.BufLen + Length(big);
      if self.BufLen > 4096 then
      begin
        append(self.OutputChunks, self.OutputBuf);
        self.OutputBuf := '';
        self.BufLen := 0;
      end;
    end;

    // v0.6.9 P3: stdlib IR segment dispatch (see below EmitCall). CollectUse
    // takes a single String — array-of-String method params don't survive the
    // member-chain argument path (TProgram.Uses is not a class field the
    // emitter can lower), so callers loop over the uses list.
    procedure CollectUse(name: String);
    begin
      if name = '' then Exit;
      if self.IndexOfStr(self.UsedMods, name) < 0 then
        append(self.UsedMods, name);
    end;

    procedure WriteLine(s: String);
    begin
      // v0.6.9 P4: use a real 0x0A byte (lifted from the source by the lexer)
      // — the raw '\n' literal stays 2 bytes in the bootstrap, and the
      // emitted IR must be multi-line for llc to parse it.
      self.OutputBuf := self.OutputBuf + s + LFChar;
      self.BufLen := self.BufLen + Length(s) + Length(LFChar);
      if self.BufLen > 4096 then
      begin
        append(self.OutputChunks, self.OutputBuf);
        self.OutputBuf := '';
        self.BufLen := 0;
      end;
    end;

  end;

// ============================================================================
// Constructor — TLLVMGenerator.Create is a plain void method (bootstrap
// constructors emit as `func (self *TLLVMGenerator) Create()`), NOT a special
// "constructor" declaration. The `constructor` keyword is handled by the
// parser like a procedure (method), so we don't redeclare it here — the
// per-instance initialization lives in a plain `procedure Init;` we call from
// main. Declaring a `constructor Create;` would collide with the parser's
// method naming. Instead we rely on Create being callable as
// `TLLVMGenerator.Create()` via the normal member path (P2). For P1, the
// fields are zero-initialized by the alloca defaults; main.klx explicitly
// calls Reset after Create.
// ============================================================================


function TLLVMGenerator.Tmp: String;
begin
  result := '%t' + self.IntToStrS(self.TmpSeq);
  self.TmpSeq := self.TmpSeq + 1;
end;

function TLLVMGenerator.Label: String;
begin
  result := 'lbl' + self.IntToStrS(self.LblSeq);
  self.LblSeq := self.LblSeq + 1;
end;

// ============================================================================
// String pool
// ============================================================================

// AddString pools a source string literal by its RAW value (the lexer keeps
// source escapes like \n as 2 chars: backslash, n). Dedup is on the raw bytes.
// The value is consumed only by EscapeString, which maps source escapes
// directly to IR escapes — so no runtime byte decoding (and no chr()) is ever
// needed, matching host llvmEscapeString output byte-for-byte.
function TLLVMGenerator.AddString(val: String): String;
var
  i: Integer;
  c: TLLVMStringConst;
begin
  for i := 0 to Length(self.StrDedup) - 1 do
    if self.StrDedup[i].Val = val then
    begin
      result := self.StrDedup[i].Reg;
      Exit;
    end;
  c := TLLVMStringConst.Create;
  c.Reg := '@.str.' + self.IntToStrS(self.StrCount);
  c.Val := val;
  c.Size := Length(val) + 1;
  append(self.StrDedup, c);
  self.StrCount := self.StrCount + 1;
  result := c.Reg;
end;

function TLLVMGenerator.PtrTo(strReg: String; size: Integer): String;
var t: String;
begin
  t := self.Tmp();
  self.WriteLine('  ' + t + ' = getelementptr inbounds [' + self.IntToStrS(size) + ' x i8], ptr ' + strReg + ', i64 0, i64 0');
  result := t;
end;

// ============================================================================
// Kylix-side helpers
// ============================================================================

function TLLVMGenerator.IndexOfStr(arr: array of String; needle: String): Integer;
var i: Integer;
begin
  for i := 0 to Length(arr) - 1 do
    if arr[i] = needle then
    begin
      result := i;
      Exit;
    end;
  result := -1;
end;

function TLLVMGenerator.IntToStrS(i: Integer): String;
begin
  // v0.6.9: force a heap copy. The host's IntToStr builtin returns a stack
  // alloca address; returning that from a function (double-stack-return)
  // dangles once the caller makes another call (strlen/strcat clobber it).
  // Concatenating with '' triggers emitStringConcat (malloc+strcpy) → heap.
  result := '' + IntToStr(i);
end;

function TLLVMGenerator.StrContains(haystack, needle: String): Boolean;
var i: Integer;
begin
  result := false;
  if Length(needle) = 0 then
  begin
    result := true;
    Exit;
  end;
  for i := 0 to Length(haystack) - Length(needle) do
    if haystack[i:i+Length(needle)] = needle then
    begin
      result := true;
      Exit;
    end;
end;

function TLLVMGenerator.StrStarts(haystack, prefix: String): Boolean;
begin
  if Length(prefix) > Length(haystack) then
    result := false
  else
    result := haystack[0:Length(prefix)] = prefix;
end;

// IntToHex2 — 2-digit uppercase hex of a byte (LLVM \XX escapes). No IntToHex
// builtin in the bootstrap's LLVM surface, so compute it from nibbles.
function TLLVMGenerator.IntToHex2(b: Integer): String;
const
  HexDigits = '0123456789ABCDEF';
var
  hi, lo: Integer;
begin
  hi := b div 16;
  lo := b mod 16;
  result := HexDigits[hi:hi+1] + HexDigits[lo:lo+1];
end;

// CharByte — 1-char string from a byte value (replaces chr(n), which the
// bootstrap's LLVM backend does not lower).


// ============================================================================
// Locals / constants
// ============================================================================

function TLLVMGenerator.HasLocal(name: String): Boolean;
begin
  result := self.IndexOfStr(self.LNames, name) >= 0;
end;

function TLLVMGenerator.LocalReg(name: String): String;
var i: Integer;
begin
  i := self.IndexOfStr(self.LNames, name);
  if i < 0 then
    result := ''
  else
    result := self.LRegs[i];
end;

function TLLVMGenerator.LocalType(name: String): String;
var i: Integer;
begin
  i := self.IndexOfStr(self.LNames, name);
  if i < 0 then
    result := 'i64'
  else
    result := self.LTypes[i];
end;

function TLLVMGenerator.LocalKylix(name: String): String;
var i: Integer;
begin
  i := self.IndexOfStr(self.LNames, name);
  if i < 0 then
    result := ''
  else
    result := self.LKylix[i];
end;

function TLLVMGenerator.ActualType(name: String): String;
begin
  result := self.LocalType(name);
  if result = 'variant' then result := 'ptr';
  if self.IndexOfStr(self.LNames, name) < 0 then
  begin
    if self.IndexOfStr(self.GNames, name) >= 0 then result := self.GType(name);
  end;
end;

function TLLVMGenerator.RegisterLocal(name, llvmT, kylixT: String): String;
var
  reg, suffix: String;
begin
  // v0.6.9 P4: defensive — a garbage/uninitialized llvmT from a broken
  // inference path made SuffixFor's strcmp dereference junk (gen2 self-emit
  // SEGV). Also probe the value so the bad producer is visible on stderr.
  EProg('RL1');
  if llvmT = 'i64' then llvmT := 'i64'
  else if llvmT = 'i1' then llvmT := 'i1'
  else if llvmT = 'double' then llvmT := 'double'
  else if llvmT = 'ptr' then llvmT := 'ptr'
  else if llvmT = '{ ptr, i64, i64 }' then llvmT := '{ ptr, i64, i64 }'
  else if llvmT = 'variant' then llvmT := 'ptr'
  else llvmT := 'i64';
  EProg('RL2');
  if self.HasLocal(name) then
  begin
    EProg('RL3');
    result := self.LocalReg(name);
    Exit;
  end;
  EProg('RL4');
  suffix := self.SuffixFor(llvmT);
  EProg('RL5');
  reg := '%v_' + name + suffix;
  EProg('RL6');
  self.WriteLine('  ' + reg + ' = alloca ' + llvmT + ', align 8');
  EProg('RL7');
  if llvmT = 'ptr' then self.WriteLine('  store ptr null, ptr ' + reg)
  else if llvmT = 'i1' then self.WriteLine('  store i1 0, ptr ' + reg)
  else if llvmT = 'double' then self.WriteLine('  store double 0.0, ptr ' + reg)
  else if llvmT = '{ ptr, i64, i64 }' then self.WriteLine('  store { ptr, i64, i64 } zeroinitializer, ptr ' + reg)
  else self.WriteLine('  store i64 0, ptr ' + reg);
  EProg('RL8');
  append(self.LNames, name);
  append(self.LTypes, llvmT);
  append(self.LRegs, reg);
  append(self.LKylix, kylixT);
  EProg('RL9');
  result := reg;
  EProg('RL10 ' + name + ' ' + kylixT);
end;

// RegisterMapLocal — declare a map local var: alloca a ptr slot holding the
// htab handle, initialized to htab_new(). Tracks the map's value kylix type so
// reads can coerce (host emitMapVarDecl + mapVars).
function TLLVMGenerator.RegisterMapLocal(name: String; valueKylixT: String): String;
var
  reg, tbl: String;
begin
  reg := self.RegisterLocal(name, 'ptr', valueKylixT);
  if self.IndexOfStr(self.LNames, name) >= 0 then
  begin
    if Length(self.LMapValueTypes) < Length(self.LNames) then
      while Length(self.LMapValueTypes) < Length(self.LNames) - 1 do append(self.LMapValueTypes, '');
    while Length(self.LMapValueTypes) < Length(self.LNames) do append(self.LMapValueTypes, '');
    if self.IndexOfStr(self.LNames, name) = Length(self.LNames) - 1 then
      self.LMapValueTypes[Length(self.LMapValueTypes) - 1] := valueKylixT;
  end;
  self.NeedHashtab := true;
  tbl := self.Tmp();
  self.WriteLine('  ' + tbl + ' = call ptr @__kylix_htab_new()');
  self.WriteLine('  store ptr ' + tbl + ', ptr ' + reg);
  result := reg;
end;

// IsLocalMap — whether a local/param is a map-typed variable.
function TLLVMGenerator.IsLocalMap(name: String): Boolean;
begin
  result := self.LocalType(name) = 'ptr';
  if result then
    result := self.MapValueType(name) <> '';
end;

// MapValueType — the kylix value type of a map local ('' if not a map).
function TLLVMGenerator.MapValueType(name: String): String;
var i: Integer;
begin
  result := '';
  i := self.IndexOfStr(self.LNames, name);
  if i < 0 then Exit;
  if i < Length(self.LMapValueTypes) then result := self.LMapValueTypes[i];
end;

// GMapValueType — the kylix value type of a map global ('' if not a map).
function TLLVMGenerator.GMapValueType(name: String): String;
var i: Integer;
begin
  result := '';
  i := self.IndexOfStr(self.GNames, name);
  if i < 0 then Exit;
  if i < Length(self.GMapValueTypes) then result := self.GMapValueTypes[i];
end;

function TLLVMGenerator.ConstValue(name: String): Integer;
var i: Integer;
begin
  i := self.IndexOfStr(self.CNames, name);
  if i < 0 then
    result := 0
  else
    result := self.CVals[i];
end;

function TLLVMGenerator.HasConst(name: String): Boolean;
begin
  result := self.IndexOfStr(self.CNames, name) >= 0;
end;

function TLLVMGenerator.IsRecord(tname: String): Boolean;
begin
  result := false;
end;

// ---- map value type predicates (mirror host mapReadResult/isIntegerLikeType) --

// IsIntegerKylix — whether a kylix type name is an integer/enum type (map
// values of that type should be atoll-converted on read).
function TLLVMGenerator.IsIntegerKylix(t: String): Boolean;
var lo: String;
begin
  lo := LowerCase(t);
  if (lo = 'integer') or (lo = 'int') or (lo = 'int64') or (lo = 'longint') or (lo = 'word') or (lo = 'cardinal') or (lo = 'byte') then
  begin
    result := true;
    Exit;
  end;
  if t = '' then
  begin
    result := false;
    Exit;
  end;
  // enum types are T-prefixed and not classes/records → integer-like
  if self.IsClass(t) then
  begin
    result := false;
    Exit;
  end;
  if self.StrStarts(t, 'T') then
  begin
    result := true;
    Exit;
  end;
  result := false;
end;

// IsBooleanKylix — whether a kylix type name is Boolean.
function TLLVMGenerator.IsBooleanKylix(t: String): Boolean;
var lo: String;
begin
  lo := LowerCase(t);
  result := (lo = 'boolean') or (lo = 'bool');
end;

// IsMapArrayValue — whether a map's value type is an array (map[K]array of T).
// These can't round-trip through the string htab; reads yield a zero slice.
function TLLVMGenerator.IsMapArrayValue(t: String): Boolean;
begin
  result := t = 'array';
end;

// FieldMapValueKylix — the map value kylix type for a map-typed class field.
// MakeClassInfo bakes the map's VALUE type name into the kylix table for map
// fields (TypeExprName(mt.ValueType)), so this is a plain FieldKylixAt read.
function TLLVMGenerator.FieldMapValueKylix(ci, fi: Integer): String;
begin
  result := self.FieldKylixAt(ci, fi);
end;

function TLLVMGenerator.IsNilNode(e: TExpression): Boolean;
begin
  if e is TNilLiteral then
    result := true
  else
    result := false;
end;

// ============================================================================
// LLVM type mapping
// ============================================================================

function TLLVMGenerator.LlvmTypeFor(tname: String): String;
var lo: String;
begin
  lo := LowerCase(tname);
  if (lo = 'integer') or (lo = 'int64') or (lo = 'int') or (lo = 'longint') then result := 'i64'
  else if (lo = 'boolean') or (lo = 'bool') then result := 'i1'
  else if (lo = 'real') or (lo = 'double') or (lo = 'float') or (lo = 'single') then result := 'double'
  else if (lo = 'string') or (lo = 'ansistring') then result := 'ptr'
  else if (lo = 'char') then result := 'i8'
  else if (lo = 'variant') then result := 'ptr'
  else result := 'i64';
end;

function TLLVMGenerator.TypeExprName(e: TExpression): String;
begin
  if e = nil then result := ''
  else if e is TIdentifier then result := (e as TIdentifier).Value
  else if e is TVariantType then result := 'Variant'
  else if e is TArrayType then result := 'array'
  else if e is TMapType then result := 'map'
  else result := '';
end;

function TLLVMGenerator.LlvmTypeOfExpr(e: TExpression): String;
var
  at: TArrayType;
  size: Integer;
begin
  if e = nil then
  begin
    result := 'i64';
    Exit;
  end;
  if e is TArrayType then
  begin
    at := e as TArrayType;
    if at.Dynamic then result := '{ ptr, i64, i64 }'
    else
    begin
      size := 1;
      if at.Size <> nil then size := self.EvalConstInt(at.Size);
      result := '[' + self.IntToStrS(size) + ' x ' + self.LlvmTypeOfExpr(at.ElementType) + ']';
    end;
    Exit;
  end;
  if e is TMapType then
  begin
    result := 'ptr';
    self.NeedHashtab := true;
    Exit;
  end;
  if e is TVariantType then
  begin
    result := 'ptr';
    Exit;
  end;
  if e is TIdentifier then
  begin
    if self.IsClass((e as TIdentifier).Value) then
    begin
      result := 'ptr';
      Exit;
    end;
    // v0.6.9 P3: records pre-register into ClassNames (Pass 0), so IsClass
    // covers them too — TToken = record is TParser.CurToken's type; without
    // this the field bakes as i64 and every self.CurToken.X chain is mistyped.
  end;
  result := self.LlvmTypeFor(self.TypeExprName(e));
end;

function TLLVMGenerator.SuffixFor(llvmT: String): String;
begin
  if llvmT = 'i1' then result := '_bool'
  else if llvmT = 'double' then result := '_real'
  else if llvmT = 'ptr' then result := '_str'
  else if llvmT = '{ ptr, i64, i64 }' then result := '_dyn'
  else if llvmT = 'variant' then result := '_var'
  else result := '_int';
end;

// EvalConstInt — constant integer literal evaluation (used for array sizes).
function TLLVMGenerator.EvalConstInt(e: TExpression): Integer;
begin
  if e is TIntegerLiteral then
    result := (e as TIntegerLiteral).Value
  else
    result := 1;
end;

// ============================================================================
// Module emission
// ============================================================================

// EmitPrograms — multi-file bootstrap compilation (P3). Registers all
// programs' classes/functions/consts, emits every declaration, then emits the
// non-unit main program's statements. Mirrors host MergePrograms: exactly one
// non-unit program provides the entry point.
procedure TLLVMGenerator.EmitPrograms(progs: array of TProgram);
var
  pi, i: Integer;
  p: TProgram;
  decl: TNode;
  td: TTypeDecl;
  cd: TClassDecl;
  cdec: TConstDecl;
  et: TEnumType;
  mainIdx: Integer;
  hasBody: Boolean;
  ei: Integer;
begin
  self.EmitHeader();
  self.EmitRuntimeDecls();
  // v0.6.9 P4: register the `progs` parameter array so `progs[pi].Field`
  // resolves (was: array index unhandled → IsUnit/Declarations/Statements
  // all collapsed to stubs inside Pass 0/2/3).
  self.RegisterArray('progs', true, 'ptr', 'TProgram', 0, 0);
  // v0.6.9 P4: hand-bake TProgram's field table. Pass 0 reads
  // progs[pi].Declarations BEFORE ast.klx's MakeClassInfo runs (ast is file
  // #3, token is #1 — chicken-and-egg), so the field lookup needs the table
  // now. Slots match the TProgram GEPs (Declarations=6, Statements=7).
  if self.ClassIndex('TProgram') < 0 then
  begin
    append(self.ClassNames, 'TProgram');
    append(self.ClassEmittedFlags, false);
    append(self.ClassParents, '');
    append(self.ClassFieldNames, '');
    append(self.ClassFieldTypes, '');
    append(self.ClassFieldKylix, '');
    append(self.ClassFieldElemKylix, '');
    append(self.ClassFieldMaps, '');
    append(self.ClassMethodNames, ',');
    append(self.ClassMethodRet, ',');
    append(self.ClassMethodDef, ',');
    append(self.ClassMethodIdx, ',');
    append(self.FlCls, self.ClassIndex('TProgram'));
    append(self.FlSlot, 0);
    append(self.FlName, 'Name');
    append(self.FlType, 'ptr');
    append(self.FlKylix, 'String');
    append(self.FlElem, '');
    append(self.FlMap, '0');
    append(self.FlCls, self.ClassIndex('TProgram'));
    append(self.FlSlot, 1);
    append(self.FlName, 'NameToken');
    append(self.FlType, 'ptr');
    append(self.FlKylix, 'TToken');
    append(self.FlElem, '');
    append(self.FlMap, '0');
    append(self.FlCls, self.ClassIndex('TProgram'));
    append(self.FlSlot, 2);
    append(self.FlName, 'UnitName');
    append(self.FlType, 'ptr');
    append(self.FlKylix, 'String');
    append(self.FlElem, '');
    append(self.FlMap, '0');
    append(self.FlCls, self.ClassIndex('TProgram'));
    append(self.FlSlot, 3);
    append(self.FlName, 'IsUnit');
    append(self.FlType, 'i1');
    append(self.FlKylix, 'Boolean');
    append(self.FlElem, '');
    append(self.FlMap, '0');
    append(self.FlCls, self.ClassIndex('TProgram'));
    append(self.FlSlot, 4);
    append(self.FlName, 'Uses');
    append(self.FlType, '{ ptr, i64, i64 }');
    append(self.FlKylix, '');
    append(self.FlElem, 'String');
    append(self.FlMap, '0');
    append(self.FlCls, self.ClassIndex('TProgram'));
    append(self.FlSlot, 5);
    append(self.FlName, 'Declarations');
    append(self.FlType, '{ ptr, i64, i64 }');
    append(self.FlKylix, '');
    append(self.FlElem, 'TNode');
    append(self.FlMap, '0');
    append(self.FlCls, self.ClassIndex('TProgram'));
    append(self.FlSlot, 6);
    append(self.FlName, 'Statements');
    append(self.FlType, '{ ptr, i64, i64 }');
    append(self.FlKylix, '');
    append(self.FlElem, 'TStatement');
    append(self.FlMap, '0');
    append(self.FlCls, self.ClassIndex('TProgram'));
    append(self.FlSlot, 7);
    append(self.FlName, 'UsesPolymorphism');
    append(self.FlType, 'i1');
    append(self.FlKylix, 'Boolean');
    append(self.FlElem, '');
    append(self.FlMap, '0');
  end;
  self.WriteLine('  ; dbg programs=' + self.IntToStrS(Length(progs)));
  StdIrInit();
  // NOTE: uses collection for EmitPrograms is done inside EmitDecl loops via
  // CollectUse below (see CollectProgramUses) — chained progs[pi].Uses[i]
  // member-index args are not lowerable here.
  self.CollectProgramUses(progs);
  // Pass 0: pre-register every class name so IsClass resolves across files
  // (field access / receiver dispatch need it before emission).
  for pi := 0 to Length(progs) - 1 do
  begin
    p := progs[pi];
    for i := 0 to Length(p.Declarations) - 1 do
    begin
      decl := p.Declarations[i];
      if decl is TTypeDecl then
      begin
        td := decl as TTypeDecl;
        if td.DeclType is TClassDecl then
        begin
          cd := td.DeclType as TClassDecl;
          cd.Name := td.Name;
          if self.ClassIndex(cd.Name) < 0 then self.MakeClassInfo(cd.Name, cd);
        end
        else if td.DeclType is TRecordType then
        begin
          // v0.6.9 P3: pre-register record names so MakeClassInfo resolves
          // record-typed fields (TParser.CurToken: TToken) as ptr. Tables
          // stay empty; EmitRecordDecl fills them in Pass 2 (guarded).
          if self.ClassIndex(td.Name) < 0 then
          begin
            append(self.ClassNames, td.Name);
            append(self.RecordNames, td.Name);
            append(self.ClassEmittedFlags, false);
            append(self.ClassParents, '');
            append(self.ClassFieldNames, '');
            append(self.ClassFieldTypes, '');
            append(self.ClassFieldKylix, '');
            append(self.ClassFieldElemKylix, '');
            append(self.ClassFieldMaps, '');
            append(self.ClassMethodNames, ',');
            append(self.ClassMethodRet, ',');
            append(self.ClassMethodDef, ',');
            append(self.ClassMethodIdx, ',');
          end;
        end;
      end
      else if decl is TClassDecl then
      begin
        cd := decl as TClassDecl;
        if self.ClassIndex(cd.Name) < 0 then self.MakeClassInfo(cd.Name, cd);
      end;
    end;
  end;
  // Pass 1: register function signatures + enum consts (all files).
  for pi := 0 to Length(progs) - 1 do
  begin
    i := 0;
    p := progs[pi];
    while i < Length(p.Declarations) do
    begin
      decl := p.Declarations[i];
      if decl is TFunctionDecl then
      begin
        hasBody := (decl as TFunctionDecl).Body <> nil;
        if hasBody then
        begin
          if self.StrContains((decl as TFunctionDecl).Name, '.') then
            append(self.FNames, self.DotToUnderscore((decl as TFunctionDecl).Name))
          else
            append(self.FNames, (decl as TFunctionDecl).Name);
          if (decl as TFunctionDecl).ReturnType = nil then
            append(self.FRet, '')
          else
            append(self.FRet, self.LlvmTypeOfExpr((decl as TFunctionDecl).ReturnType));
          append(self.FParamTypes, self.FuncParamTypes(decl));
        end;
      end
      else if decl is TTypeDecl then
      begin
        td := decl as TTypeDecl;
        if td.DeclType is TEnumType then
        begin
          // NB: use a dedicated variable — the bootstrap's for-loop variable
          // does NOT shadow, so reusing `i` here clobbers the outer loop
          // (a 3-member enum left i=3, silently skipping every declaration
          // after the first type in the file — the IsLetter registration bug).
          et := td.DeclType as TEnumType;
          for ei := 0 to Length(et.Names) - 1 do
          begin
            append(self.CNames, et.Names[ei]);
            append(self.CVals, ei);
          end;
        end;
      end
      else if decl is TConstDecl then
      begin
        // v0.6.9 P4: integer consts must be registered or every read in the
        // emitted code collapses to 0 (`undefined var PREC_EQUALS` broke
        // GetPrecedence → all call parsing in gen2).
        cdec := decl as TConstDecl;
        append(self.CNames, cdec.Name);
        append(self.CVals, self.EvalConstInt(cdec.Value));
      end;
      i := i + 1;
    end;
  end;
  // v0.6.9 P3: unit files carry their functions in Statements (the parser
  // appends top-level functions there for units) — register them too.
  for pi := 0 to Length(progs) - 1 do
  begin
    p := progs[pi];
    for i := 0 to Length(p.Statements) - 1 do
    begin
      decl := p.Statements[i];
      if decl is TFunctionDecl then
      begin
        hasBody := (decl as TFunctionDecl).Body <> nil;
        self.WriteLine('  ; dbg p1stmtfn hasBody=' + self.BoolStr1(hasBody) + ' nfn=' + self.IntToStrS(Length(self.FNames)));
        if hasBody then
        begin
          if self.StrContains((decl as TFunctionDecl).Name, '.') then
            append(self.FNames, self.DotToUnderscore((decl as TFunctionDecl).Name))
          else
            append(self.FNames, (decl as TFunctionDecl).Name);
          if (decl as TFunctionDecl).ReturnType = nil then
            append(self.FRet, '')
          else
            append(self.FRet, self.LlvmTypeOfExpr((decl as TFunctionDecl).ReturnType));
          append(self.FParamTypes, self.FuncParamTypes(decl));
        end;
      end;
    end;
  end;
  // Pass 2: emit declarations (all files) — plus unit functions from Statements.
  for pi := 0 to Length(progs) - 1 do
  begin
    p := progs[pi];
    for i := 0 to Length(p.Declarations) - 1 do
      self.EmitDecl(p.Declarations[i]);
    i := 0;
    p := progs[pi];
    while i < Length(p.Statements) do
    begin
      decl := p.Statements[i];
      if decl is TFunctionDecl then
      begin
        hasBody := (decl as TFunctionDecl).Body <> nil;
        if hasBody then
          self.EmitDecl(decl);
      end;
      i := i + 1;
    end;
  end;
  // Pass 3: main statements — the first non-unit program with statements.
  mainIdx := -1;
  for pi := 0 to Length(progs) - 1 do
  begin
    p := progs[pi];
    if p.IsUnit then
      continue;
    if Length(p.Statements) > 0 then
    begin
      mainIdx := pi;
      break;
    end;
  end;
  if mainIdx >= 0 then
  begin
    p := progs[mainIdx];
    self.EmitMain(p.Statements);
  end;
  self.EmitStdlibSegments();
  if self.NeedHashtab then self.EmitHashtabBodies();
  if self.NeedClassRTTI then self.EmitClassRuntime();
  self.EmitStringConsts();
  self.FinalizeOutput();
end;

procedure TLLVMGenerator.EmitProgram(prog: TProgram);
var
  i, ei: Integer;
  decl: TNode;
  td: TTypeDecl;
  cd: TClassDecl;
begin
  self.EmitHeader();
  self.EmitRuntimeDecls();

  // Pass 1: register function signatures (forward references) + enum consts.
  for i := 0 to Length(prog.Declarations) - 1 do
  begin
    decl := prog.Declarations[i];
    if decl is TFunctionDecl then
    begin
      hasBody := (decl as TFunctionDecl).Body <> nil;
      if hasBody then
      begin
        if self.StrContains((decl as TFunctionDecl).Name, '.') then
          append(self.FNames, self.DotToUnderscore((decl as TFunctionDecl).Name))
        else
          append(self.FNames, (decl as TFunctionDecl).Name);
        if (decl as TFunctionDecl).ReturnType = nil then
          append(self.FRet, '')
        else
          append(self.FRet, self.LlvmTypeOfExpr((decl as TFunctionDecl).ReturnType));
        append(self.FParamTypes, self.FuncParamTypes(decl));
      end;
    end
    else if decl is TTypeDecl then
    begin
      td := decl as TTypeDecl;
      if td.DeclType is TEnumType then
      begin
        // NB: dedicated loop var — `for i` here would clobber the outer
        // declaration loop (no shadowing in the bootstrap's for semantics)
        for ei := 0 to Length((td.DeclType as TEnumType).Names) - 1 do
        begin
          append(self.CNames, (td.DeclType as TEnumType).Names[ei]);
          append(self.CVals, ei);
        end;
      end;
    end;
  end;

  // Pass 2: emit declarations.
  for i := 0 to Length(prog.Declarations) - 1 do
    self.EmitDecl(prog.Declarations[i]);

  // Pass 3: main function.
  if Length(prog.Statements) > 0 then
    self.EmitMain(prog.Statements);

  StdIrInit();
  // (single-program path: no uses collection — the bootstrap always goes
  // through EmitPrograms, and prog.Uses[i] member-index chains don't lower.)
  self.EmitStdlibSegments();
  if self.NeedHashtab then self.EmitHashtabBodies();
  if self.NeedClassRTTI then self.EmitClassRuntime();
  self.EmitStringConsts();
  self.FinalizeOutput();
end;

// FinalizeOutput — flush OutputBuf into Output (join all chunks once, at the
// end, instead of O(n²) re-copying per WriteLine). P3.
procedure TLLVMGenerator.FinalizeOutput;
var
  n, i, w: Integer;
begin
  // v0.6.9/P4: pairwise in-place merge. The old `all := all + chunk` loop is
  // O(n²) in allocations — ~1900 4KB chunks re-malloc the whole prefix on
  // every step ≈ 7GB of never-freed strings (no GC in the LLVM runtime) —
  // the self-emit OOM. Pairwise merging does log2(n) rounds, each allocating
  // the output size once (~2x total). NB: `w <= i` always, so overwriting
  // slot w with the merge of slots i/i+1 never clobbers unmerged data.
  if Length(self.OutputBuf) > 0 then
    append(self.OutputChunks, self.OutputBuf);
  self.OutputBuf := '';
  n := Length(self.OutputChunks);
  while n > 1 do
  begin
    w := 0;
    i := 0;
    while i < n do
    begin
      if i + 1 < n then
        self.OutputChunks[w] := self.OutputChunks[i] + self.OutputChunks[i + 1]
      else
        self.OutputChunks[w] := self.OutputChunks[i];
      w := w + 1;
      i := i + 2;
    end;
    n := w;
  end;
  if n > 0 then
    self.Output := self.OutputChunks[0]
  else
    self.Output := '';
  self.OutputChunks := [];
end;

procedure TLLVMGenerator.EmitHeader;
begin
  self.WriteLine('; Kylix LLVM IR');
  self.WriteLine('source_filename = "kylix.klx"');
  self.WriteLine('target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128"');
  self.WriteLine('target triple = "arm64-apple-macosx15.0.0"');
  self.WriteLine('');
end;

procedure TLLVMGenerator.EmitRuntimeDecls;
begin
  self.WriteLine('; ===== Runtime declarations (libc) =====');
  self.WriteLine('@__kylix_emptystr = global [1 x i8] c"\00"');
  self.WriteLine('declare i32 @printf(ptr noundef, ...)');
  self.WriteLine('declare i32 @puts(ptr noundef)');
  self.WriteLine('declare ptr @malloc(i64 noundef)');
  self.WriteLine('declare i64 @write(i32 noundef, ptr noundef, i64 noundef)');
  self.WriteLine('declare ptr @calloc(i64 noundef, i64 noundef)');
  self.WriteLine('declare void @free(ptr noundef)');
  self.WriteLine('declare i64 @strlen(ptr noundef)');
  self.WriteLine('declare ptr @strcpy(ptr noundef, ptr noundef)');
  self.WriteLine('declare ptr @strcat(ptr noundef, ptr noundef)');
  self.WriteLine('declare i32 @strcmp(ptr noundef, ptr noundef)');
  self.WriteLine('declare ptr @memcpy(ptr noundef, ptr noundef, i64 noundef)');
  self.WriteLine('declare ptr @memmove(ptr noundef, ptr noundef, i64 noundef)');
  self.WriteLine('declare i64 @atoll(ptr noundef)');
  self.WriteLine('declare i32 @snprintf(ptr noundef, i64 noundef, ptr noundef, ...)');
  self.WriteLine('declare double @strtod(ptr noundef, ptr noundef)');
  self.WriteLine('declare double @fabs(double)');
  self.WriteLine('declare ptr @strchr(ptr noundef, i32)');
  self.WriteLine('declare ptr @strstr(ptr noundef, ptr noundef)');
  self.WriteLine('declare i32 @strncmp(ptr noundef, ptr noundef, i64 noundef)');
  self.WriteLine('declare i32 @gettimeofday(ptr, ptr)');
  self.WriteLine('declare i32 @setjmp(ptr)');
  self.WriteLine('declare i32 @_setjmp(ptr)');
  self.WriteLine('declare void @_longjmp(ptr, i32)');
  self.WriteLine('declare void @longjmp(ptr, i32)');
  self.WriteLine('declare void @exit(i32)');
  self.WriteLine('declare ptr @fopen(ptr noundef, ptr noundef)');
  self.WriteLine('declare i32 @fclose(ptr noundef)');
  self.WriteLine('declare i64 @fread(ptr noundef, i64 noundef, i64 noundef, ptr noundef)');
  self.WriteLine('declare i64 @fwrite(ptr noundef, i64 noundef, i64 noundef, ptr noundef)');
  self.WriteLine('declare i32 @fputs(ptr noundef, ptr noundef)');
  self.WriteLine('declare i32 @fseek(ptr noundef, i64 noundef, i32 noundef)');
  self.WriteLine('declare i64 @ftell(ptr noundef)');
  self.WriteLine('declare i32 @access(ptr noundef, i32 noundef)');
  self.WriteLine('declare i32 @mkdir(ptr noundef, i32 noundef)');
  self.WriteLine('declare i32 @remove(ptr noundef)');
  self.WriteLine('declare ptr @getcwd(ptr noundef, i64 noundef)');
  self.WriteLine('declare i32 @chdir(ptr noundef)');
  self.WriteLine('declare ptr @getenv(ptr noundef)');
  self.WriteLine('declare ptr @opendir(ptr noundef)');
  self.WriteLine('declare i32 @closedir(ptr noundef)');
  // v0.6.9 P3: full host parity — sockets, OpenSSL, sqlite3, libcurl, regex,
  // time.h and the LLVM mem intrinsics (stdlib segments reference these).
  self.WriteLine('declare i32 @socket(i32 noundef, i32 noundef, i32 noundef)');
  self.WriteLine('declare i32 @connect(i32 noundef, ptr noundef, i32 noundef)');
  self.WriteLine('declare i32 @bind(i32 noundef, ptr noundef, i32 noundef)');
  self.WriteLine('declare i32 @listen(i32 noundef, i32 noundef)');
  self.WriteLine('declare i32 @accept(i32 noundef, ptr, ptr)');
  self.WriteLine('declare i64 @send(i32 noundef, ptr noundef, i64 noundef, i32 noundef)');
  self.WriteLine('declare i64 @recv(i32 noundef, ptr noundef, i64 noundef, i32 noundef)');
  self.WriteLine('declare i32 @close(i32 noundef)');
  self.WriteLine('declare void @arc4random_buf(ptr noundef, i64 noundef)');
  self.WriteLine('declare i64 @getrandom(ptr noundef, i64 noundef, i32 noundef)');
  self.WriteLine('declare i32 @setsockopt(i32 noundef, i32 noundef, ptr noundef, i32 noundef)');
  self.WriteLine('declare i32 @inet_pton(i32 noundef, ptr noundef, ptr noundef)');
  self.WriteLine('declare ptr @SHA256(ptr noundef, i64 noundef, ptr noundef)');
  self.WriteLine('declare ptr @MD5(ptr noundef, i64 noundef, ptr noundef)');
  self.WriteLine('declare ptr @strncpy(ptr noundef, ptr noundef, i64 noundef)');
  self.WriteLine('declare ptr @EVP_CIPHER_CTX_new()');
  self.WriteLine('declare void @EVP_CIPHER_CTX_free(ptr noundef)');
  self.WriteLine('declare ptr @EVP_aes_256_cbc()');
  self.WriteLine('declare i32 @EVP_EncryptInit_ex(ptr noundef, ptr noundef, ptr noundef, ptr noundef, ptr noundef)');
  self.WriteLine('declare i32 @EVP_EncryptUpdate(ptr noundef, ptr noundef, ptr noundef, ptr noundef, i32 noundef)');
  self.WriteLine('declare i32 @EVP_EncryptFinal_ex(ptr noundef, ptr noundef, ptr noundef)');
  self.WriteLine('declare i32 @EVP_DecryptInit_ex(ptr noundef, ptr noundef, ptr noundef, ptr noundef, ptr noundef)');
  self.WriteLine('declare i32 @EVP_DecryptUpdate(ptr noundef, ptr noundef, ptr noundef, ptr noundef, i32 noundef)');
  self.WriteLine('declare i32 @EVP_DecryptFinal_ex(ptr noundef, ptr noundef, ptr noundef)');
  self.WriteLine('declare i32 @EVP_CIPHER_CTX_block_size(ptr noundef)');
  self.WriteLine('declare i32 @RAND_bytes(ptr noundef, i32 noundef)');
  self.WriteLine('declare ptr @EVP_sha256()');
  self.WriteLine('declare i32 @PKCS5_PBKDF2_HMAC(ptr noundef, i32 noundef, ptr noundef, i32 noundef, i64 noundef, ptr noundef, i32 noundef, ptr noundef)');
  self.WriteLine('declare i32 @sscanf(ptr noundef, ptr noundef, ...)');
  self.WriteLine('declare i32 @tolower(i32 noundef)');
  self.WriteLine('declare i32 @toupper(i32 noundef)');
  self.WriteLine('declare i32 @sqlite3_open(ptr noundef, ptr noundef)');
  self.WriteLine('declare i32 @sqlite3_close(ptr noundef)');
  self.WriteLine('declare i32 @sqlite3_prepare_v2(ptr noundef, ptr noundef, i32 noundef, ptr noundef, ptr noundef)');
  self.WriteLine('declare i32 @sqlite3_bind_text(ptr noundef, ptr noundef, i32 noundef, ptr noundef, i32 noundef, i64 noundef)');
  self.WriteLine('declare i32 @sqlite3_bind_int64(ptr noundef, i32 noundef, i64 noundef)');
  self.WriteLine('declare i32 @sqlite3_step(ptr noundef)');
  self.WriteLine('declare ptr @sqlite3_column_text(ptr noundef, i32 noundef)');
  self.WriteLine('declare i32 @sqlite3_column_count(ptr noundef)');
  self.WriteLine('declare ptr @sqlite3_column_name(ptr noundef, i32 noundef)');
  self.WriteLine('declare i32 @sqlite3_column_type(ptr noundef, i32 noundef)');
  self.WriteLine('declare i64 @sqlite3_column_int64(ptr noundef, i32 noundef)');
  self.WriteLine('declare double @sqlite3_column_double(ptr noundef, i32 noundef)');
  self.WriteLine('declare i32 @sqlite3_finalize(ptr noundef)');
  self.WriteLine('declare i32 @sqlite3_changes(ptr noundef)');
  self.WriteLine('declare ptr @curl_easy_init()');
  self.WriteLine('declare i32 @curl_easy_setopt(ptr noundef, i32 noundef, ...)');
  self.WriteLine('declare i32 @curl_easy_perform(ptr noundef)');
  self.WriteLine('declare void @curl_easy_cleanup(ptr noundef)');
  self.WriteLine('declare ptr @curl_slist_append(ptr noundef, ptr noundef)');
  self.WriteLine('declare void @curl_slist_free_all(ptr noundef)');
  self.WriteLine('declare i32 @regcomp(ptr noundef, ptr noundef, i32 noundef)');
  self.WriteLine('declare i32 @regexec(ptr noundef, ptr noundef, i64 noundef, ptr, i32 noundef)');
  self.WriteLine('declare void @regfree(ptr noundef)');
  self.WriteLine('declare i64 @time(ptr)');
  self.WriteLine('declare ptr @localtime(ptr)');
  self.WriteLine('declare ptr @localtime_r(ptr, ptr)');
  self.WriteLine('declare i32 @localtime_s(ptr, ptr)');
  self.WriteLine('declare i64 @mktime(ptr)');
  self.WriteLine('declare i64 @strftime(ptr, i64, ptr, ptr)');
  self.WriteLine('declare void @llvm.memset.p0.i64(ptr nocapture writeonly, i8, i64, i1 immarg)');
  self.WriteLine('declare void @llvm.memcpy.p0.p0.i64(ptr noalias nocapture writeonly, ptr noalias nocapture readonly, i64, i1 immarg)');
  self.WriteLine('@__kylix_datetime_arena = internal global [1048576 x i8] zeroinitializer, align 8');
  self.WriteLine('@__kylix_datetime_arena_ptr = internal global ptr @__kylix_datetime_arena, align 8');
  self.WriteLine('@__kylix_args = global { ptr, i64, i64 } zeroinitializer');
  self.WriteLine('');
end;

procedure TLLVMGenerator.EmitMain(stmts: array of TStatement);
var
  i: Integer;
  stmt: TStatement;
begin
  self.WriteLine('; ===== Entry point =====');
  // v0.6.9 P4: fresh local scope — the last Pass-2 function's locals leak
  // into main otherwise, so main's `for i := ...` RegisterLocal found a
  // stale 'i' (no alloca emitted here) and referenced the ghost register.
  self.LNames := [];
  self.LTypes := [];
  self.LRegs := [];
  self.LKylix := [];
  self.LMapValueTypes := [];
  self.InFunc := true;
  self.InReturnFunc := false;
  self.ResultLLVMType := '';
  self.FuncExitLabel := self.Label();
  // v0.6.9 P3: ALWAYS take argc/argv and fill @__kylix_args — NeedArgs is
  // only discovered while emitting statements (after the define line), so
  // the old conditional left gen2's own `Length(Args) > 0` reading an empty
  // store and dropping its command-line files.
  self.WriteLine('define i32 @main(i32 %argc, ptr %argv) {');
  self.WriteLine('entry:');
  self.NeedArgs := true;
  self.EmitArgsSetup();
  // v0.6.9: initialize map globals (htab_new) at main() entry so they're
  // non-null before any function (e.g. InitKeywords) populates them. Mirrors
  // host emitProgram's merged-globals init (codegen.go).
  self.EmitGlobalMapInit();
  // v0.6.9 P3: hoist explicitly-typed vars to main's entry block
  self.PreEmitAllocas(stmts);
  for i := 0 to Length(stmts) - 1 do
  begin
    stmt := stmts[i];
    self.EmitStatement(stmt);
  end;
  self.WriteLine('  br label %' + self.FuncExitLabel);
  self.WriteLine(self.FuncExitLabel + ':');
  self.WriteLine('  ret i32 0');
  self.WriteLine('}');
  self.WriteLine('');
  self.InFunc := false;
end;

procedure TLLVMGenerator.EmitArgsSetup;
var
  n, nneg, count, count64, dataPtr, slot: String;
begin
  n := self.Tmp();
  self.WriteLine('  ' + n + ' = sub i32 %argc, 1');  nneg := self.Tmp();
  self.WriteLine('  ' + nneg + ' = icmp sgt i32 ' + n + ', 0');
  count := self.Tmp();
  self.WriteLine('  ' + count + ' = select i1 ' + nneg + ', i32 ' + n + ', i32 0');
  count64 := self.Tmp();
  self.WriteLine('  ' + count64 + ' = zext i32 ' + count + ' to i64');
  dataPtr := self.Tmp();
  self.WriteLine('  ' + dataPtr + ' = getelementptr ptr, ptr %argv, i64 1');
  slot := self.Tmp();
  self.WriteLine('  ' + slot + ' = getelementptr inbounds { ptr, i64, i64 }, ptr @__kylix_args, i32 0, i32 0');
  self.WriteLine('  store ptr ' + dataPtr + ', ptr ' + slot);
  slot := self.Tmp();
  self.WriteLine('  ' + slot + ' = getelementptr inbounds { ptr, i64, i64 }, ptr @__kylix_args, i32 0, i32 1');
  self.WriteLine('  store i64 ' + count64 + ', ptr ' + slot);
  slot := self.Tmp();
  self.WriteLine('  ' + slot + ' = getelementptr inbounds { ptr, i64, i64 }, ptr @__kylix_args, i32 0, i32 2');
  self.WriteLine('  store i64 ' + count64 + ', ptr ' + slot);
end;

// EmitGlobalMapInit — at main() entry, call htab_new() for each map-typed
// global and store the handle into its global slot. Mirrors host emitProgram's
// merged-globals init (v0.5.4): map globals must be non-null before any
// function (e.g. InitKeywords) populates them.
procedure TLLVMGenerator.EmitGlobalMapInit;
var
  i: Integer;
  tbl: String;
begin
  for i := 0 to Length(self.GNames) - 1 do
  begin
    if self.GMapValueType(self.GNames[i]) <> '' then
    begin
      self.NeedHashtab := true;
      tbl := self.Tmp();
      self.WriteLine('  ' + tbl + ' = call ptr @__kylix_htab_new()');
      self.WriteLine('  store ptr ' + tbl + ', ptr ' + self.GReg(self.GNames[i]));
    end;
  end;
end;

procedure TLLVMGenerator.EmitStringConsts;
var
  i: Integer;
  c: TLLVMStringConst;
begin
  if Length(self.StrDedup) = 0 then Exit;
  self.WriteLine('; ===== String constants =====');
  for i := 0 to Length(self.StrDedup) - 1 do
  begin
    c := self.StrDedup[i];
    self.WriteLine(c.Reg + ' = private unnamed_addr constant [' + self.IntToStrS(c.Size) + ' x i8] c"' + self.EscapeString(c.Val) + '\00", align 1');
  end;
end;

// EscapeString maps a source string literal's RAW bytes to LLVM IR constant
// escapes — host llvmEscapeString byte-for-byte. Each byte is escaped
// individually: printable ASCII passes through, control/quote/backslash
// become \XX. Because the pool stores raw source bytes (with their source
// escapes), the output matches the host's constant strings exactly.
function TLLVMGenerator.EscapeString(s: String): String;
var
  i, n, b: Integer;
  hex: String;
begin
  result := '';
  n := Length(s);
  i := 0;
  while i < n do
  begin
    b := Ord(s[i:i+1]);
    if b = 10 then result := result + '\0A'
    else if b = 13 then result := result + '\0D'
    else if b = 9 then result := result + '\09'
    else if b = 34 then result := result + '\22'
    else if b = 92 then result := result + '\5C'
    else if (b < 32) or (b > 126) then
    begin
      hex := self.IntToHex2(b);
      result := result + '\' + hex;
    end
    else
      result := result + s[i:i+1];
    i := i + 1;
  end;
end;

// ============================================================================
// Declarations
// ============================================================================

procedure TLLVMGenerator.EmitDecl(decl: TNode);
var
  cd: TClassDecl;
  fd: TFunctionDecl;
  vd: TVarDecl;
  td: TTypeDecl;
  rtDecl: TRecordType;
begin
  EProg('ED enter');
  if decl is TClassDecl then
  begin
    EProg('ED class');
    cd := decl as TClassDecl;
    self.EmitClassDecl(cd);
  end
  else if decl is TFunctionDecl then
  begin
    EProg('ED fn');
    fd := decl as TFunctionDecl;
    // unit interface declarations carry no body — the implementation (same
    // name, with Body) is the one to emit; emitting both duplicates the define.
    if fd.Body <> nil then
      self.EmitFunctionDecl(fd);
  end
  else if decl is TConstDecl then
  begin
    // consts pre-registered; nothing else to emit.
  end
  else if decl is TVarDecl then
  begin
    EProg('ED var');
    vd := decl as TVarDecl;
    self.EmitGlobalVarDecl(vd);
  end
  else if decl is TTypeDecl then
  begin
    td := decl as TTypeDecl;
    if td.DeclType is TRecordType then
    begin
      rtDecl := td.DeclType as TRecordType;
      self.EmitRecordDecl(td.Name, rtDecl);
    end
    else if td.DeclType is TClassDecl then
    begin
      cd := td.DeclType as TClassDecl;
      cd.Name := td.Name;
      self.EmitClassDecl(cd);
    end;
  end;
end;

// EmitClassDecl — register class layout + emit struct type + vtable +
// method defines.
procedure TLLVMGenerator.EmitClassDecl(cd: TClassDecl);
var
  i, ci: Integer;
  fieldTypes: array of String;
  slots: array of String;
  m: TFunctionDecl;
  cflds: array of String;
begin
  if self.ClassEmitted(cd.Name) then Exit; // already emitted (multi-file dup)
  if self.ClassIndex(cd.Name) < 0 then self.MakeClassInfo(cd.Name, cd);
  self.MarkClassEmitted(cd.Name);
  // struct type: vtable ptr + fields
  ci := self.ClassIndex(cd.Name);
  // cflds: field types via ClassFieldCountAt (comma-string count, not Length).
  cflds := [];
  for i := 0 to self.ClassFieldCountAt(ci) - 1 do
    append(cflds, self.FieldTypeAt(ci,i));
  append(fieldTypes, 'ptr');
  for i := 0 to Length(cflds) - 1 do
    append(fieldTypes, cflds[i]);
  self.WriteLine('%' + cd.Name + ' = type { ' + self.JoinStr(fieldTypes, ', ') + ' }');
  // vtable constant (vtable-index order)
  slots := [];
  for i := 0 to self.MethodCount(ci) - 1 do
    append(slots, 'ptr @' + self.DefClassAt(ci, i) + '_' + self.MethodNameAt(ci, i));
  self.WriteLine('@' + cd.Name + '_vtable = constant [' + self.IntToStrS(self.MethodCount(ci)) + ' x ptr] [ ' + self.JoinStr(slots, ', ') + ' ]');
  // method defines (with bodies)
  for i := 0 to Length(cd.Methods) - 1 do
  begin
    m := cd.Methods[i];
    self.EmitMethod(cd.Name, m);
  end;
end;


// EmitRecordDecl — register a record type as a class with no methods (mirrors
// host emitRecordDecl). Records are heap-allocated like classes but have an
// empty vtable. EmitMember's GEP path then handles rec.Field.
procedure TLLVMGenerator.EmitRecordDecl(rname: String; rec: TRecordType);
var
  ci, i: Integer;
  fieldTypes: array of String;
  cflds: array of String;
  fld: TVarDecl;
  j, m: Integer;
  fslot: Integer;
  at: TArrayType;
  llvmT, kt, ekt: String;
begin
  if self.ClassEmitted(rname) then Exit;
  if self.ClassIndex(rname) < 0 then
  begin
    append(self.ClassNames, rname);
    append(self.ClassEmittedFlags, false);
    append(self.ClassParents, '');
    append(self.ClassFieldNames, '');
    append(self.ClassFieldTypes, '');
    append(self.ClassFieldKylix, '');
    append(self.ClassFieldElemKylix, '');
    append(self.ClassFieldMaps, '');
    append(self.ClassMethodNames, ',');
    append(self.ClassMethodRet, ',');
    append(self.ClassMethodDef, ',');
    append(self.ClassMethodIdx, ',');
  end;
  // v0.6.9 P3: field tables are filled OUTSIDE the ClassIndex guard — Pass 0
  // pre-registers the record name, so the old nesting left the tables empty
  // forever (TToken.TokenType chains all collapsed to unhandled stubs).
  for j := 0 to Length(rec.Fields) - 1 do
  begin
    fld := rec.Fields[j];
    llvmT := 'i64';
    kt := self.TypeExprName(fld.VarType);
    ekt := '';
    if fld.VarType is TArrayType then
    begin
      at := fld.VarType as TArrayType;
      if at.Dynamic then llvmT := '{ ptr, i64, i64 }'
      else llvmT := self.LlvmTypeOfExpr(fld.VarType);
      ekt := self.TypeExprName(at.ElementType);
    end
    else if fld.VarType is TMapType then llvmT := 'ptr'
    else if fld.VarType <> nil then llvmT := self.LlvmTypeOfExpr(fld.VarType);
    if llvmT = 'variant' then llvmT := 'ptr';
    for m := 0 to Length(fld.Names) - 1 do
    begin
      self.ClassFieldNames[self.ClassIndex(rname)] := self.ClassFieldNames[self.ClassIndex(rname)] + fld.Names[m] + ',';
      self.ClassFieldTypes[self.ClassIndex(rname)] := self.ClassFieldTypes[self.ClassIndex(rname)] + llvmT + ';';
      self.ClassFieldKylix[self.ClassIndex(rname)] := self.ClassFieldKylix[self.ClassIndex(rname)] + kt + ',';
      self.ClassFieldElemKylix[self.ClassIndex(rname)] := self.ClassFieldElemKylix[self.ClassIndex(rname)] + ekt + ',';
      self.ClassFieldMaps[self.ClassIndex(rname)] := self.ClassFieldMaps[self.ClassIndex(rname)] + '0,';
      // v0.6.9 P4: keep the flat registry in sync (field lookups scan it).
      // NB: compute the slot BEFORE appending — ClassFieldCountAt scans the
      // flat table, so counting after the FlCls append shifts every slot +1
      // (the `{ ptr, , double }` llc regression).
      fslot := self.ClassFieldCountAt(self.ClassIndex(rname));
      append(self.FlCls, self.ClassIndex(rname));
      append(self.FlSlot, fslot);
      append(self.FlName, fld.Names[m]);
      append(self.FlType, llvmT);
      append(self.FlKylix, kt);
      append(self.FlElem, ekt);
      append(self.FlMap, '0');
    end;
  end;
  self.MarkClassEmitted(rname);
  ci := self.ClassIndex(rname);
  cflds := [];
  for i := 0 to self.ClassFieldCountAt(ci) - 1 do
    append(cflds, self.FieldTypeAt(ci, i));
  fieldTypes := [];
  append(fieldTypes, 'ptr');
  for i := 0 to Length(cflds) - 1 do
    append(fieldTypes, cflds[i]);
  self.WriteLine('%' + rname + ' = type { ' + self.JoinStr(fieldTypes, ', ') + ' }');
  self.WriteLine('@' + rname + '_vtable = constant [0 x ptr] []');
end;

procedure TLLVMGenerator.EmitGlobalVarDecl(vd: TVarDecl);
var
  i: Integer;
  llvmT: String;
begin
  EProg('GVD n=' + self.IntToStrS(Length(vd.Names)));
  for i := 0 to Length(vd.Names) - 1 do
  begin
    llvmT := 'i64';
    if vd.VarType <> nil then llvmT := self.LlvmTypeOfExpr(vd.VarType);
    if llvmT = 'variant' then llvmT := 'ptr';
    self.WriteLine('@__kylix_g_' + vd.Names[i] + ' = global ' + llvmT + ' zeroinitializer');
    if vd.VarType is TMapType then self.NeedHashtab := true;
    append(self.GNames, vd.Names[i]);
    append(self.GTypes, llvmT);
    append(self.GKylixs, self.TypeExprName(vd.VarType));
    // v0.6.9 P3: main-program `var` is emitted as a global — register array
    // metadata too, so arr[i] / append(arr, x) resolve the storage slot.
    if vd.VarType is TArrayType then
      self.RegisterArrayFromType(vd.Names[i], vd.VarType);
    if vd.VarType is TMapType then
      append(self.GMapValueTypes, self.TypeExprName((vd.VarType as TMapType).ValueType))
    else
      append(self.GMapValueTypes, '');
  end;
  EProg('GLEN len=' + self.IntToStrS(Length(self.GNames)) + ' i=' + self.IntToStrS(i));
end;

// FuncParamTypes — comma-joined LLVM types of a function declaration's
// parameters ("i64,ptr"), for typing EmitPlainCall's call arguments.
// NOTE: takes TNode and always casts via `(decl as TFunctionDecl).member` —
// the bootstrap parser only accepts `as` casts followed by a member access.
// PreEmitAllocas — hoist explicitly-typed `var` declarations of a function
// body to the entry block (recursively through blocks/branches/loops). LLVM
// requires every alloca to dominate its uses; a `var` inside an `if` block
// with uses after the block fails verification. Inferred vars (`var x := …`)
// keep their in-place alloca (their type is only known after the initializer
// evaluates). RegisterLocal's dedup makes the later in-place declaration a
// no-op that reuses the hoisted slot.
procedure TLLVMGenerator.PreEmitAllocas(stmts: array of TStatement);
var
  i: Integer;
  st: TStatement;
  vd: TVarDecl;
  blk: TBlockStatement;
  ifst: TIfStatement;
  whst: TWhileStatement;
  forst: TForStatement;
  trst: TTryStatement;
  vname: String;
  vtyExp: TExpression;
  hasVType, notInferred: Boolean;
begin
  // v0.6.9 P4: every nested field read goes through a local FIRST. The direct
  // forms — (st as T).Field.Statements as a call argument, vd.Names[0] as an
  // argument, `and` compounds of member chains — hit the broken param-marshal
  // / compound-condition paths and blow the emit up (8GB garbage concats).
  for i := 0 to Length(stmts) - 1 do
  begin
    st := stmts[i];
    if st is TVarDecl then
    begin
      vd := st as TVarDecl;
      vname := vd.Names[0];
      vtyExp := vd.VarType;
      hasVType := vd.VarType <> nil;
      notInferred := vd.Inferred = false;
      if hasVType then
      begin
        if notInferred then
          self.EmitVarDeclSingle(vname, vtyExp);
      end;
    end
    else if st is TBlockStatement then
    begin
      blk := st as TBlockStatement;
      self.PreEmitAllocas(blk.Statements);
    end
    else if st is TIfStatement then
    begin
      ifst := st as TIfStatement;
      if ifst.Consequence <> nil then
      begin
        blk := ifst.Consequence as TBlockStatement;
        self.PreEmitAllocas(blk.Statements);
      end;
      if ifst.Alternative <> nil then
      begin
        blk := ifst.Alternative as TBlockStatement;
        self.PreEmitAllocas(blk.Statements);
      end;
    end
    else if st is TWhileStatement then
    begin
      whst := st as TWhileStatement;
      if whst.Body <> nil then
      begin
        blk := whst.Body as TBlockStatement;
        self.PreEmitAllocas(blk.Statements);
      end;
    end
    else if st is TForStatement then
    begin
      // v0.6.9 P3: hoist the loop variable's alloca too (EmitFor would
      // otherwise alloca it inside an enclosing branch block)
      forst := st as TForStatement;
      vname := forst.Variable;
      self.RegisterLocal(vname, 'i64', '');
      if forst.Body <> nil then
      begin
        blk := forst.Body as TBlockStatement;
        self.PreEmitAllocas(blk.Statements);
      end;
    end
    else if st is TTryStatement then
    begin
      trst := st as TTryStatement;
      if trst.Body <> nil then
      begin
        blk := trst.Body as TBlockStatement;
        self.PreEmitAllocas(blk.Statements);
      end;
      if trst.ExceptBlock <> nil then
      begin
        blk := trst.ExceptBlock as TBlockStatement;
        self.PreEmitAllocas(blk.Statements);
      end;
      if trst.FinallyBlock <> nil then
      begin
        blk := trst.FinallyBlock as TBlockStatement;
        self.PreEmitAllocas(blk.Statements);
      end;
    end;
  end;
end;

function TLLVMGenerator.FuncParamTypes(decl: TNode): String;
var
  i, k: Integer;
  s, ptt, out2: String;
  fd: TFunctionDecl;
  ptyExp: TExpression;
begin
  s := '';
  fd := decl as TFunctionDecl;
  for i := 0 to Length(fd.Parameters) - 1 do
  begin
    if i > 0 then s := s + ',';
    ptyExp := fd.Parameters[i].ParamType; // v0.6.9 P4: index-member via local
    ptt := self.LlvmTypeOfExpr(ptyExp);
    // v0.6.9 P4: escape ',' in '{ ptr, i64, i64 }' — the raw comma split the
    // comma-string and shifted every later parameter's type (fragments like
    // ' i64 }' / 'TExpression' then leaked into other calls' arg types).
    out2 := '';
    for k := 0 to Length(ptt) - 1 do
    begin
      if ptt[k:k+1] = ',' then out2 := out2 + '|'
      else out2 := out2 + ptt[k:k+1];
    end;
    s := s + out2;
  end;
  result := s;
end;

// DotIndex — position of the first '.' in s, or -1.
function TLLVMGenerator.DotIndex(s: String): Integer;
var i: Integer;
begin
  result := -1;
  for i := 0 to Length(s) - 1 do
  begin
    if s[i:i+1] = '.' then
    begin
      result := i;
      Exit;
    end;
  end;
end;

// DotToUnderscore — 'TLexer.PeekChar' → 'TLexer_PeekChar' ('' unchanged).
// FNames must store the underscore symbol so the ext-method call fallback
// (EmitMethodCallWithArgs) resolves it.
function TLLVMGenerator.DotToUnderscore(s: String): String;
var dp: Integer;
begin
  result := s;
  dp := self.DotIndex(s);
  if dp >= 0 then
    result := s[0:dp] + '_' + s[dp+1:Length(s)];
end;

procedure TLLVMGenerator.EmitFunctionDecl(fd: TFunctionDecl);
var
  i: Integer;
  retType, llvmT, allocaReg: String;
  pname: String;
  ptyExp: TExpression;
  lnode: TNode;
  vat: TArrayType;
  params: array of String;
  lvd: TVarDecl;
  blk: TBlockStatement;
  dotPos: Integer;
  extClass, extMethod, funcSymbol: String;
begin
  // v0.6.9 P3: external method definition `procedure ClassName.MethodName` —
  // the name contains a dot. Lower to @ClassName_MethodName with a leading
  // `ptr %self` parameter (mirrors host v0.5.4; most bootstrap TLexer/TParser/
  // TGenerator methods are written this way in the units).
  EProg('fn ' + fd.Name);
  extClass := '';
  extMethod := '';
  funcSymbol := fd.Name;
  dotPos := -1;
  if self.StrContains(fd.Name, '.') then
    dotPos := self.DotIndex(fd.Name);
  if dotPos >= 0 then
  begin
    extClass := fd.Name[0:dotPos];
    extMethod := fd.Name[dotPos+1:Length(fd.Name)];
    funcSymbol := extClass + '_' + extMethod;
  end;
  retType := 'void';
  if fd.ReturnType <> nil then retType := self.LlvmTypeOfExpr(fd.ReturnType);
  params := [];
  if extClass <> '' then
    append(params, 'ptr %self');
  for i := 0 to Length(fd.Parameters) - 1 do
  begin
    // v0.6.9 P4: funnel index-member reads (fd.Parameters[i].X) through
    // locals — as call arguments they hit the broken param-marshal path and
    // blow up the emit (8GB of garbage concats, see EmitFunctionDecl notes).
    pname := fd.Parameters[i].Name;
    ptyExp := fd.Parameters[i].ParamType;
    llvmT := 'i64';
    if ptyExp <> nil then llvmT := self.LlvmTypeOfExpr(ptyExp);
    append(params, llvmT + ' %' + pname);
  end;
  self.WriteLine('define ' + retType + ' @' + funcSymbol + '(' + self.JoinStr(params, ', ') + ') {');
  self.WriteLine('entry:');
  self.InFunc := true;
  self.InReturnFunc := retType <> 'void';
  self.ResultLLVMType := '';
  self.FuncExitLabel := self.Label();
  self.CurClassName := extClass;
  // fresh local scope
  self.LNames := [];
  self.LTypes := [];
  self.LRegs := [];
  self.LKylix := [];
  if extClass <> '' then
  begin
    append(self.LNames, 'self');
    append(self.LTypes, 'ptr');
    append(self.LRegs, '%self');
    append(self.LKylix, extClass);
  end;
  for i := 0 to Length(fd.Parameters) - 1 do
  begin
    // v0.6.9 P4: index-member reads through locals (see the params loop above
    // — direct `fd.Parameters[i].X` call args explode the param marshal).
    EProg('ploop2 i=' + self.IntToStrS(i));
    pname := fd.Parameters[i].Name;
    EProg('ploop2 name');
    ptyExp := fd.Parameters[i].ParamType;
    EProg('ploop2 pty');
    llvmT := 'i64';
    if ptyExp <> nil then llvmT := self.LlvmTypeOfExpr(ptyExp);
    EProg('ploop2 llvmT');
    allocaReg := self.RegisterLocal(pname, llvmT, self.TypeExprName(ptyExp));
    EProg('ploop2 reg');
    self.WriteLine('  store ' + llvmT + ' %' + pname + ', ptr ' + allocaReg);
    EProg('ploop2 store');
  end;
  if retType <> 'void' then
  begin
    self.WriteLine('  %result = alloca ' + retType + ', align 8');
    self.ResultLLVMType := retType;
    append(self.LNames, 'result');
    append(self.LTypes, retType);
    append(self.LRegs, '%result');
    append(self.LKylix, self.TypeExprName(fd.ReturnType));
    // v0.6.9 P4: record returns need a calloc'd record in the result slot
    self.EmitRecordResultInit(self.TypeExprName(fd.ReturnType));
  end;
  for i := 0 to Length(fd.LocalDecls) - 1 do
  begin
    // v0.6.9 P4: index-member is/as (fd.LocalDecls[i] is T) explodes the emit
    // (8GB of garbage concats) — funnel the element through a local first.
    lnode := fd.LocalDecls[i];
    if lnode is TVarDecl then
    begin
      lvd := lnode as TVarDecl;
      self.EmitVarDecl(lvd);
    end;
  end;
  if fd.Body <> nil then
  begin
    blk := fd.Body as TBlockStatement;
    // v0.6.9 P3: hoist explicitly-typed vars to the entry block first
    self.PreEmitAllocas(blk.Statements);
    self.EmitStatements(blk.Statements);
  end;
  self.EmitFuncEpilogue();
  self.WriteLine('}');
  self.WriteLine('');
  self.InFunc := false;
end;


// EmitMethod — define @ClassName_Method(ptr %self, ...params) { body }.
// Mirrors EmitFunctionDecl but prepends the self receiver and records
// CurClassName so self.Field / self.Method() resolve.
procedure TLLVMGenerator.EmitMethod(className: String; method: TFunctionDecl);
var
  i: Integer;
  retType, llvmT, allocaReg: String;
  pname: String;
  ptyExp: TExpression;
  lnode: TNode;
  vat: TArrayType;
  params: array of String;
  lvd: TVarDecl;
  blk: TBlockStatement;
begin
  EProg('fn ' + className + '.' + method.Name);
  retType := 'void';
  if method.ReturnType <> nil then retType := self.LlvmTypeOfExpr(method.ReturnType);
  params := [];
  append(params, 'ptr %self');
  for i := 0 to Length(method.Parameters) - 1 do
  begin
    // v0.6.9 P4: index-member reads through locals (param-marshal explosion)
    pname := method.Parameters[i].Name;
    ptyExp := method.Parameters[i].ParamType;
    llvmT := 'i64';
    if ptyExp <> nil then llvmT := self.LlvmTypeOfExpr(ptyExp);
    append(params, llvmT + ' %' + pname);
  end;
  self.WriteLine('define ' + retType + ' @' + className + '_' + method.Name + '(' + self.JoinStr(params, ', ') + ') {');
  self.WriteLine('entry:');
  self.InFunc := true;
  self.InReturnFunc := retType <> 'void';
  self.ResultLLVMType := '';
  self.FuncExitLabel := self.Label();
  self.CurClassName := className;
  // fresh local scope + self receiver
  self.LNames := [];
  self.LTypes := [];
  self.LRegs := [];
  self.LKylix := [];
  append(self.LNames, 'self');
  append(self.LTypes, 'ptr');
  append(self.LRegs, '%self');
  append(self.LKylix, className);
  for i := 0 to Length(method.Parameters) - 1 do
  begin
    pname := method.Parameters[i].Name;
    ptyExp := method.Parameters[i].ParamType;
    llvmT := 'i64';
    if ptyExp <> nil then llvmT := self.LlvmTypeOfExpr(ptyExp);
    allocaReg := self.RegisterLocal(pname, llvmT, self.TypeExprName(ptyExp));
    self.WriteLine('  store ' + llvmT + ' %' + pname + ', ptr ' + allocaReg);
    // v0.6.9 P4: array params need element info or `p[i]` reads collapse to
    // unhandled stubs inside the function body (EmitStatements' stmts etc).
    if ptyExp is TArrayType then
    begin
      vat := ptyExp as TArrayType;
      self.RegisterArray(pname, vat.Dynamic, self.LlvmTypeOfExpr(vat.ElementType), self.TypeExprName(vat.ElementType), 0, 0);
    end;
  end;
  if retType <> 'void' then
  begin
    self.WriteLine('  %result = alloca ' + retType + ', align 8');
    self.ResultLLVMType := retType;
    append(self.LNames, 'result');
    append(self.LTypes, retType);
    append(self.LRegs, '%result');
    append(self.LKylix, self.TypeExprName(method.ReturnType));
    self.EmitRecordResultInit(self.TypeExprName(method.ReturnType));
  end;
  for i := 0 to Length(method.LocalDecls) - 1 do
  begin
    // v0.6.9 P4: index-member is/as through a local (see EmitFunctionDecl)
    lnode := method.LocalDecls[i];
    if lnode is TVarDecl then
    begin
      lvd := lnode as TVarDecl;
      self.EmitVarDecl(lvd);
    end;
  end;
  if method.Body <> nil then
  begin
    blk := method.Body as TBlockStatement;
    self.EmitStatements(blk.Statements);
  end;
  self.EmitFuncEpilogue();
  self.WriteLine('}');
  self.WriteLine('');
  self.InFunc := false;
end;

procedure TLLVMGenerator.EmitFuncEpilogue;
begin
  // v0.6.9 P3: the result load must live INSIDE the exit block — `exit`
  // branches here directly, and a load in the fall-through path would not
  // dominate the ret on the exit path (LLVM verifier domination error).
  self.WriteLine('  br label %' + self.FuncExitLabel);
  self.WriteLine(self.FuncExitLabel + ':');
  if self.ResultLLVMType = '' then
    self.WriteLine('  ret void')
  else
  begin
    self.WriteLine('  %' + self.FuncExitLabel + '_res = load ' + self.ResultLLVMType + ', ptr %result');
    self.WriteLine('  ret ' + self.ResultLLVMType + ' %' + self.FuncExitLabel + '_res');
  end;
end;

procedure TLLVMGenerator.EmitEarlyReturn;
begin
  self.WriteLine('  br label %' + self.FuncExitLabel);
end;

// ============================================================================
// Statements
// ============================================================================

procedure TLLVMGenerator.EmitStatements(stmts: array of TStatement);
var i, n: Integer;
begin
  n := Length(stmts);
  for i := 0 to n - 1 do
  begin
    if n > 8 then
      EProg('stmt seq=' + self.IntToStrS(self.StmtSeq) + ' i=' + self.IntToStrS(i) + ' of=' + self.IntToStrS(n));
    self.EmitStatement(stmts[i]);
  end;
end;

procedure TLLVMGenerator.EmitStatement(stmt: TStatement);
var
  vd: TVarDecl;
  asgn: TAssignmentStatement;
  es: TExpressionStatement;
  ifSt: TIfStatement;
  wh: TWhileStatement;
  fo: TForStatement;
  fe: TForEachStatement;
  ret: TReturnStatement;
  blk: TBlockStatement;
begin
  self.EmitDepth := 0;
  if stmt is TVarDecl then
  begin
    EProg('kind var');
    vd := stmt as TVarDecl;
    self.EmitVarDecl(vd);
  end
  else if stmt is TAssignmentStatement then
  begin
    EProg('kind assign');
    asgn := stmt as TAssignmentStatement;
    self.EmitAssign(asgn);
  end
  else if stmt is TExpressionStatement then
  begin
    EProg('kind expr');
    es := stmt as TExpressionStatement;
    self.EmitExprStatement(es);
  end
  else if stmt is TIfStatement then
  begin
    EProg('kind if');
    ifSt := stmt as TIfStatement;
    self.EmitIf(ifSt);
  end
  else if stmt is TWhileStatement then
  begin
    EProg('kind while');
    wh := stmt as TWhileStatement;
    self.EmitWhile(wh);
  end
  else if stmt is TForStatement then
  begin
    EProg('kind for');
    fo := stmt as TForStatement;
    self.EmitFor(fo);
  end
  else if stmt is TForEachStatement then
  begin
    fe := stmt as TForEachStatement;
    self.EmitForEach(fe);
  end
  else if stmt is TReturnStatement then
  begin
    ret := stmt as TReturnStatement;
    self.EmitReturn(ret);
  end
  else if stmt is TBlockStatement then
  begin
    blk := stmt as TBlockStatement;
    self.EmitStatements(blk.Statements);
  end
  else if stmt is TBreakStatement then self.WriteLine('  br label %' + self.LoopBreak)
  else if stmt is TContinueStatement then self.WriteLine('  br label %' + self.LoopHead)
  else self.WriteLine('  ; unhandled statement');
end;

procedure TLLVMGenerator.EmitExprStatement(es: TExpressionStatement);
var
  ident: TIdentifier;
  member: TMemberExpression;
  call: TCallExpression;
  t: String;
begin
  if es.Expression is TIdentifier then
  begin
    ident := es.Expression as TIdentifier;
    if (ident.Value = 'Exit') or (ident.Value = 'exit') then
    begin
      self.EmitEarlyReturn();
      Exit;
    end;
  end;
  if es.Expression is TCallExpression then
  begin
    call := es.Expression as TCallExpression;
    if call.Func is TIdentifier then
    begin
      ident := call.Func as TIdentifier;
      if ident.Value = 'append' then
      begin
        self.EmitAppendStmt(call.Arguments[0], call.Arguments[1]);
        Exit;
      end;
    end;
  end;
  self.EmitExpr(es.Expression);
end;

procedure TLLVMGenerator.EmitVarDecl(vd: TVarDecl);
var
  i: Integer;
  valReg, llvmT, kylixT, allocaReg, fname: String;
begin
  self.WriteLine('  ; dbg varDecl names=' + self.IntToStrS(Length(vd.Names)) + ' inferred=' + self.BoolStr1(vd.Inferred));
  if Length(vd.Names) = 0 then Exit;
  if (vd.VarType = nil) and (vd.Value <> nil) and vd.Inferred then
  begin
    valReg := self.EmitExprTyped(vd.Value);
    llvmT := self.LastType;
    kylixT := '';
    if vd.Value is TMemberExpression then
    begin
      if (vd.Value as TMemberExpression).Member = 'Create' then
      begin
        if (vd.Value as TMemberExpression).Obj is TIdentifier then
          kylixT := ((vd.Value as TMemberExpression).Obj as TIdentifier).Value;
      end;
    end
    else if vd.Value is TCallExpression then
    begin
      if (vd.Value as TCallExpression).Func is TMemberExpression then
      begin
        if ((vd.Value as TCallExpression).Func as TMemberExpression).Member = 'Create' then
        begin
          if ((vd.Value as TCallExpression).Func as TMemberExpression).Obj is TIdentifier then
            kylixT := (((vd.Value as TCallExpression).Func as TMemberExpression).Obj as TIdentifier).Value;
        end;
        // v0.6.9 P3: datetime chain calls return a TDateTime handle
        if ((vd.Value as TCallExpression).Func as TMemberExpression).Member = 'AddDays' then
          kylixT := 'TDateTime';
      end;
      // v0.6.9 P3: stdlib factory calls infer their wrapper class so
      // now.Year() / c.Put(...) / h.Get(...) dispatch to the baked segments.
      if kylixT = '' then
      begin
        if (vd.Value as TCallExpression).Func is TIdentifier then
        begin
          fname := ((vd.Value as TCallExpression).Func as TIdentifier).Value;
          if ((fname = 'Now') or (fname = 'Today') or (fname = 'MakeDate')) or ((fname = 'MakeTime') or (fname = 'ParseDate') or (fname = 'ParseDateTime') or (fname = 'AddDays')) then
            kylixT := 'TDateTime'
          else if fname = 'NewCache' then
            kylixT := 'TCache'
          else if fname = 'NewHttpClient' then
            kylixT := 'THttpClient'
          else if (fname = 'DbQueryScalar') or (fname = 'DnsLookup') then
            kylixT := 'String';
        end;
      end;
    end;
    for i := 0 to Length(vd.Names) - 1 do
    begin
      allocaReg := self.RegisterLocal(vd.Names[i], llvmT, kylixT);
      if llvmT = 'variant' then
        self.WriteLine('  store ptr ' + valReg + ', ptr ' + allocaReg)
      else if llvmT = 'i1' then
        self.WriteLine('  store i1 ' + valReg + ', ptr ' + allocaReg)
      else
        self.WriteLine('  store ' + llvmT + ' ' + valReg + ', ptr ' + allocaReg);
    end;
    Exit;
  end;
  for i := 0 to Length(vd.Names) - 1 do
    self.EmitVarDeclSingle(vd.Names[i], vd.VarType);
  if (vd.Value <> nil) and (not vd.Inferred) then
    for i := 0 to Length(vd.Names) - 1 do
      self.AssignToName(vd.Names[i], vd.Value);
end;

procedure TLLVMGenerator.EmitVarDeclSingle(name: String; varType: TExpression);
var llvmT: String;
  vat: TArrayType;
  vtn: String;
  ista: Boolean;
begin
  vtn := self.TypeExprName(varType);
  if name = 'at' then
  begin
    ista := false;
    if varType is TArrayType then ista := true;
    EProg('VDS at vtn=' + vtn + ' ci=' + self.IntToStrS(self.ClassIndex(vtn)));
  end;
  llvmT := self.LlvmTypeOfExpr(varType);
  if name = 'at' then
    EProg('VDS at llvmT=' + llvmT);
  if varType is TArrayType then
  begin
    // v0.6.9 P4: at := ... locals must keep their Kylix class name (was ''),
    // or a following `at.Dynamic` / `at.ElementType` member read resolves no
    // receiver class → unhandled stub → `br i1 ptr` verifier error. Also
    // funnel the as-chain reads through the `at` local.
    vat := varType as TArrayType;
    if vat.Dynamic then
      llvmT := '{ ptr, i64, i64 }'
    else
      llvmT := '[1 x i64]';
    self.RegisterLocal(name, llvmT, self.TypeExprName(varType));
    self.RegisterArrayFromType(name, varType);
    Exit;
  end;
  if varType is TMapType then
  begin
    // map local: htab_new() slot. The map's value type is read from the
    // map's value type expression for read-coercion.
    self.RegisterMapLocal(name, self.TypeExprName((varType as TMapType).ValueType));
    Exit;
  end;
  if varType = nil then
  begin
    self.RegisterLocal(name, 'i64', '');
    Exit;
  end;
  llvmT := self.LlvmTypeOfExpr(varType);
  if self.IsClass(self.TypeExprName(varType)) then llvmT := 'ptr';
  // v0.6.9 P3: record local — heap-allocate the struct up front (host
  // stmt.go v0.5.4): records have no Create, so `tok.Line := x` must GEP
  // into valid memory immediately after declaration.
  if varType is TIdentifier then
  begin
    // NB: keep the guard nested — `and` compounds of is-checks + method
    // calls compile to `call @(i1)` (bootstrap codegen bug).
    if self.IsRecordType((varType as TIdentifier).Value) then
    begin
      self.RegisterLocal(name, 'ptr', self.TypeExprName(varType));
      self.EmitRecordStorageAlloc(name, self.TypeExprName(varType));
      Exit;
    end;
  end;
  self.RegisterLocal(name, llvmT, self.TypeExprName(varType));
end;

// EmitRecordStorageAlloc — calloc a zeroed record struct of cname's field
// sizes and store its address into local `name`'s ptr slot (host emitVarDecl
// v0.5.5). v0.6.9 P4: MUST be calloc — a plain malloc leaves record fields
// uninitialized; reading one (e.g. tok.Line before first assignment) yields a
// garbage pointer/garbage unterminated string, which then explodes strlen /
// concat downstream (the 0xbe-bebe SEGV in TParser_NextToken under ASAN).
procedure TLLVMGenerator.EmitRecordStorageAlloc(name: String; cname: String);
var
  ci, i: Integer;
  allocaReg, rec: String;
  size: Integer;
  ft: String;
begin
  ci := self.ClassIndex(cname);
  size := 8; // vtable ptr
  for i := 0 to self.ClassFieldCountAt(ci) - 1 do
  begin
    ft := self.FieldTypeAt(ci, i);
    size := size + self.LlvmTypeSize(ft);
  end;
  allocaReg := self.LocalReg(name);
  rec := self.Tmp();
  self.WriteLine('  ' + rec + ' = call ptr @calloc(i64 1, i64 ' + self.IntToStrS(size) + ')');
  self.WriteLine('  store ptr ' + rec + ', ptr ' + allocaReg);
end;

procedure TLLVMGenerator.AssignToName(name: String; value: TExpression);
var
  valReg, t, actualType, allocaReg, gname: String;
begin
  valReg := self.EmitExprTyped(value);
  t := self.LastType;
  actualType := self.ActualType(name);
  if t = 'variant' then t := 'ptr';
  if self.LastType = 'variant' then self.LastType := 'ptr';
  if actualType = 'variant' then actualType := 'ptr';
  if t <> actualType then valReg := self.CoerceValue(valReg, t, actualType);
  // global assignment: store to @__kylix_g_<name>
  if self.IndexOfStr(self.GNames, name) >= 0 then
  begin
    gname := self.GReg(name);
    self.WriteLine('  store ' + self.GType(name) + ' ' + valReg + ', ptr ' + gname);
    Exit;
  end;
  // map local assignment `m := otherMap`: same htab handle (map value semantics)
  // — the source is a ptr (from EmitExprTyped), so no coercion is needed.
  if self.IsLocalMap(name) then
  begin
    allocaReg := self.LocalReg(name);
    self.WriteLine('  store ptr ' + valReg + ', ptr ' + allocaReg);
    Exit;
  end;
  allocaReg := self.LocalReg(name);
  self.WriteLine('  store ' + actualType + ' ' + valReg + ', ptr ' + allocaReg);
end;

procedure TLLVMGenerator.EmitAssign(asgn: TAssignmentStatement);
var
  ident: TIdentifier;
  idx: TIndexExpression;
  fldMem: TMemberExpression;
  an: String;
  gi: Integer;
begin
  if asgn.Name is TIdentifier then
  begin
    ident := asgn.Name as TIdentifier;
    // v0.6.9 P4 DBG: print the GNames lookup result for every assignment
    an := ident.Value;
    gi := self.IndexOfStr(self.GNames, an);
    EProg('ASSIGN ' + an + ' gi=' + self.IntToStrS(gi));
    if gi < 0 then
      self.RegisterLocal(an, 'i64', '');
    self.AssignToName(an, asgn.Value);
    Exit;
  end;
  if asgn.Name is TIndexExpression then
  begin
    idx := asgn.Name as TIndexExpression;
    if self.TryMapIndexStore(idx, asgn.Value) then Exit;
    self.EmitArrayIndexStore(idx, asgn.Value);
    Exit;
  end;
  // object field assignment: self.Value := v / obj.Field := v
  if asgn.Name is TMemberExpression then
  begin
    fldMem := asgn.Name as TMemberExpression;
    self.EmitFieldAssign(fldMem, asgn.Value);
    Exit;
  end;
  self.WriteLine('  ; unhandled LHS');
end;

// EmitFieldAssign — obj.Field := value → GEP the field slot + store.
procedure TLLVMGenerator.EmitFieldAssign(member: TMemberExpression; value: TExpression);
var
  classT, selfReg, objReg, fieldT, valReg: String;
  ci, fi: Integer;
  gep: String;
begin
  classT := '';
  if member.Obj is TIdentifier then
  begin
    if (member.Obj as TIdentifier).Value = 'self' then
      classT := self.CurClassName
    else
      classT := self.LocalKylix((member.Obj as TIdentifier).Value);
    if classT = '' then classT := self.GKylix((member.Obj as TIdentifier).Value);
  end;
  if not self.IsClass(classT) then
  begin
    self.WriteLine('  ; unhandled member assignment ' + member.Member);
    Exit;
  end;
  // resolve obj ptr
  if member.Obj is TIdentifier then
  begin
    if (member.Obj as TIdentifier).Value = 'self' then
      selfReg := '%self'
    else
    begin
      if self.HasLocal((member.Obj as TIdentifier).Value) then
      begin
        objReg := self.LocalReg((member.Obj as TIdentifier).Value);
        selfReg := self.Tmp();
        self.WriteLine('  ' + selfReg + ' = load ptr, ptr ' + objReg);
      end
      else
      begin
        objReg := self.GReg((member.Obj as TIdentifier).Value);
        selfReg := self.Tmp();
        self.WriteLine('  ' + selfReg + ' = load ptr, ptr ' + objReg);
      end;
    end;
  end
  else
    selfReg := self.EmitExpr(member.Obj);
  ci := self.ClassIndex(classT);
  fi := self.FieldIndex(classT, member.Member);
  if fi < 0 then
  begin
    self.WriteLine('  ; field ' + member.Member + ' not found in ' + classT);
    Exit;
  end;
  fieldT := self.FieldTypeAt(ci, fi);
  valReg := self.EmitExprTyped(value);
  if fieldT = 'variant' then fieldT := 'ptr';
  if self.LastType = 'variant' then self.LastType := 'ptr';
  if self.LastType <> fieldT then valReg := self.CoerceValue(valReg, self.LastType, fieldT);
  gep := self.Tmp();
  self.WriteLine('  ' + gep + ' = getelementptr inbounds %' + classT + ', ptr ' + selfReg + ', i32 0, i32 ' + self.IntToStrS(fi + 1));
  self.WriteLine('  store ' + fieldT + ' ' + valReg + ', ptr ' + gep);
end;

procedure TLLVMGenerator.EmitArrayIndexStore(idx: TIndexExpression; value: TExpression);
var
  leftName: String;
  memL: TMemberExpression;
begin
  // arr[i] := v for a local/param/global array var — dispatch to the real
  // store emitter (v0.6.9 P3: was a P1 stub, dropped writes silently).
  if idx.Left is TIdentifier then
  begin
    leftName := (idx.Left as TIdentifier).Value;
    if self.IsArrayVar(leftName) then
    begin
      self.EmitArrayIndexStoreLocal(leftName, idx.Index, value);
      Exit;
    end;
  end;
  // v0.6.9 P4: class-field array store obj.Field[i] := v — the
  // FinalizeOutput pairwise merge needs `self.OutputChunks[w] := ...`.
  if idx.Left is TMemberExpression then
  begin
    memL := idx.Left as TMemberExpression;
    if self.EmitFieldArrayIndexStore(memL, idx.Index, value) then
      Exit;
  end;
  self.WriteLine('  ; array store (unhandled)');
end;

// EmitFieldArrayIndexStore — obj.Field[i] := value for a dynamic array-typed
// class field. Returns false when the receiver/field can't be resolved.
function TLLVMGenerator.EmitFieldArrayIndexStore(mem: TMemberExpression; idxExpr, valExpr: TExpression): Boolean;
var
  classT, selfReg, valReg, elemT: String;
  ci, fi: Integer;
  slot, sliceVal, dataPtr, idxReg, elemPtr: String;
begin
  result := false;
  classT := '';
  if mem.Obj is TIdentifier then
  begin
    if (mem.Obj as TIdentifier).Value = 'self' then
      classT := self.CurClassName
    else
      classT := self.LocalKylix((mem.Obj as TIdentifier).Value);
    if classT = '' then classT := self.GKylix((mem.Obj as TIdentifier).Value);
  end
  else
  begin
    selfReg := self.EmitExpr(mem.Obj);
    if self.IsClass(self.LastType) then classT := self.LastType;
  end;
  if self.IsClass(classT) = false then Exit;
  if mem.Obj is TIdentifier then
  begin
    if self.HasLocal((mem.Obj as TIdentifier).Value) then
      selfReg := self.LocalReg((mem.Obj as TIdentifier).Value)
    else
      selfReg := self.GReg((mem.Obj as TIdentifier).Value);
  end;
  ci := self.ClassIndex(classT);
  fi := self.FieldIndex(classT, mem.Member);
  if fi < 0 then Exit;
  elemT := self.FieldLLVM(classT, mem.Member);
  // v0.6.9 P4: only DYNAMIC slice fields take this path — static array
  // fields ([N x T], e.g. example21's TStack.Items) have their own store
  // handling; hijacking them broke example21.
  if elemT <> '{ ptr, i64, i64 }' then Exit;
  elemT := self.KylixTToLLVM(self.FieldElemKylixAt(classT, fi));
  // field slot holds an inline { ptr, i64, i64 } slice — load it, take the
  // data ptr, then GEP to the element slot.
  slot := self.Tmp();
  self.WriteLine('  ' + slot + ' = getelementptr inbounds %' + classT + ', ptr ' + selfReg + ', i32 0, i32 ' + self.IntToStrS(fi + 1));
  sliceVal := self.Tmp();
  self.WriteLine('  ' + sliceVal + ' = load { ptr, i64, i64 }, ptr ' + slot);
  dataPtr := self.Tmp();
  self.WriteLine('  ' + dataPtr + ' = extractvalue { ptr, i64, i64 } ' + sliceVal + ', 0');
  idxReg := self.EmitExprTyped(idxExpr);
  elemPtr := self.Tmp();
  self.WriteLine('  ' + elemPtr + ' = getelementptr inbounds ' + elemT + ', ptr ' + dataPtr + ', i64 ' + idxReg);
  valReg := self.EmitExprTyped(valExpr);
  if elemT = 'i1' then
  begin
    if self.LastType = 'i64' then valReg := self.CoerceValue(valReg, 'i64', 'i1');
  end
  else if elemT = 'i64' then
  begin
    if self.LastType = 'i1' then valReg := self.CoerceValue(valReg, 'i1', 'i64');
  end
  else if elemT = 'ptr' then
  begin
    if self.LastType = 'i64' then valReg := self.CoerceValue(valReg, 'i64', 'ptr');
  end;
  self.WriteLine('  store ' + elemT + ' ' + valReg + ', ptr ' + elemPtr);
  result := true;
end;

// TryMapIndexStore — m[key] := value for a map local/global OR obj.Field[key]
// := value for a map-typed class field. Returns true on success.
//   - Boolean value → zext i1→i64 then stringify (reads use presence)
//   - Integer/enum → IntToStr → ptr
//   - String → ptr directly
function TLLVMGenerator.TryMapIndexStore(idx: TIndexExpression; value: TExpression): Boolean;
var
  leftName, tbl: String;
  i, fi: Integer;
  classT, selfReg, objReg: String;
  mem: TMemberExpression;
  objE: TExpression;
begin
  result := false;
  if idx.Left is TIdentifier then
  begin
    leftName := (idx.Left as TIdentifier).Value;
    if self.IsLocalMap(leftName) then
    begin
      self.EmitMapIndexPut(leftName, self.MapValueType(leftName), idx.Index, value);
      result := true;
      Exit;
    end;
    if self.GMapValueType(leftName) <> '' then
    begin
      self.EmitMapIndexPut(leftName, self.GMapValueType(leftName), idx.Index, value);
      result := true;
      Exit;
    end;
    Exit;
  end;
  if idx.Left is TMemberExpression then
  begin
    mem := idx.Left as TMemberExpression;
    objE := mem.Obj;
    classT := '';
    if objE is TIdentifier then
    begin
      if (objE as TIdentifier).Value = 'self' then
        classT := self.CurClassName
      else
        classT := self.LocalKylix((objE as TIdentifier).Value);
      if classT = '' then classT := self.GKylix((objE as TIdentifier).Value);
    end;
    if not self.IsClass(classT) then Exit;
    i := self.ClassIndex(classT);
    fi := self.FieldIndex(classT, mem.Member);
    if fi < 0 then Exit;
    if not self.FieldMapAt(i, fi) then Exit;
    // resolve obj ptr
    if objE is TIdentifier then
    begin
      if (objE as TIdentifier).Value = 'self' then
        selfReg := '%self'
      else
      begin
        if self.HasLocal((objE as TIdentifier).Value) then
        begin
          objReg := self.LocalReg((objE as TIdentifier).Value);
          selfReg := self.Tmp();
          self.WriteLine('  ' + selfReg + ' = load ptr, ptr ' + objReg);
        end
        else
        begin
          objReg := self.GReg((objE as TIdentifier).Value);
          selfReg := self.Tmp();
          self.WriteLine('  ' + selfReg + ' = load ptr, ptr ' + objReg);
        end;
      end;
    end
    else
      selfReg := self.EmitExpr(objE);
    tbl := self.Tmp();
    self.WriteLine('  ' + tbl + ' = getelementptr inbounds %' + classT + ', ptr ' + selfReg + ', i32 0, i32 ' + self.IntToStrS(fi + 1));
    self.EmitMapIndexPutTable(tbl, self.FieldMapValueKylix(i, fi), idx.Index, value);
    result := true;
  end;
end;

// EmitMapIndexPut — m[key] := value for a map local/global (tbl loaded from
// the var slot). Value is coerced per the map's kylix value type.
procedure TLLVMGenerator.EmitMapIndexPut(name: String; valueKylix: String; keyExpr, value: TExpression);
var
  tbl: String;
begin
  tbl := self.Tmp();
  if self.HasLocal(name) then
    self.WriteLine('  ' + tbl + ' = load ptr, ptr ' + self.LocalReg(name))
  else
    self.WriteLine('  ' + tbl + ' = load ptr, ptr ' + self.GReg(name));
  self.EmitMapIndexPutTable(tbl, valueKylix, keyExpr, value);
end;

// EmitMapIndexPutTable — shared htab_put for map index stores (the table ptr
// is already resolved by the caller). Mirrors host emitMapFieldIndexPut /
// emitMapIndexPut value coercion.
procedure TLLVMGenerator.EmitMapIndexPutTable(tbl, valueKylix: String; keyExpr, value: TExpression);
var
  keyReg, valReg, vT, vPtr, z: String;
begin
  self.NeedHashtab := true;
  keyReg := self.EmitExpr(keyExpr);
  valReg := self.EmitExprTyped(value);
  vT := self.LastType;
  vPtr := valReg;
  if self.IsBooleanKylix(valueKylix) or (vT = 'i1') then
  begin
    // Boolean map value (or untyped-i1 RHS) → zext i1→i64 then stringify; the
    // stored content is irrelevant (reads use presence).
    z := self.Tmp();
    self.WriteLine('  ' + z + ' = zext i1 ' + valReg + ' to i64');
    vPtr := self.EmitIntToStrReg(z);
  end
  else if self.IsIntegerKylix(valueKylix) or (vT <> 'ptr') then
  begin
    // Integer/enum value → stringify on store.
    vPtr := self.EmitIntToStrReg(valReg);
  end;
  self.WriteLine('  call void @__kylix_htab_put(ptr ' + tbl + ', ptr ' + keyReg + ', ptr ' + vPtr + ')');
end;

// EmitIntToStrReg — inline IntToStr (snprintf "%ld" → ptr). Mirrors host
// emitIntToStrReg (used by map put when the value is an Integer).
function TLLVMGenerator.EmitIntToStrReg(valReg: String): String;
var
  buf, fmtPtr, count: String;
begin
  buf := self.Tmp();
  self.WriteLine('  ' + buf + ' = call ptr @malloc(i64 32)');
  fmtPtr := self.PtrTo(self.AddString('%ld'), 4);
  count := self.Tmp();
  self.WriteLine('  ' + count + ' = call i32 (ptr, i64, ptr, ...) @snprintf(ptr ' + buf + ', i64 32, ptr ' + fmtPtr + ', i64 ' + valReg + ')');
  result := buf;
end;

procedure TLLVMGenerator.EmitIf(stmt: TIfStatement);
var
  cond, thenLbl, elseLbl, endLbl: String;
  cond2: String;
  blk: TBlockStatement;
begin
  cond := self.EmitExpr(stmt.Condition);
  // v0.6.9 P4: Boolean locals are stored in i64 slots (zext on assign) — the
  // condition loads back as i64; coerce to i1 before `br i1`.
  if self.LastType = 'i64' then
  begin
    cond2 := self.Tmp();
    self.WriteLine('  ' + cond2 + ' = icmp ne i64 ' + cond + ', 0');
    cond := cond2;
  end;
  thenLbl := self.Label();
  elseLbl := self.Label();
  endLbl := self.Label();
  self.WriteLine('  br i1 ' + cond + ', label %' + thenLbl + ', label %' + elseLbl);
  self.WriteLine(thenLbl + ':');
  // v0.6.9 P4: stmt.Consequence.Statements as a call arg explodes the emit —
  // funnel through a block local.
  if stmt.Consequence <> nil then
  begin
    blk := stmt.Consequence as TBlockStatement;
    self.EmitStatements(blk.Statements);
  end;
  self.WriteLine('  br label %' + endLbl);
  self.WriteLine(elseLbl + ':');
  if stmt.Alternative <> nil then
  begin
    blk := stmt.Alternative as TBlockStatement;
    self.EmitStatements(blk.Statements);
  end;
  self.WriteLine('  br label %' + endLbl);
  self.WriteLine(endLbl + ':');
end;

procedure TLLVMGenerator.EmitWhile(stmt: TWhileStatement);
var
  headLbl, bodyLbl, endLbl, cond: String;
  cond2: String;
  savedHead, savedBreak: String;
  blk: TBlockStatement;
begin
  headLbl := self.Label();
  bodyLbl := self.Label();
  endLbl := self.Label();
  // v0.6.9 P3: save/restore instead of clearing — nested loops (a while
  // inside a while-true) used to wipe the outer LoopBreak, so an `else
  // break` after the inner loop emitted `br label %` (empty label).
  savedHead := self.LoopHead;
  savedBreak := self.LoopBreak;
  self.LoopHead := headLbl;
  self.LoopBreak := endLbl;
  self.WriteLine('  br label %' + headLbl);
  self.WriteLine(headLbl + ':');
  cond := self.EmitExpr(stmt.Condition);
  if self.LastType = 'i64' then
  begin
    cond2 := self.Tmp();
    self.WriteLine('  ' + cond2 + ' = icmp ne i64 ' + cond + ', 0');
    cond := cond2;
  end;
  self.WriteLine('  br i1 ' + cond + ', label %' + bodyLbl + ', label %' + endLbl);
  self.WriteLine(bodyLbl + ':');
  blk := stmt.Body as TBlockStatement;
  self.EmitStatements(blk.Statements);
  self.WriteLine('  br label %' + headLbl);
  self.WriteLine(endLbl + ':');
  self.LoopHead := savedHead;
  self.LoopBreak := savedBreak;
end;

procedure TLLVMGenerator.EmitFor(stmt: TForStatement);
var
  varReg, initVal, condVal, incReg, cmp: String;
  headLbl, bodyLbl, incLbl, endLbl: String;
  savedHead, savedBreak: String;
  loopVar: String;
  blk: TBlockStatement;
begin
  EProg('for: enter');
  loopVar := stmt.Variable;
  EProg('for: var');
  varReg := self.RegisterLocal(loopVar, 'i64', '');
  EProg('for: reg');
  initVal := self.EmitExpr(stmt.From);
  EProg('for: init');
  self.WriteLine('  store i64 ' + initVal + ', ptr ' + varReg);
  headLbl := self.Label();
  bodyLbl := self.Label();
  incLbl := self.Label();
  endLbl := self.Label();
  savedHead := self.LoopHead;
  savedBreak := self.LoopBreak;
  self.LoopHead := incLbl;
  self.LoopBreak := endLbl;
  self.WriteLine('  br label %' + headLbl);
  self.WriteLine(headLbl + ':');
  condVal := self.EmitIdentLoad(loopVar);
  cmp := self.Tmp();
  if stmt.DownTo then
  begin
    self.WriteLine('  ' + cmp + ' = icmp sge i64 ' + condVal + ', ' + self.EmitExpr(stmt.To));
    self.WriteLine('  br i1 ' + cmp + ', label %' + bodyLbl + ', label %' + endLbl);
  end
  else
  begin
    self.WriteLine('  ' + cmp + ' = icmp sle i64 ' + condVal + ', ' + self.EmitExpr(stmt.To));
    self.WriteLine('  br i1 ' + cmp + ', label %' + bodyLbl + ', label %' + endLbl);
  end;
  self.WriteLine(bodyLbl + ':');
  EProg('for: pre-body');
  blk := stmt.Body as TBlockStatement;
  self.EmitStatements(blk.Statements);
  EProg('for: post-body');
  self.WriteLine('  br label %' + incLbl);
  EProg('for: post-inc');
  self.WriteLine(incLbl + ':');
  incReg := self.Tmp();
  if stmt.DownTo then
    self.WriteLine('  ' + incReg + ' = add i64 ' + self.EmitIdentLoad(loopVar) + ', -1')
  else
    self.WriteLine('  ' + incReg + ' = add i64 ' + self.EmitIdentLoad(loopVar) + ', 1');
  self.WriteLine('  store i64 ' + incReg + ', ptr ' + varReg);
  self.WriteLine('  br label %' + headLbl);
  self.WriteLine(endLbl + ':');
  self.LoopHead := savedHead;
  self.LoopBreak := savedBreak;
end;

procedure TLLVMGenerator.EmitForEach(stmt: TForEachStatement);
begin
  self.WriteLine('  ; foreach (P1 stub)');
end;

procedure TLLVMGenerator.EmitReturn(stmt: TReturnStatement);
var
  valReg, llvmT: String;
begin
  if stmt.ReturnValue <> nil then
  begin
    if self.InReturnFunc then
    begin
      valReg := self.EmitExprTyped(stmt.ReturnValue);
      llvmT := self.LastType;
      if llvmT <> self.ResultLLVMType then valReg := self.CoerceValue(valReg, llvmT, self.ResultLLVMType);
      self.WriteLine('  store ' + self.ResultLLVMType + ' ' + valReg + ', ptr %result');
    end;
  end;
  self.EmitEarlyReturn();
end;

// ============================================================================
// Expressions
// ============================================================================

function TLLVMGenerator.EmitStringSliceExpr(e: TSliceExpression; t: String): String;
var
  base, baseT, low, high, length, allocSize, buf, src, termPtr: String;
begin
  self.LastType := 'ptr';
  base := self.EmitExprTyped(e.Left);
  baseT := self.LastType;
  if baseT <> 'ptr' then
  begin
    result := base;
    Exit;
  end;
  low := self.EmitExprTyped(e.Low);
  baseT := self.LastType;
  high := self.EmitExprTyped(e.High);
  baseT := self.LastType;
  length := self.Tmp();
  self.WriteLine('  ' + length + ' = sub i64 ' + high + ', ' + low);
  allocSize := self.Tmp();
  self.WriteLine('  ' + allocSize + ' = add i64 ' + length + ', 1');
  buf := self.Tmp();
  self.WriteLine('  ' + buf + ' = call ptr @malloc(i64 ' + allocSize + ')');
  src := self.Tmp();
  self.WriteLine('  ' + src + ' = getelementptr inbounds i8, ptr ' + base + ', i64 ' + low);
  self.NeedMemcpy := true;
  self.WriteLine('  call ptr @memcpy(ptr ' + buf + ', ptr ' + src + ', i64 ' + length + ')');
  termPtr := self.Tmp();
  self.WriteLine('  ' + termPtr + ' = getelementptr inbounds i8, ptr ' + buf + ', i64 ' + length);
  self.WriteLine('  store i8 0, ptr ' + termPtr);
  self.LastType := 'ptr';
  result := buf;
end;

function TLLVMGenerator.EmitExprTyped(node: TExpression): String;
var
  r, strReg, t: String;
  ilit: TIntegerLiteral;
  blit: TBooleanLiteral;
  slit: TStringLiteral;
  id: TIdentifier;
  inf: TInfixExpression;
  call: TCallExpression;
  mem: TMemberExpression;
  idx: TIndexExpression;
  ise: TIsExpression;
  tc: TTypeCastExpression;
  pe: TPrefixExpression;
  flit: TFloatLiteral;
  slic: TSliceExpression;
  arr: TArrayLiteral;
  i, n: Integer;
  buf, lenPtr, ep, v, v2, pt2, sliceVal, sliceVal2, sliceVal3: String;
begin
  if node is TIntegerLiteral then
  begin
    ilit := node as TIntegerLiteral;
    self.LastType := 'i64';
    result := self.EmitIntConst(ilit.Value);
  end
  else if node is TBooleanLiteral then
  begin
    blit := node as TBooleanLiteral;
    self.LastType := 'i1';
    result := self.EmitBoolConst(blit.Value);
  end
  else if node is TStringLiteral then
  begin
    slit := node as TStringLiteral;
    self.LastType := 'ptr';
    strReg := self.AddString(slit.Value);
    result := self.PtrTo(strReg, Length(slit.Value) + 1);
  end
  else if node is TFloatLiteral then
  begin
    // v0.6.9 P3: float literals collapsed to an unhandled-expr stub before —
    // the bootstrap's first float-bearing program hit it. The raw source text
    // (Token.Literal) is the most faithful IR literal; LLVM requires a
    // decimal point, so normalize like the host's llvmFloatLit.
    flit := node as TFloatLiteral;
    self.LastType := 'double';
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = fadd double 0.0, ' + self.LlvmFloatLit(flit.Token.Literal));
    result := r;
  end
  else if node is TNilLiteral then
  begin
    self.LastType := 'ptr';
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = inttoptr i64 0 to ptr');
    result := r;
  end
  else if node is TIdentifier then
  begin
    id := node as TIdentifier;
    self.LastType := self.ActualType(id.Value);
    if (self.LastType = '') and (self.IsArrayVar(id.Value)) then self.LastType := '{ ptr, i64, i64 }';
    result := self.EmitIdentLoad(id.Value);
  end
  else if node is TInfixExpression then
  begin
    inf := node as TInfixExpression;
    result := self.EmitInfix(inf, t);
  end
  else if node is TCallExpression then
  begin
    call := node as TCallExpression;
    result := self.EmitCall(call, t);
    self.LastType := self.LastType;
  end
  else if node is TMemberExpression then
  begin
    mem := node as TMemberExpression;
    result := self.EmitMember(mem, t);
    // v0.6.9 P3: EmitMember sets LastType itself (class name for chained
    // member chains, LLVM type otherwise) — do NOT overwrite with MemberType
    // here (that erased the class name and broke a.b.C chains).
  end
  else if node is TIndexExpression then
  begin
    idx := node as TIndexExpression;
    result := self.EmitArrayIndex(idx, t);
  end
  else if node is TSliceExpression then
  begin
    slic := node as TSliceExpression;
    r := self.EmitStringSliceExpr(slic, t);
    result := r;
  end
  else if node is TIsExpression then
  begin
    ise := node as TIsExpression;
    result := self.EmitIsExpr(ise, t);
  end
  else if node is TTypeCastExpression then
  begin
    tc := node as TTypeCastExpression;
    result := self.EmitAsExpr(tc, t);
  end
  else if node is TPrefixExpression then
  begin
    // v0.6.9 P3: `not X` / unary minus (mirrors host emitPrefix). Tutorials
    // write `if not IsEmail(...)` — without this the condition collapsed to
    // an unhandled-expr stub.
    pe := node as TPrefixExpression;
    v2 := self.EmitExprTyped(pe.Right);
    pt2 := self.LastType;
    r := self.Tmp();
    if pe.Operator = 'not' then
    begin
      self.WriteLine('  ' + r + ' = xor i1 ' + v2 + ', 1');
      self.LastType := 'i1';
      result := r;
    end
    else if pe.Operator = '-' then
    begin
      if pt2 = 'double' then
        self.WriteLine('  ' + r + ' = fneg double ' + v2)
      else
        self.WriteLine('  ' + r + ' = sub i64 0, ' + v2);
      self.LastType := pt2;
      result := r;
    end
    else
      result := v2;
  end
  else if node is TArrayLiteral then
  begin
    // P3: array literal → {ptr,len,cap} slice struct value (SSA, via
    // insertvalue — not an alloca ptr). Mirrors host expr.go ArrayLiteral
    // (v0.5.4): malloc 8*(n+1), slot 0 stores len, elements at slots 1..n,
    // then three insertvalue ops build the slice struct. Empty [] → n=0.
    arr := node as TArrayLiteral;
    n := Length(arr.Elements);
    self.LastType := '{ ptr, i64, i64 }';
    buf := self.Tmp();
    self.WriteLine('  ' + buf + ' = call ptr @malloc(i64 ' + self.IntToStrS(8 * (n + 1)) + ')');
    lenPtr := self.Tmp();
    self.WriteLine('  ' + lenPtr + ' = getelementptr inbounds i64, ptr ' + buf + ', i64 0');
    self.WriteLine('  store i64 ' + self.IntToStrS(n) + ', ptr ' + lenPtr);
    for i := 0 to n - 1 do
    begin
      v := self.EmitExprTyped(arr.Elements[i]);
      ep := self.Tmp();
      self.WriteLine('  ' + ep + ' = getelementptr inbounds i64, ptr ' + buf + ', i64 ' + self.IntToStrS(i + 1));
      self.WriteLine('  store i64 ' + v + ', ptr ' + ep);
    end;
    sliceVal := self.Tmp();
    self.WriteLine('  ' + sliceVal + ' = insertvalue { ptr, i64, i64 } undef, ptr ' + buf + ', 0');
    sliceVal2 := self.Tmp();
    self.WriteLine('  ' + sliceVal2 + ' = insertvalue { ptr, i64, i64 } ' + sliceVal + ', i64 ' + self.IntToStrS(n) + ', 1');
    sliceVal3 := self.Tmp();
    self.WriteLine('  ' + sliceVal3 + ' = insertvalue { ptr, i64, i64 } ' + sliceVal2 + ', i64 ' + self.IntToStrS(n) + ', 2');
    result := sliceVal3;
  end
  else
  begin
    self.LastType := 'i64';
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = add i64 0, 0 ; unhandled expr');
    result := r;
  end;
end;

function TLLVMGenerator.EmitExpr(node: TExpression): String;
var t: String;
begin
  result := self.EmitExprTyped(node);
end;

function TLLVMGenerator.EmitIntConst(v: Integer): String;
var r: String;
begin
  r := self.Tmp();
  self.WriteLine('  ' + r + ' = add i64 0, ' + self.IntToStrS(v));
  result := r;
end;

function TLLVMGenerator.EmitBoolConst(b: Boolean): String;
var r: String;
begin
  r := self.Tmp();
  if b then self.WriteLine('  ' + r + ' = add i1 0, 1')
  else self.WriteLine('  ' + r + ' = add i1 0, 0');
  result := r;
end;

// ============================================================================
// Infix
// ============================================================================

// LlvmFloatLit — normalize a source float literal for IR: LLVM requires a
// decimal point, so "3" → "3.0" and "1e+20" → "1.0e+20" (mirrors the host's
// llvmFloatLit).
function TLLVMGenerator.LlvmFloatLit(s: String): String;
var
  i, epos: Integer;
  hasDot, hasExp: Boolean;
begin
  hasDot := false;
  hasExp := false;
  epos := 0;
  for i := 0 to Length(s) - 1 do
  begin
    if s[i:i+1] = '.' then hasDot := true;
    if (s[i:i+1] = 'e') or (s[i:i+1] = 'E') then
    begin
      hasExp := true;
      if epos = 0 then epos := i;
    end;
  end;
  if hasDot then
  begin
    result := s;
    Exit;
  end;
  if hasExp then
  begin
    result := s[0:epos] + '.0' + s[epos:Length(s)];
    Exit;
  end;
  result := s + '.0';
end;

// IsVariantExpr — does this expression evaluate to a Variant box? Identifiers
// typed Variant (local or main-program global) and elements of Variant arrays
// (arr[i] on `array of Variant`) — the two forms the tutorials compare.
function TLLVMGenerator.IsVariantExpr(e: TExpression): Boolean;
var
  nm: String;
  ai: Integer;
begin
  result := false;
  if e = nil then Exit;
  if e is TIdentifier then
  begin
    nm := self.LocalKylix((e as TIdentifier).Value);
    if nm = '' then nm := self.GKylix((e as TIdentifier).Value);
    result := nm = 'Variant';
    Exit;
  end;
  if e is TIndexExpression then
  begin
    if (e as TIndexExpression).Left is TIdentifier then
    begin
      nm := ((e as TIndexExpression).Left as TIdentifier).Value;
      if self.IsArrayVar(nm) then
      begin
        ai := self.ArrInfoOf(nm);
        result := self.ArrElemKylix[ai] = 'Variant';
        Exit;
      end;
      // v0.6.9 P3: map[String] Variant indexing (m['pi']) reads back a box
      if self.IsLocalMap(nm) then
      begin
        if self.MapValueType(nm) = 'Variant' then
        begin
          result := true;
          Exit;
        end;
      end
      else if self.GMapValueType(nm) = 'Variant' then
      begin
        result := true;
        Exit;
      end;
    end;
    Exit;
  end;
end;

// BoxScalar — box a non-Variant scalar into a Variant box (host emitVariantBox
// without the null-phi: tutorials box plain values).
function TLLVMGenerator.BoxScalar(v: String; llvmT: String): String;
var helper, r, z: String;
begin
  helper := '@__kylix_variant_box_int';
  z := v;
  if llvmT = 'double' then helper := '@__kylix_variant_box_float'
  else if llvmT = 'ptr' then helper := '@__kylix_variant_box_str'
  else if llvmT = 'i1' then helper := '@__kylix_variant_box_bool'
  else
  begin
    z := self.CoerceValue(v, llvmT, 'i64');
    helper := '@__kylix_variant_box_int';
  end;
  r := self.Tmp();
  self.WriteLine('  ' + r + ' = call ptr ' + helper + '(' + llvmT + ' ' + z + ')');
  result := r;
end;

// IntToStrIR — stringify an i64 register (malloc 32 + snprintf %lld), for
// `str + int` concat. Returns the string ptr.
function TLLVMGenerator.IntToStrIR(v: String): String;
var
  buf, fmtPtr: String;
begin
  buf := self.Tmp();
  self.WriteLine('  ' + buf + ' = call ptr @malloc(i64 32)');
  fmtPtr := self.PtrTo(self.AddString('%lld'), 5);
  self.WriteLine('  call i32 (ptr, i64, ptr, ...) @snprintf(ptr ' + buf + ', i64 32, ptr ' + fmtPtr + ', i64 ' + v + ')');
  result := buf;
end;

function TLLVMGenerator.EmitInfix(e: TInfixExpression; t: String): String;
var
  lv, rv, lt, rt, r: String;
  lv2, rv2: String;
  cmpReg, arithName: String;
begin
  lv := self.EmitExprTyped(e.Left);
  lt := self.LastType;
  rv := self.EmitExprTyped(e.Right);
  rt := self.LastType;
  self.WriteLine('  ; dbg infix op=' + e.Operator + ' lt=' + lt + ' rt=' + rt);
  // v0.6.9 P3: class/record-typed operands compare as pointers (mirrors the
  // host's classes[lt] normalization) — `self.CurToken = before` on TToken.
  if self.IsClass(lt) then lt := 'ptr';
  if self.IsClass(rt) then rt := 'ptr';
  // v0.6.9 P4: mixed i64/i1 comparisons — Boolean array elements load as i64
  // (8-byte slots) but the literal side is i1; widen the i1 side to i64.
  if lt = 'i64' then
  begin
    if rt = 'i1' then
    begin
      rv2 := self.Tmp();
      self.WriteLine('  ' + rv2 + ' = zext i1 ' + rv + ' to i64');
      rv := rv2;
      rt := 'i64';
    end;
  end;
  if rt = 'i64' then
  begin
    if lt = 'i1' then
    begin
      lv2 := self.Tmp();
      self.WriteLine('  ' + lv2 + ' = zext i1 ' + lv + ' to i64');
      lv := lv2;
      lt := 'i64';
    end;
  end;
  // v0.6.9 P3: Variant comparisons/arithmetic — box the scalar side and
  // dispatch to the runtime (host emitVariantCompare / emitVariantArith).
  // Must run BEFORE the ptr-concat/strcmp paths (a box is a ptr).
  if self.IsVariantExpr(e.Left) or self.IsVariantExpr(e.Right) then
  begin
    if self.IsVariantExpr(e.Left) = false then lv := self.BoxScalar(lv, lt);
    if self.IsVariantExpr(e.Right) = false then rv := self.BoxScalar(rv, rt);
    r := self.Tmp();
    if (e.Operator = '=') or (e.Operator = '<>') or (e.Operator = '<') or (e.Operator = '<=') or (e.Operator = '>') or (e.Operator = '>=') then
    begin
      cmpReg := self.Tmp();
      self.WriteLine('  ' + cmpReg + ' = call i32 @__kylix_variant_compare(ptr ' + lv + ', ptr ' + rv + ')');
      if e.Operator = '=' then self.WriteLine('  ' + r + ' = icmp eq i32 ' + cmpReg + ', 0')
      else if e.Operator = '<>' then self.WriteLine('  ' + r + ' = icmp ne i32 ' + cmpReg + ', 0')
      else if e.Operator = '<' then self.WriteLine('  ' + r + ' = icmp slt i32 ' + cmpReg + ', 0')
      else if e.Operator = '<=' then self.WriteLine('  ' + r + ' = icmp sle i32 ' + cmpReg + ', 0')
      else if e.Operator = '>' then self.WriteLine('  ' + r + ' = icmp sgt i32 ' + cmpReg + ', 0')
      else self.WriteLine('  ' + r + ' = icmp sge i32 ' + cmpReg + ', 0');
      self.LastType := 'i1';
      result := r;
      Exit;
    end;
    if (e.Operator = '+') or (e.Operator = '-') or (e.Operator = '*') or (e.Operator = '/') or (e.Operator = 'div') or (e.Operator = 'mod') then
    begin
      arithName := 'add';
      if e.Operator = '-' then arithName := 'sub'
      else if e.Operator = '*' then arithName := 'mul'
      else if e.Operator = '/' then arithName := 'div'
      else if e.Operator = 'div' then arithName := 'idiv'
      else if e.Operator = 'mod' then arithName := 'mod';
      self.WriteLine('  ' + r + ' = call ptr @__kylix_variant_' + arithName + '(ptr ' + lv + ', ptr ' + rv + ')');
      self.LastType := 'ptr';
      result := r;
      Exit;
    end;
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = add i64 0, 0 ; variant op unsupported');
    self.LastType := 'i64';
    result := r;
    Exit;
  end;
  // string concat: `+` on two ptr
  if (e.Operator = '+') and (lt = 'ptr') and (rt = 'ptr') then
  begin
    self.LastType := 'ptr';
    result := self.EmitStringConcat(lv, rv);
    Exit;
  end;
  // v0.6.9 P3: `str + Integer` — stringify the int side (snprintf %lld) then
  // concat (host coerces non-ptr concat operands the same way).
  if (e.Operator = '+') and ((lt = 'ptr') and (rt = 'i64')) then
  begin
    rv := self.IntToStrIR(rv);
    rt := 'ptr';
    self.LastType := 'ptr';
    result := self.EmitStringConcat(lv, rv);
    Exit;
  end;
  if (e.Operator = '+') and ((lt = 'i64') and (rt = 'ptr')) then
  begin
    lv := self.IntToStrIR(lv);
    lt := 'ptr';
    self.LastType := 'ptr';
    result := self.EmitStringConcat(lv, rv);
    Exit;
  end;
  // coerce mixed int/double
  if lt <> rt then
  begin
    if (lt = 'double') and (rt = 'i64') then begin rv := self.CoerceValue(rv, 'i64', 'double'); rt := 'double'; end
    else if (lt = 'i64') and (rt = 'double') then begin lv := self.CoerceValue(lv, 'i64', 'double'); lt := 'double'; end;
  end;
  // string comparison (only when both are strings, not nil)
  if (e.Operator = '=') or (e.Operator = '<>') or (e.Operator = '<') or (e.Operator = '<=') or (e.Operator = '>') or (e.Operator = '>=') then
  begin
    // v0.6.9 P3: handle-vs-nil (i64 vs ptr) — coerce the ptr side to i64
    if (lt = 'i64') and (rt = 'ptr') then
    begin
      rv := self.CoerceValue(rv, 'ptr', 'i64');
      rt := 'i64';
    end
    else if (lt = 'ptr') and (rt = 'i64') then
    begin
      lv := self.CoerceValue(lv, 'ptr', 'i64');
      lt := 'i64';
    end;
    if (lt = 'ptr') and (rt = 'ptr') then
    begin
      if (self.IsNilNode(e.Left) = false) and (self.IsNilNode(e.Right) = false) then
      begin
        self.LastType := 'i1';
        result := self.EmitStringCompare(e.Operator, lv, rv);
        Exit;
      end;
    end;
  end;
  r := self.Tmp();
  if e.Operator = '+' then
  begin
    if lt = 'double' then self.WriteLine('  ' + r + ' = fadd double ' + lv + ', ' + rv)
    else self.WriteLine('  ' + r + ' = add i64 ' + lv + ', ' + rv);
    self.LastType := lt;
  end
  else if e.Operator = '-' then
  begin
    if lt = 'double' then self.WriteLine('  ' + r + ' = fsub double ' + lv + ', ' + rv)
    else self.WriteLine('  ' + r + ' = sub i64 ' + lv + ', ' + rv);
    self.LastType := lt;
  end
  else if e.Operator = '*' then
  begin
    if lt = 'double' then self.WriteLine('  ' + r + ' = fmul double ' + lv + ', ' + rv)
    else self.WriteLine('  ' + r + ' = mul i64 ' + lv + ', ' + rv);
    self.LastType := lt;
  end
  else if (e.Operator = '/') or (e.Operator = 'div') then
  begin
    if lt = 'double' then self.WriteLine('  ' + r + ' = fdiv double ' + lv + ', ' + rv)
    else self.WriteLine('  ' + r + ' = sdiv i64 ' + lv + ', ' + rv);
    self.LastType := lt;
  end
  else if e.Operator = 'mod' then
  begin
    self.WriteLine('  ' + r + ' = srem i64 ' + lv + ', ' + rv);
    self.LastType := 'i64';
  end
  else if e.Operator = '=' then
  begin
    if lt = 'double' then self.WriteLine('  ' + r + ' = fcmp oeq double ' + lv + ', ' + rv)
    else if (lt = 'i1') or (rt = 'i1') then self.WriteLine('  ' + r + ' = icmp eq i1 ' + lv + ', ' + rv)
    else if (lt = 'ptr') and (rt = 'ptr') then self.WriteLine('  ' + r + ' = icmp eq ptr ' + lv + ', ' + rv)
    else self.WriteLine('  ' + r + ' = icmp eq i64 ' + lv + ', ' + rv);
    self.LastType := 'i1';
  end
  else if e.Operator = '<>' then
  begin
    if lt = 'double' then self.WriteLine('  ' + r + ' = fcmp one double ' + lv + ', ' + rv)
    else if (lt = 'i1') or (rt = 'i1') then self.WriteLine('  ' + r + ' = icmp ne i1 ' + lv + ', ' + rv)
    else if (lt = 'ptr') and (rt = 'ptr') then self.WriteLine('  ' + r + ' = icmp ne ptr ' + lv + ', ' + rv)
    else self.WriteLine('  ' + r + ' = icmp ne i64 ' + lv + ', ' + rv);
    self.LastType := 'i1';
  end
  else if e.Operator = '<' then
  begin
    if lt = 'double' then self.WriteLine('  ' + r + ' = fcmp olt double ' + lv + ', ' + rv)
    else self.WriteLine('  ' + r + ' = icmp slt i64 ' + lv + ', ' + rv);
    self.LastType := 'i1';
  end
  else if e.Operator = '<=' then
  begin
    if lt = 'double' then self.WriteLine('  ' + r + ' = fcmp ole double ' + lv + ', ' + rv)
    else self.WriteLine('  ' + r + ' = icmp sle i64 ' + lv + ', ' + rv);
    self.LastType := 'i1';
  end
  else if e.Operator = '>' then
  begin
    if lt = 'double' then self.WriteLine('  ' + r + ' = fcmp ogt double ' + lv + ', ' + rv)
    else self.WriteLine('  ' + r + ' = icmp sgt i64 ' + lv + ', ' + rv);
    self.LastType := 'i1';
  end
  else if e.Operator = '>=' then
  begin
    if lt = 'double' then self.WriteLine('  ' + r + ' = fcmp oge double ' + lv + ', ' + rv)
    else self.WriteLine('  ' + r + ' = icmp sge i64 ' + lv + ', ' + rv);
    self.LastType := 'i1';
  end
  else if e.Operator = 'and' then
  begin
    self.WriteLine('  ' + r + ' = and i1 ' + lv + ', ' + rv);
    self.LastType := 'i1';
  end
  else if e.Operator = 'or' then
  begin
    self.WriteLine('  ' + r + ' = or i1 ' + lv + ', ' + rv);
    self.LastType := 'i1';
  end
  else
  begin
    self.WriteLine('  ' + r + ' = add i64 ' + lv + ', 0 ; unhandled op ' + e.Operator);
    self.LastType := lt;
  end;
  result := r;
end;

function TLLVMGenerator.EmitStringConcat(lv, rv: String): String;
var
  lenL, lenR, size, size1, buf: String;
begin
  lv := self.NullGuardString(lv);
  rv := self.NullGuardString(rv);
  lenL := self.Tmp();
  self.WriteLine('  ' + lenL + ' = call i64 @strlen(ptr noundef ' + lv + ')');
  lenR := self.Tmp();
  self.WriteLine('  ' + lenR + ' = call i64 @strlen(ptr noundef ' + rv + ')');
  size := self.Tmp();
  self.WriteLine('  ' + size + ' = add i64 ' + lenL + ', ' + lenR);
  size1 := self.Tmp();
  self.WriteLine('  ' + size1 + ' = add i64 ' + size + ', 1');
  buf := self.Tmp();
  self.WriteLine('  ' + buf + ' = call ptr @malloc(i64 ' + size1 + ')');
  self.WriteLine('  call ptr @strcpy(ptr ' + buf + ', ptr ' + lv + ')');
  self.WriteLine('  call ptr @strcat(ptr ' + buf + ', ptr ' + rv + ')');
  result := buf;
end;

function TLLVMGenerator.EmitStringCompare(op, lv, rv: String): String;
var
  cmp, r: String;
begin
  lv := self.NullGuardString(lv);
  rv := self.NullGuardString(rv);
  cmp := self.Tmp();
  self.WriteLine('  ' + cmp + ' = call i32 @strcmp(ptr ' + lv + ', ptr ' + rv + ')');
  r := self.Tmp();
  if op = '=' then self.WriteLine('  ' + r + ' = icmp eq i32 ' + cmp + ', 0')
  else if op = '<>' then self.WriteLine('  ' + r + ' = icmp ne i32 ' + cmp + ', 0')
  else if op = '<' then self.WriteLine('  ' + r + ' = icmp slt i32 ' + cmp + ', 0')
  else if op = '<=' then self.WriteLine('  ' + r + ' = icmp sle i32 ' + cmp + ', 0')
  else if op = '>' then self.WriteLine('  ' + r + ' = icmp sgt i32 ' + cmp + ', 0')
  else self.WriteLine('  ' + r + ' = icmp sge i32 ' + cmp + ', 0');
  result := r;
end;

function TLLVMGenerator.NullGuardString(v: String): String;
var
  isNull, r: String;
begin
  isNull := self.Tmp();
  self.WriteLine('  ' + isNull + ' = icmp eq ptr ' + v + ', null');
  r := self.Tmp();
  self.WriteLine('  ' + r + ' = select i1 ' + isNull + ', ptr @__kylix_emptystr, ptr ' + v);
  result := r;
end;

// IsRecordType — is name a `= record` type (Pass 0 registered)?
function TLLVMGenerator.IsRecordType(name: String): Boolean;
begin
  result := self.IndexOfStr(self.RecordNames, name) >= 0;
end;

// LlvmTypeSize — byte size of an LLVM scalar type (record malloc sizing;
// mirrors host llvmTypeSize).
function TLLVMGenerator.LlvmTypeSize(llvmT: String): Integer;
begin
  if llvmT = '{ ptr, i64, i64 }' then result := 24
  else if llvmT = 'double' then result := 8
  else result := 8;
end;

// IsBoxTypeName — class/record/variant pseudo-names are all ptr-typed, so
// ClassName↔ptr coercions are identity moves.
function TLLVMGenerator.IsBoxTypeName(t: String): Boolean;
begin
  result := (t = 'ptr') or (t = 'variant');
  if result = false then result := self.IsClass(t);
end;

function TLLVMGenerator.CoerceValue(v, fromT, toT: String): String;
var r: String;
begin
  if fromT = toT then
  begin
    result := v;
    Exit;
  end;
  // v0.6.9 P3: ClassName↔ptr (records/classes are heap pointers) — identity
  if self.IsBoxTypeName(fromT) then
  begin
    if self.IsBoxTypeName(toT) then
    begin
      result := v;
      Exit;
    end;
  end;
  r := self.Tmp();
  if (fromT = 'i64') and (toT = 'double') then
    self.WriteLine('  ' + r + ' = sitofp i64 ' + v + ' to double')
  else if (fromT = 'double') and (toT = 'i64') then
    self.WriteLine('  ' + r + ' = fptosi double ' + v + ' to i64')
  else if (fromT = 'i1') and (toT = 'i64') then
    self.WriteLine('  ' + r + ' = zext i1 ' + v + ' to i64')
  else if (fromT = 'i64') and (toT = 'i1') then
    self.WriteLine('  ' + r + ' = icmp ne i64 ' + v + ', 0')
  else if (fromT = 'ptr') and (toT = 'i64') then
    self.WriteLine('  ' + r + ' = ptrtoint ptr ' + v + ' to i64')
  else if (fromT = 'i64') and (toT = 'ptr') then
    self.WriteLine('  ' + r + ' = inttoptr i64 ' + v + ' to ptr')
  else if (fromT = 'double') and (toT = 'ptr') then
  begin
    // v0.6.9 P3: assigning a Real to a Variant slot — box it (tag float)
    r := self.BoxScalar(v, 'double');
    result := r;
    Exit;
  end
  else if (fromT = 'i1') and (toT = 'ptr') then
  begin
    r := self.BoxScalar(v, 'i1');
    result := r;
    Exit;
  end
  else if (fromT = 'ptr') and (toT = '{ ptr, i64, i64 }') then
  begin
    // v0.6.9 P3: `result := nil` for a slice-returning function — nil lowers
    // to a zero slice {null, 0, 0} (host emitReturn does the same).
    self.WriteLine('  ' + r + ' = insertvalue { ptr, i64, i64 } zeroinitializer, ptr null, 0');
  end
  else
    self.WriteLine('  ' + r + ' = add i64 0, 0 ; unhandled coerce ' + fromT + '->' + toT);
  result := r;
end;

// ============================================================================
// Calls
// ============================================================================

function TLLVMGenerator.EmitCall(e: TCallExpression; t: String): String;
var
  fname: String;
  args: array of String;
  i: Integer;
  mem: TMemberExpression;
  r: String;
begin
  if e.Func is TIdentifier then
  begin
    fname := (e.Func as TIdentifier).Value;
    if fname = 'Length' then
    begin
      result := self.EmitLength(e.Arguments[0]);
      self.LastType := 'i64';
      Exit;
    end;
    if fname = 'Ord' then
    begin
      result := self.EmitOrd(e.Arguments[0]);
      self.LastType := 'i64';
      Exit;
    end;
    if fname = 'IntToStr' then
    begin
      result := self.EmitIntToStr(e.Arguments[0]);
      self.LastType := 'ptr';
      Exit;
    end;
    if fname = 'StrToInt' then
    begin
      result := self.EmitStrToInt(e.Arguments[0]);
      self.LastType := 'i64';
      Exit;
    end;
    if fname = 'FloatToStr' then
    begin
      result := self.EmitFloatToStr(e.Arguments[0]);
      self.LastType := 'ptr';
      Exit;
    end;
    if fname = 'StrToFloat' then
    begin
      result := self.EmitStrToFloat(e.Arguments[0]);
      self.LastType := 'double';
      Exit;
    end;
    // v0.6.9 P3: StrToInt64 / IntToStr64 / ReadFloat / ReadInt (parser.klx's
    // literal helpers) — same libc lowering as their Int/Str counterparts.
    if fname = 'StrToInt64' then
    begin
      result := self.EmitStrToInt(e.Arguments[0]);
      self.LastType := 'i64';
      Exit;
    end;
    if fname = 'WriteLn' then
    begin
      result := self.EmitWriteLn(e.Arguments);
      self.LastType := 'ptr';
      Exit;
    end;
    if fname = 'Write' then
    begin
      self.LastType := 'ptr';
      result := self.EmitWrite(e.Arguments);
      Exit;
    end;
    if fname = 'ReadFile' then
    begin
      result := self.EmitReadFile(e.Arguments[0]);
      self.LastType := 'ptr';
      Exit;
    end;
    if (fname = 'LowerCase') or (fname = 'UpperCase') then
    begin
      result := self.EmitCaseConv(fname, e.Arguments[0]);
      self.LastType := 'ptr';
      Exit;
    end;
    if fname = 'append' then
    begin
      result := self.EmitAppend(e.Arguments[0], e.Arguments[1]);
      self.LastType := '{ ptr, i64, i64 }';
      Exit;
    end;
    // v0.6.9 P3: bare stdlib call — `ReadFile(...)` for a used module (user
    // functions win: checked against FNames first).
    if self.IndexOfStr(self.FNames, fname) < 0 then
    begin
      // NewCache is inlined, not a baked define (mirrors the host)
      if (fname = 'NewCache') and (Length(e.Arguments) = 2) then
      begin
        result := self.EmitNewCacheInline(e.Arguments[0], e.Arguments[1]);
        Exit;
      end;
      // Now()/Today() are inlined (arena_alloc + time), mirroring the host
      if ((fname = 'Now') or (fname = 'Today')) and (Length(e.Arguments) = 0) then
      begin
        result := self.EmitDateTimeNowInline();
        Exit;
      end;
      r := self.TryStdlibBareCall(fname, e.Arguments);
      if r <> '' then
      begin
        result := r;
        Exit;
      end;
    end;
    args := [];
    self.LastArgTypes := [];
    for i := 0 to Length(e.Arguments) - 1 do
    begin
      append(args, self.EmitExprTyped(e.Arguments[i]));
      append(self.LastArgTypes, self.LastType);
    end;
    result := self.EmitPlainCall(fname, args, t);
    t := self.LastType;
    Exit;
  end;
  if e.Func is TMemberExpression then
  begin
    mem := e.Func as TMemberExpression;
    // v0.6.9 P3: `sysutil.ReadFile(...)` etc. — dispatch to the baked stdlib
    // IR segments (see src/stdlib_ir.klx) when Obj is a used module name.
    if mem.Obj is TIdentifier then
    begin
      r := self.TryStdlibModuleCall((mem.Obj as TIdentifier).Value, mem.Member, e.Arguments);
      if r <> '' then
      begin
        result := r;
        Exit;
      end;
    end;
    result := self.EmitMethodCallWithArgs(mem, e.Arguments, t);
    self.LastType := self.MemberType;
    Exit;
  end;
  self.LastType := 'i64';
  r := self.Tmp();
  self.WriteLine('  ' + r + ' = add i64 0, 0 ; unhandled call');
  result := r;
end;

function TLLVMGenerator.EmitPlainCall(fname: String; args: array of String; t: String): String;
var
  retType, r, argList, pt, n: String;
  i, fi: Integer;
begin
  self.WriteLine('  ; dbg pc ' + fname + ' nfn=' + self.IntToStrS(Length(self.FNames)));
  // v0.6.9 P4: WriteOut(s) — unbounded stdout write (matches host).
  if fname = 'WriteOut' then
  begin
    n := self.Tmp();
    self.WriteLine('  ' + n + ' = call i64 @strlen(ptr ' + args[0] + ')');
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = call i64 @write(i32 1, ptr ' + args[0] + ', i64 ' + n + ')');
    self.LastType := 'i64';
    result := r;
    Exit;
  end;
  // v0.6.9 P4: EProg(s) — stderr progress probe (fprintf(stderr, "%s\n", s)).
  // A self-emit run leaves a live trail on stderr even if the process dies.
  if fname = 'EProg' then
  begin
    n := self.Tmp();
    self.WriteLine('  ' + n + ' = call i64 @strlen(ptr ' + args[0] + ')');
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = call i64 @write(i32 2, ptr ' + args[0] + ', i64 ' + n + ')');
    self.LastType := 'i64';
    result := r;
    Exit;
  end;
  retType := '';
  fi := self.IndexOfStr(self.FNames, fname);
  if fi >= 0 then retType := self.FRet[fi];
  if retType = '' then retType := 'i64';
  // v0.6.9 P3: type each argument from the registered param types — LLVM
  // rejects untyped call args (`call @Add(%t1, %t2)` is invalid).
  argList := '';
  for i := 0 to Length(args) - 1 do
  begin
    if i > 0 then argList := argList + ', ';
    pt := 'i64';
    if fi >= 0 then
    begin
      if fi < Length(self.FParamTypes) then
        pt := self.UnescapePipe(self.NthOf(self.FParamTypes[fi], i));
      if pt = '' then pt := 'i64';
    end;
    // v0.6.9 P3: coerce the actual to the formal's type (Average(3, 4, 5)
    // passes i64 literals into double params — sitofp them).
    if (i < Length(self.LastArgTypes)) and (self.LastArgTypes[i] <> pt) then
      args[i] := self.CoerceValue(args[i], self.LastArgTypes[i], pt);
    argList := argList + pt + ' ' + args[i];
  end;
  if retType = 'void' then
  begin
    self.WriteLine('  call void @' + fname + '(' + argList + ')');
    self.LastType := 'void';
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = add i64 0, 0 ; void call');
    result := r;
    Exit;
  end;
  r := self.Tmp();
  self.WriteLine('  ' + r + ' = call ' + retType + ' @' + fname + '(' + argList + ')');
  self.LastType := retType;
  result := r;
end;

// ============================================================================
// stdlib IR segments — v0.6.9 P3. The stdlib bodies are NOT hand-written here:
// the host compiler's emitted IR for each stdlib module was extracted into
// src/stdlib_ir.klx (scripts/extract_stdlib_ir.py) as Kylix string data. The
// dispatch below resolves `sysutil.ReadFile(...)` / bare `ReadFile(...)` to a
// baked segment, marks it used (+ its dependency segments), and emits the call;
// EmitStdlibSegments appends the used segments' IR verbatim at module end.
// ============================================================================

// StdlibIRSeg — the baked segment name for a Kylix module name. The jsonutil
// module's IR symbols are prefixed `json_` (host naming), everything else
// matches its module name.
function TLLVMGenerator.StdlibIRSeg(modName: String): String;
begin
  if modName = 'jsonutil' then
    result := 'json'
  else
    result := modName;
end;

function TLLVMGenerator.StdSegIndex(seg: String): Integer;
begin
  result := self.IndexOfStr(StdSegNames, seg);
end;

// StdlibFnIndex — index of @__kylix_<seg>_<fname> in the baked signature table.
function TLLVMGenerator.StdlibFnIndex(seg: String; fname: String): Integer;
begin
  result := self.IndexOfStr(StdFnNames, '__kylix_' + seg + '_' + fname);
end;

// NthOf — the idx-th comma-separated field of s ('' when out of range). Used
// to split the baked StdFnParams strings ("ptr,ptr,i64").
function TLLVMGenerator.NthOf(s: String; idx: Integer): String;
var
  i, n, start: Integer;
  isEnd: Boolean;
begin
  result := '';
  if s = '' then Exit;
  n := 0;
  start := 0;
  for i := 0 to Length(s) do
  begin
    // NB: bootstrap's `or` does NOT short-circuit — guard the slice so
    // i = Length(s) never indexes past the end (memmove OOB crash).
    if i = Length(s) then
      isEnd := true
    else
      isEnd := s[i:i+1] = ',';
    if isEnd then
    begin
      if n = idx then
      begin
        result := s[start:i];
        Exit;
      end;
      n := n + 1;
      start := i + 1;
    end;
  end;
end;

// MarkStdSeg — queue a segment for end-of-module emission, plus its dependency
// segments (jwt needs crypto+json; websocket needs net; ...). Idempotent.
procedure TLLVMGenerator.MarkStdSeg(seg: String);
var
  si, i: Integer;
  deps, dep: String;
  depStart: Integer;
  depEnd: Boolean;
begin
  si := self.StdSegIndex(seg);
  if si < 0 then Exit;
  if self.IndexOfStr(self.UsedSegs, seg) >= 0 then Exit;
  append(self.UsedSegs, seg);
  deps := StdSegDeps[si];
  if deps = '' then Exit;
  depStart := 0;
  for i := 0 to Length(deps) do
  begin
    // NB: `or` does not short-circuit — guard the slice (see NthOf)
    if i = Length(deps) then
      depEnd := true
    else
      depEnd := deps[i:i+1] = ',';
    if depEnd then
    begin
      dep := deps[depStart:i];
      if dep <> '' then self.MarkStdSeg(dep);
      depStart := i + 1;
    end;
  end;
end;

// EmitStdlibCall — evaluate args, emit `call @__kylix_<seg>_<fname>`, mark the
// segment used. Returns the result register ('' for void). Unknown functions
// get the same "not implemented" stub the host emits (stub parity).
function TLLVMGenerator.EmitStdlibCall(seg: String; fname: String; callArgs: array of TExpression): String;
var
  fi, i, nargs: Integer;
  fnameEff, sym, ret, params, argList, r, r2, argReg, pt, argName: String;
  isMapArg: Boolean;
  argRegs: array of String;
begin
  fnameEff := fname;
  // PathJoin is monomorphized per arity on the host (PathJoin_1/2/3…).
  // Callers that pre-monomorphized (TryStdlibBareCall) pass PathJoin_N
  // directly — the exact-name check below keeps this idempotent.
  if fnameEff = 'PathJoin' then
    fnameEff := fnameEff + '_' + self.IntToStrS(Length(callArgs));
  // JsonEncode/JsonEncodePretty take a Variant box in the baked IR, but Kylix
  // programs pass a map variable (htab handle) — the baked _htab wrapper does
  // the box_map conversion (keeps this dispatch free of AST type checks).
  if (seg = 'json') and ((fnameEff = 'JsonEncode') or (fnameEff = 'JsonEncodePretty')) then
    fnameEff := fnameEff + '_htab';
  // v0.6.9 P3: JsonGetArray is an out-param define (void; writes the slice to
  // a callee alloca) — wrap with out-alloca + load here (host emitJsonGetArrayCall).
  if (seg = 'json') and (fnameEff = 'JsonGetArray') then
  begin
    self.MarkStdSeg(seg);
    self.NeedHashtab := true;
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = alloca { ptr, i64, i64 }, align 8');
    argReg := self.EmitExpr(callArgs[0]);
    pt := self.EmitExpr(callArgs[1]);
    self.WriteLine('  call void @__kylix_json_JsonGetArray(ptr ' + r + ', ptr ' + argReg + ', ptr ' + pt + ')');
    r2 := self.Tmp();
    self.WriteLine('  ' + r2 + ' = load { ptr, i64, i64 }, ptr ' + r);
    self.LastType := '{ ptr, i64, i64 }';
    result := r2;
    Exit;
  end;
  fi := self.StdlibFnIndex(seg, fnameEff);
  if fi < 0 then
  begin
    for i := 0 to Length(callArgs) - 1 do
      self.EmitExpr(callArgs[i]);
    // boot/httpclient stubs return the empty string (string semantics), the
    // rest the same i64 stub the host emits
    if (seg = 'boot') or (seg = 'httpclient') then
    begin
      r := self.PtrTo(self.AddString(''), 1);
      self.LastType := 'ptr';
      result := r;
      Exit;
    end;
    r := self.Tmp();
    if Length(seg) > 64 then
    begin
      self.WriteLine('  ; DBG huge-stdlib-seg len=' + self.IntToStrS(Length(seg)));
      seg := 'SEGBIG';
    end;
    if Length(fname) > 64 then
    begin
      self.WriteLine('  ; DBG huge-stdlib-fn len=' + self.IntToStrS(Length(fname)));
      fname := 'FNBIG';
    end;
    self.WriteLine('  ' + r + ' = add i64 0, 0 ; stdlib ' + seg + '.' + fname + ' not implemented');
    self.LastType := 'i64';
    result := r;
    Exit;
  end;
  self.MarkStdSeg(seg);
  sym := StdFnNames[fi];
  ret := StdFnRet[fi];
  params := StdFnParams[fi];
  nargs := Length(callArgs);
  argRegs := [];
  for i := 0 to nargs - 1 do
  begin
    argReg := self.EmitExpr(callArgs[i]);
    // Coerce scalars to ptr when the param slot wants a String — Integer/enum
    // args would otherwise reach llc as i64 into a ptr param.
    pt := self.NthOf(params, i);
    if (pt = 'ptr') and (self.LastType <> 'ptr') and (self.LastType <> '') then
    begin
      r := self.Tmp();
      self.WriteLine('  ' + r + ' = inttoptr i64 ' + argReg + ' to ptr');
      argReg := r;
    end;
    append(argRegs, argReg);
  end;
  argList := '';
  for i := 0 to nargs - 1 do
  begin
    if i > 0 then argList := argList + ', ';
    argList := argList + self.NthOf(params, i) + ' ' + argRegs[i];
  end;
  if ret = 'void' then
  begin
    self.WriteLine('  call void @' + sym + '(' + argList + ')');
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = add i64 0, 0 ; void call');
    self.LastType := 'i64';
    result := r;
    Exit;
  end;
  r := self.Tmp();
  self.WriteLine('  ' + r + ' = call ' + ret + ' @' + sym + '(' + argList + ')');
  self.LastType := ret;
  result := r;
end;

// ---- stdlib module function tables (mirrors host stdlibModuleFuncs) ----
// Module-level resolution: a call dispatches when the MODULE is used and the
// function is in its API list, even if no IR body was baked (functions the
// host also stubs — db.DbExec, boot.BootRun …) — EmitStdlibCall then emits
// the same call-site stub the host does. boot has no baked segment at all.
// NOTE: implemented as an if-chain over local strings — a module-level global
// array of long string literals crashed the baked compiler (memmove on a
// garbage ptr at emit time).

// InCommaList — is name one of the comma-separated fields of list?
function TLLVMGenerator.InCommaList(list: String; name: String): Boolean;
var
  i, start: Integer;
  item: String;
begin
  result := false;
  if list = '' then Exit;
  start := 0;
  for i := 0 to Length(list) do
  begin
    if (i = Length(list)) or (list[i:i+1] = ',') then
    begin
      item := list[start:i];
      if item = name then
      begin
        result := true;
        Exit;
      end;
      start := i + 1;
    end;
  end;
end;

// StdModHasFunc — does modName's stdlib API list contain fname?
// Grouped equality chains (the slice-based comma lookup crashed the baked
// compiler inside a method context — root cause TBD, equality is safe).
function TLLVMGenerator.StdModHasFunc(modName: String; fname: String): Boolean;
begin
  result := false;
  if modName = 'sysutil' then
  begin
    if (fname = 'ReadFile') or (fname = 'WriteFile') or (fname = 'FileExists') or (fname = 'PathJoin') then begin result := true; Exit; end;
    if (fname = 'PathBase') or (fname = 'DirExists') or (fname = 'CreateDir') or (fname = 'DeleteFile') then begin result := true; Exit; end;
    if (fname = 'AppendFile') or (fname = 'CopyFile') or (fname = 'GetFileSize') or (fname = 'GetWorkingDir') then begin result := true; Exit; end;
    if (fname = 'SetWorkingDir') or (fname = 'GetTempDir') then begin result := true; Exit; end;
    Exit;
  end;
  if modName = 'regex' then
  begin
    if (fname = 'IsEmail') or (fname = 'IsURL') or (fname = 'IsNumeric') or (fname = 'IsAlpha') then begin result := true; Exit; end;
    if (fname = 'IsAlphaNumeric') or (fname = 'IsIP') then begin result := true; Exit; end;
    Exit;
  end;
  if modName = 'datetime' then
  begin
    if (fname = 'Now') or (fname = 'Today') or (fname = 'MakeDate') or (fname = 'MakeTime') then begin result := true; Exit; end;
    if (fname = 'ParseDate') or (fname = 'ParseDateTime') or (fname = 'FreeArena') then begin result := true; Exit; end;
    if (fname = 'Year') or (fname = 'Month') or (fname = 'Day') or (fname = 'AddDays') then begin result := true; Exit; end;
    if fname = 'FormatDate' then begin result := true; Exit; end;
    Exit;
  end;
  if modName = 'encoding' then
  begin
    if (fname = 'HexEncode') or (fname = 'HexDecode') or (fname = 'Base64Encode') or (fname = 'Base64Decode') then begin result := true; Exit; end;
    if (fname = 'Base64URLEncode') or (fname = 'Base64URLDecode') or (fname = 'UrlEncode') or (fname = 'UrlDecode') then begin result := true; Exit; end;
    Exit;
  end;
  if modName = 'net' then
  begin
    if (fname = 'TcpDial') or (fname = 'TcpWrite') or (fname = 'TcpRead') or (fname = 'TcpClose') then begin result := true; Exit; end;
    if (fname = 'TcpListen') or (fname = 'TcpAccept') or (fname = 'TcpListenerClose') or (fname = 'UdpDial') then begin result := true; Exit; end;
    if (fname = 'UdpSend') or (fname = 'UdpRecv') or (fname = 'UdpClose') or (fname = 'DnsLookup') or (fname = 'DnsLookupCNAME') then begin result := true; Exit; end;
    Exit;
  end;
  if modName = 'cache' then
  begin
    if fname = 'NewCache' then begin result := true; Exit; end;
    Exit;
  end;
  if modName = 'crypto' then
  begin
    if (fname = 'Sha256') or (fname = 'Md5') or (fname = 'Sha512') or (fname = 'HmacSha256') then begin result := true; Exit; end;
    if (fname = 'AesEncrypt') or (fname = 'AesDecrypt') or (fname = 'BCryptHash') or (fname = 'BCryptCompare') then begin result := true; Exit; end;
    Exit;
  end;
  if modName = 'db' then
  begin
    if (fname = 'DbOpenSQLite') or (fname = 'DbOpen') or (fname = 'DbClose') or (fname = 'DbExec') then begin result := true; Exit; end;
    if (fname = 'DbQueryScalar') or (fname = 'DbQueryRows') then begin result := true; Exit; end;
    Exit;
  end;
  if modName = 'jsonutil' then
  begin
    if (fname = 'JsonIsValid') or (fname = 'JsonDecodeMap') or (fname = 'JsonDecode') or (fname = 'JsonGetString') then begin result := true; Exit; end;
    if (fname = 'JsonGetInt') or (fname = 'JsonGetFloat') or (fname = 'JsonGetBool') or (fname = 'JsonGetMap') then begin result := true; Exit; end;
    if (fname = 'JsonGetArray') or (fname = 'JsonArrayLen') or (fname = 'JsonArrayGetString') or (fname = 'JsonHasKey') then begin result := true; Exit; end;
    if (fname = 'JsonEncode') or (fname = 'JsonEncodePretty') then begin result := true; Exit; end;
    Exit;
  end;
  if modName = 'boot' then
  begin
    if (fname = 'BootText') or (fname = 'BootJSON') or (fname = 'BootHTML') or (fname = 'BootRegisterJwtAuth') then begin result := true; Exit; end;
    if (fname = 'BootRun') or (fname = 'BootGET') or (fname = 'BootPOST') or (fname = 'BootPUT') or (fname = 'BootDELETE') then begin result := true; Exit; end;
    if (fname = 'BootUseLogger') or (fname = 'BootUseRecover') or (fname = 'BootUseCORS') or (fname = 'BootUseRequestID') then begin result := true; Exit; end;
    if (fname = 'BootConfigSet') or (fname = 'BootConfigGetString') or (fname = 'BootConfigGetInt') or (fname = 'BootRegisterInstance') then begin result := true; Exit; end;
    if (fname = 'BootResolve') or (fname = 'BootRegisterAuth') or (fname = 'BootRegisterRoles') or (fname = 'BootEnforceAuth') or (fname = 'BootEnforceRole') then begin result := true; Exit; end;
    if fname = 'BootReadJSON' then begin result := true; Exit; end;
    Exit;
  end;
  if modName = 'httpclient' then
  begin
    if (fname = 'NewHttpClient') or (fname = 'SetHeader') or (fname = 'HttpGet') or (fname = 'HttpPost') then begin result := true; Exit; end;
    if (fname = 'HttpPut') or (fname = 'HttpDelete') or (fname = 'HttpGetJSON') or (fname = 'HttpPostJSON') then begin result := true; Exit; end;
    if (fname = 'HttpDoGet') or (fname = 'HttpDoPost') then begin result := true; Exit; end;
    Exit;
  end;
  if modName = 'jwt' then
  begin
    if (fname = 'JwtSign') or (fname = 'JwtVerify') or (fname = 'JwtSubject') or (fname = 'JwtGetString') or (fname = 'JwtGetInt') then begin result := true; Exit; end;
    Exit;
  end;
  if modName = 'websocket' then
  begin
    if (fname = 'WsDial') or (fname = 'WsDialConnect') or (fname = 'WsDialFinish') or (fname = 'WsAccept') then begin result := true; Exit; end;
    if (fname = 'WsSend') or (fname = 'WsRecv') or (fname = 'WsClose') then begin result := true; Exit; end;
    Exit;
  end;
end;

// TryStdlibModuleCall — `sysutil.ReadFile(...)`: modName must be a known
// stdlib module AND appear in a `uses` clause. Returns the result register, or
// '' to fall through to the regular method-call path.
function TLLVMGenerator.TryStdlibModuleCall(modName: String; fname: String; callArgs: array of TExpression): String;
var
  seg: String;
begin
  result := '';
  if self.IndexOfStr(self.UsedMods, modName) < 0 then Exit;
  // module-level resolution: boot has no baked segment but still dispatches
  // (EmitStdlibCall stubs its functions, matching the host)
  if self.StdModHasFunc(modName, fname) = false then Exit;
  seg := self.StdlibIRSeg(modName);
  // NewCache is inlined, not a baked define (mirrors the host)
  if (fname = 'NewCache') and (Length(callArgs) = 2) then
  begin
    result := self.EmitNewCacheInline(callArgs[0], callArgs[1]);
    Exit;
  end;
  // Now()/Today() are inlined (arena_alloc + time), mirroring the host
  if ((fname = 'Now') or (fname = 'Today')) and (Length(callArgs) = 0) then
  begin
    result := self.EmitDateTimeNowInline();
    Exit;
  end;
  result := self.EmitStdlibCall(seg, fname, callArgs);
end;

// TryStdlibBareCall — bare `ReadFile(...)` for an imported module (host
// resolveStdlibBareCall). User-defined functions take precedence (checked by
// the caller against FNames before calling this). Returns the result register
// or '' when no used module resolves the name.
function TLLVMGenerator.TryStdlibBareCall(fname: String; callArgs: array of TExpression): String;
var
  mi: Integer;
  modName, seg, fnameEff: String;
begin
  result := '';
  // PathJoin is monomorphized per arity in the baked table (PathJoin_1/2/3…)
  fnameEff := fname;
  if fnameEff = 'PathJoin' then
    fnameEff := fnameEff + '_' + self.IntToStrS(Length(callArgs));
  for mi := 0 to Length(self.UsedMods) - 1 do
  begin
    modName := self.UsedMods[mi];
    // module-level resolution (mirrors host resolveStdlibBareCall): body-less
    // functions fall to the call-site stub inside EmitStdlibCall
    if self.StdModHasFunc(modName, fname) then
    begin
      seg := self.StdlibIRSeg(modName);
      // NewCache / Now / Today are inlined, not baked defines
      if (fnameEff = 'NewCache') and (Length(callArgs) = 2) then
      begin
        result := self.EmitNewCacheInline(callArgs[0], callArgs[1]);
        Exit;
      end;
      if ((fnameEff = 'Now') or (fnameEff = 'Today')) and (Length(callArgs) = 0) then
      begin
        result := self.EmitDateTimeNowInline();
        Exit;
      end;
      result := self.EmitStdlibCall(seg, fnameEff, callArgs);
      Exit;
    end;
  end;
end;

// CollectProgramUses — register every program's `uses` names. Kept as a plain
// procedure so the array-of-String member chain (progs[pi].Uses[i]) never has
// to cross the method-call argument path, which can't lower it.
procedure TLLVMGenerator.CollectProgramUses(progs: array of TProgram);
var
  pi, ui: Integer;
  p: TProgram;
begin
  for pi := 0 to Length(progs) - 1 do
  begin
    p := progs[pi];
    for ui := 0 to Length(p.Uses) - 1 do
      self.CollectUse(p.Uses[ui]);
  end;
end;

// EmitReceiverPtr — load the instance ptr for a wrapper-class receiver
// (TCache / THttpClient locals or globals).
function TLLVMGenerator.EmitReceiverPtr(objExpr: TExpression): String;
var slot, r: String;
begin
  if objExpr is TIdentifier then
  begin
    slot := self.ArraySlot((objExpr as TIdentifier).Value);
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = load ptr, ptr ' + slot);
    result := r;
    Exit;
  end;
  result := self.EmitExpr(objExpr);
end;

// PtrCoerce — best-effort scalar→ptr for stdlib wrapper args (mirrors
// EmitStdlibCall's inttoptr shim).
function TLLVMGenerator.PtrCoerce(reg: String): String;
var r: String;
begin
  if (self.LastType = 'ptr') or (self.LastType = '') then
  begin
    result := reg;
    Exit;
  end;
  r := self.Tmp();
  self.WriteLine('  ' + r + ' = inttoptr i64 ' + reg + ' to ptr');
  result := r;
end;

// EmitNewCacheInline — cache.NewCache(cap, ttlMs) → TCache handle. Inlined
// (mirrors host emitCacheNewCacheCall): {htab, ttl-htab, defaultTtlMs}.
function TLLVMGenerator.EmitNewCacheInline(capArg: TExpression; ttlArg: TExpression): String;
var
  ttl, h, htab, ttlLoc, ttlMsLoc: String;
begin
  self.EmitExpr(capArg); // cap accepted but ignored (fixed-bucket htab)
  ttl := self.EmitExpr(ttlArg);
  self.NeedHashtab := true;
  self.MarkStdSeg('cache');
  h := self.Tmp();
  self.WriteLine('  ' + h + ' = call ptr @malloc(i64 24)');
  htab := self.Tmp();
  self.WriteLine('  ' + htab + ' = call ptr @__kylix_htab_new()');
  self.WriteLine('  store ptr ' + htab + ', ptr ' + h);
  ttlLoc := self.Tmp();
  self.WriteLine('  ' + ttlLoc + ' = getelementptr inbounds i8, ptr ' + h + ', i64 8');
  htab := self.Tmp();
  self.WriteLine('  ' + htab + ' = call ptr @__kylix_htab_new()');
  self.WriteLine('  store ptr ' + htab + ', ptr ' + ttlLoc);
  ttlMsLoc := self.Tmp();
  self.WriteLine('  ' + ttlMsLoc + ' = getelementptr inbounds i8, ptr ' + h + ', i64 16');
  self.WriteLine('  store i64 ' + ttl + ', ptr ' + ttlMsLoc);
  self.LastType := 'ptr';
  result := h;
end;

// EmitDateTimeNowInline — datetime.Now()/Today() → TDateTime handle. Inlined
// (mirrors the host): allocate 8 bytes from the datetime arena, store time().
function TLLVMGenerator.EmitDateTimeNowInline: String;
var p, ts: String;
begin
  self.MarkStdSeg('datetime');
  p := self.Tmp();
  self.WriteLine('  ' + p + ' = call ptr @__kylix_datetime_arena_alloc(i64 8)');
  ts := self.Tmp();
  self.WriteLine('  ' + ts + ' = call i64 @time(ptr null)');
  self.WriteLine('  store i64 ' + ts + ', ptr ' + p);
  self.LastType := 'ptr';
  result := p;
end;

// TryStdlibMethodCall — wrapper-class methods on baked stdlib handles
// (c.PutWithTTL / h.Get ...). classT is the receiver's Kylix type name.
// Returns '' to fall through to the unhandled-receiver stub.
function TLLVMGenerator.TryStdlibMethodCall(classT: String; method: String; objExpr: TExpression; margs: array of TExpression): String;
var
  recv, k, v, ttl, ttlLoc, htabLoc, htab, res: String;
  resSlot, e, n, bad, boxed, lblBad, lblBox, lblDone: String;
  r: String;
begin
  result := '';
  if classT = 'TCache' then
  begin
    recv := self.EmitReceiverPtr(objExpr);
    self.NeedHashtab := true;
    self.MarkStdSeg('cache');
    if method = 'Put' then
    begin
      if Length(margs) <> 2 then Exit;
      k := self.PtrCoerce(self.EmitExpr(margs[0]));
      v := self.PtrCoerce(self.EmitExpr(margs[1]));
      ttlLoc := self.Tmp();
      self.WriteLine('  ' + ttlLoc + ' = getelementptr inbounds i8, ptr ' + recv + ', i64 16');
      ttl := self.Tmp();
      self.WriteLine('  ' + ttl + ' = load i64, ptr ' + ttlLoc);
      self.WriteLine('  call void @__kylix_cache_put(ptr ' + recv + ', ptr ' + k + ', ptr ' + v + ', i64 ' + ttl + ')');
      r := self.Tmp();
      self.WriteLine('  ' + r + ' = add i64 0, 0 ; void call');
      self.LastType := 'i64';
      result := r;
      Exit;
    end;
    if method = 'PutWithTTL' then
    begin
      if Length(margs) <> 3 then Exit;
      k := self.PtrCoerce(self.EmitExpr(margs[0]));
      v := self.PtrCoerce(self.EmitExpr(margs[1]));
      ttl := self.EmitExpr(margs[2]);
      self.WriteLine('  call void @__kylix_cache_put(ptr ' + recv + ', ptr ' + k + ', ptr ' + v + ', i64 ' + ttl + ')');
      r := self.Tmp();
      self.WriteLine('  ' + r + ' = add i64 0, 0 ; void call');
      self.LastType := 'i64';
      result := r;
      Exit;
    end;
    if method = 'Get' then
    begin
      // Simplified vs the host: returns the cached STRING directly (the cache
      // htab stores stringified values) instead of a Variant box — WriteLn and
      // string use then share the plain-ptr path.
      if Length(margs) <> 1 then Exit;
      k := self.PtrCoerce(self.EmitExpr(margs[0]));
      self.MarkStdSeg('cache');
      resSlot := self.Tmp();
      self.WriteLine('  ' + resSlot + ' = alloca ptr, align 8');
      e := self.Tmp();
      self.WriteLine('  ' + e + ' = call i1 @__kylix_cache_expired(ptr ' + recv + ', ptr ' + k + ')');
      htabLoc := self.Tmp();
      self.WriteLine('  ' + htabLoc + ' = getelementptr inbounds i8, ptr ' + recv + ', i64 0');
      htab := self.Tmp();
      self.WriteLine('  ' + htab + ' = load ptr, ptr ' + htabLoc);
      v := self.Tmp();
      self.WriteLine('  ' + v + ' = call ptr @__kylix_htab_get(ptr ' + htab + ', ptr ' + k + ')');
      n := self.Tmp();
      self.WriteLine('  ' + n + ' = icmp eq ptr ' + v + ', null');
      bad := self.Tmp();
      self.WriteLine('  ' + bad + ' = or i1 ' + e + ', ' + n);
      lblBad := self.Label();
      lblBox := self.Label();
      lblDone := self.Label();
      self.WriteLine('  br i1 ' + bad + ', label %' + lblBad + ', label %' + lblBox);
      self.WriteLine(lblBad + ':');
      self.WriteLine('  store ptr @__kylix_emptystr, ptr ' + resSlot);
      self.WriteLine('  br label %' + lblDone);
      self.WriteLine(lblBox + ':');
      self.WriteLine('  store ptr ' + v + ', ptr ' + resSlot);
      self.WriteLine('  br label %' + lblDone);
      self.WriteLine(lblDone + ':');
      res := self.Tmp();
      self.WriteLine('  ' + res + ' = load ptr, ptr ' + resSlot);
      self.LastType := 'ptr';
      result := res;
      Exit;
    end;
    if method = 'GetString' then
    begin
      if Length(margs) <> 1 then Exit;
      k := self.PtrCoerce(self.EmitExpr(margs[0]));
      htabLoc := self.Tmp();
      self.WriteLine('  ' + htabLoc + ' = getelementptr inbounds i8, ptr ' + recv + ', i64 0');
      htab := self.Tmp();
      self.WriteLine('  ' + htab + ' = load ptr, ptr ' + htabLoc);
      res := self.Tmp();
      self.WriteLine('  ' + res + ' = call ptr @__kylix_htab_get(ptr ' + htab + ', ptr ' + k + ')');
      self.LastType := 'ptr';
      result := res;
      Exit;
    end;
    if method = 'Has' then
    begin
      if Length(margs) <> 1 then Exit;
      k := self.PtrCoerce(self.EmitExpr(margs[0]));
      htabLoc := self.Tmp();
      self.WriteLine('  ' + htabLoc + ' = getelementptr inbounds i8, ptr ' + recv + ', i64 0');
      htab := self.Tmp();
      self.WriteLine('  ' + htab + ' = load ptr, ptr ' + htabLoc);
      res := self.Tmp();
      self.WriteLine('  ' + res + ' = call i1 @__kylix_htab_has(ptr ' + htab + ', ptr ' + k + ')');
      self.LastType := 'i1';
      result := res;
      Exit;
    end;
    if method = 'Delete' then
    begin
      if Length(margs) <> 1 then Exit;
      k := self.PtrCoerce(self.EmitExpr(margs[0]));
      htabLoc := self.Tmp();
      self.WriteLine('  ' + htabLoc + ' = getelementptr inbounds i8, ptr ' + recv + ', i64 0');
      htab := self.Tmp();
      self.WriteLine('  ' + htab + ' = load ptr, ptr ' + htabLoc);
      self.WriteLine('  call void @__kylix_htab_del(ptr ' + htab + ', ptr ' + k + ')');
      res := self.Tmp();
      self.WriteLine('  ' + res + ' = add i64 0, 0 ; void call');
      self.LastType := 'i64';
      result := res;
      Exit;
    end;
    if method = 'Size' then
    begin
      if Length(margs) <> 0 then Exit;
      htabLoc := self.Tmp();
      self.WriteLine('  ' + htabLoc + ' = getelementptr inbounds i8, ptr ' + recv + ', i64 0');
      htab := self.Tmp();
      self.WriteLine('  ' + htab + ' = load ptr, ptr ' + htabLoc);
      res := self.Tmp();
      self.WriteLine('  ' + res + ' = call i64 @__kylix_htab_size(ptr ' + htab + ')');
      self.LastType := 'i64';
      result := res;
      Exit;
    end;
    Exit; // other TCache methods: fall through to the stub
  end;
  if classT = 'TDateTime' then
  begin
    // TDateTime instance methods (now.Year() …) map straight onto the baked
    // datetime module functions taking the TDateTime handle as %self.
    recv := self.EmitReceiverPtr(objExpr);
    self.MarkStdSeg('datetime');
    if (method = 'Year') or (method = 'Month') or (method = 'Day') then
    begin
      res := self.Tmp();
      self.WriteLine('  ' + res + ' = call i64 @__kylix_datetime_' + method + '(ptr ' + recv + ')');
      self.LastType := 'i64';
      result := res;
      Exit;
    end;
    if method = 'AddDays' then
    begin
      if Length(margs) <> 1 then Exit;
      v := self.EmitExpr(margs[0]);
      res := self.Tmp();
      self.WriteLine('  ' + res + ' = call ptr @__kylix_datetime_AddDays(ptr ' + recv + ', i64 ' + v + ')');
      self.LastType := 'ptr';
      result := res;
      Exit;
    end;
    if method = 'FormatDate' then
    begin
      // Zero-arg in the tutorials (pattern is baked into the IR body)
      if Length(margs) > 1 then Exit;
      res := self.Tmp();
      self.WriteLine('  ' + res + ' = call ptr @__kylix_datetime_FormatDate(ptr ' + recv + ')');
      self.LastType := 'ptr';
      result := res;
      Exit;
    end;
    Exit; // other TDateTime methods: fall through to the stub
  end;
  if classT = 'THttpClient' then
  begin
    recv := self.EmitReceiverPtr(objExpr);
    self.MarkStdSeg('httpclient');
    if method = 'SetHeader' then
    begin
      if Length(margs) <> 2 then Exit;
      k := self.PtrCoerce(self.EmitExpr(margs[0]));
      v := self.PtrCoerce(self.EmitExpr(margs[1]));
      self.WriteLine('  call void @__kylix_httpclient_SetHeader(ptr ' + recv + ', ptr ' + k + ', ptr ' + v + ')');
      r := self.Tmp();
      self.WriteLine('  ' + r + ' = add i64 0, 0 ; void call');
      self.LastType := 'i64';
      result := r;
      Exit;
    end;
    if method = 'Get' then
    begin
      if Length(margs) <> 1 then Exit;
      k := self.PtrCoerce(self.EmitExpr(margs[0]));
      res := self.Tmp();
      self.WriteLine('  ' + res + ' = call ptr @__kylix_httpclient_Get(ptr ' + recv + ', ptr ' + k + ')');
      self.LastType := 'ptr';
      result := res;
      Exit;
    end;
    if method = 'Post' then
    begin
      if Length(margs) <> 3 then Exit;
      k := self.PtrCoerce(self.EmitExpr(margs[0]));
      v := self.PtrCoerce(self.EmitExpr(margs[1]));
      ttl := self.PtrCoerce(self.EmitExpr(margs[2]));
      res := self.Tmp();
      self.WriteLine('  ' + res + ' = call ptr @__kylix_httpclient_Post(ptr ' + recv + ', ptr ' + k + ', ptr ' + v + ', ptr ' + ttl + ')');
      self.LastType := 'ptr';
      result := res;
      Exit;
    end;
    Exit; // other THttpClient methods: fall through to the stub
  end;
end;

// EmitStdlibSegments — append the used segments' baked IR at module end (after
// main, before string constants — mirrors host emitPendingStdlib). The runtime
// segment (variant helpers, is_subtype, now_ms, htab_get_variant/htab_keys)
// is emitted unconditionally: maps and class RTTI reach for it from codegen
// paths that no stdlib call ever marks.
procedure TLLVMGenerator.EmitStdlibSegments;
var
  si, li, from, cnt: Integer;
  seg: String;
begin
  // The runtime segment's variant helpers call htab_get_variant → htab_find;
  // force the hashtab bodies out even if the program itself has no maps.
  self.NeedHashtab := true;
  for si := 0 to Length(StdSegNames) - 1 do
  begin
    seg := StdSegNames[si];
    // runtime is always in; other segments only when a call marked them
    if (seg <> 'runtime') and (self.IndexOfStr(self.UsedSegs, seg) < 0) then
      continue;
    from := StdSegStart[si];
    cnt := StdSegCount[si];
    for li := from to from + cnt - 1 do
      self.WriteLine(StdIrLines[li]);
  end;
end;

function TLLVMGenerator.EmitIdentLoad(name: String): String;
var
  r, gname: String;
begin
  if self.HasConst(name) then
  begin
    result := self.EmitIntConst(self.ConstValue(name));
    Exit;
  end;
  if name = 'Args' then
  begin
    self.NeedArgs := true;
    // v0.6.9 P3: register Args as a dynamic array so Args[0] indexing
    // resolves through EmitArrayIndexLocal (previously only bare `Args`
    // loads worked and Args[0] collapsed to an unhandled stub).
    if self.IsArrayVar('Args') = false then
      self.RegisterArray('Args', true, 'ptr', 'String', 0, 0);
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = load { ptr, i64, i64 }, ptr @__kylix_args');
    self.LastType := '{ ptr, i64, i64 }';
    result := r;
    Exit;
  end;
  // P3: LOCALS first, then globals — a for-loop counter (RegisterLocal alloca)
  // must shadow a same-named program/unit global (host expr.go v0.5.4). With the
  // old order, `for i := 1 to 3` loaded the global @__kylix_g_i instead of the
  // local %v_i_int → infinite loop (store to local, read from global).
  if self.HasLocal(name) then
  begin
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = load ' + self.ActualType(name) + ', ptr ' + self.LocalReg(name));
    result := r;
    Exit;
  end;
  if self.IndexOfStr(self.GNames, name) >= 0 then
  begin
    gname := self.GReg(name);
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = load ' + self.GType(name) + ', ptr ' + gname);
    result := r;
    Exit;
  end;
  r := self.Tmp();
  self.WriteLine('  ' + r + ' = add i64 0, 0 ; undefined var ' + name);
  result := r;
end;

// ===== global variable bookkeeping (P2) =====
function TLLVMGenerator.GReg(name: String): String;
begin
  result := '@__kylix_g_' + name;
end;

function TLLVMGenerator.GType(name: String): String;
var i: Integer;
begin
  result := 'i64';
  for i := 0 to Length(self.GTypes) - 1 do
    if self.GNames[i] = name then
      result := self.GTypes[i];
end;

function TLLVMGenerator.EmitLength(arg: TExpression): String;
var
  v, t, r, arrReg: String;
  ai: Integer;
begin
  ai := -1;
  if arg is TIdentifier then
    ai := self.IndexOfStr(self.ArrNames, (arg as TIdentifier).Value);
  if ai >= 0 then
  begin
    if self.ArrDynamic[ai] then
    begin
      // v0.6.9 P3: ArraySlot resolves local OR main-program-global arrays
      // (main-program `var` becomes a global — LocalReg alone returns '')
      arrReg := self.ArraySlot((arg as TIdentifier).Value);
      r := self.Tmp();
      v := self.Tmp();
      self.WriteLine('  ' + r + ' = getelementptr inbounds { ptr, i64, i64 }, ptr ' + arrReg + ', i32 0, i32 1');
      self.WriteLine('  ' + v + ' = load i64, ptr ' + r);
      result := v;
      Exit;
    end;
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = add i64 0, ' + self.IntToStrS(self.ArrSize[ai]) + ' ; static array length');
    result := r;
    Exit;
  end;
  v := self.EmitExprTyped(arg);
  t := self.LastType;
  if t = '{ ptr, i64, i64 }' then
  begin
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = extractvalue { ptr, i64, i64 } ' + v + ', 1');
    result := r;
  end
  else
  begin
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = call i64 @strlen(ptr noundef ' + self.NullGuardString(v) + ')');
    result := r;
  end;
end;

function TLLVMGenerator.EmitOrd(arg: TExpression): String;
var
  v, ch, r: String;
begin
  v := self.EmitExpr(arg);
  ch := self.Tmp();
  self.WriteLine('  ' + ch + ' = load i8, ptr ' + v);
  r := self.Tmp();
  self.WriteLine('  ' + r + ' = zext i8 ' + ch + ' to i64');
  result := r;
end;

function TLLVMGenerator.EmitIntToStr(arg: TExpression): String;
var
  v, buf, fmtPtr, count: String;
begin
  v := self.EmitExpr(arg);
  buf := self.Tmp();
  self.WriteLine('  ' + buf + ' = call ptr @malloc(i64 64)');
  fmtPtr := self.PtrTo(self.AddString('%ld'), 4);
  count := self.Tmp();
  self.WriteLine('  ' + count + ' = call i32 (ptr, i64, ptr, ...) @snprintf(ptr ' + buf + ', i64 64, ptr ' + fmtPtr + ', i64 ' + v + ')');
  result := buf;
end;

// EmitStrToFloat — StrToFloat(s) → strtod (i64 holding a double bitcast
// is NOT used; the value flows as a double register).
function TLLVMGenerator.EmitStrToFloat(v: TExpression): String;
var
  r, val: String;
begin
  val := self.EmitExprTyped(v);
  if self.LastType <> 'ptr' then
    val := self.PtrCoerce(val);
  r := self.Tmp();
  self.WriteLine('  ' + r + ' = call double @strtod(ptr ' + val + ')');
  self.LastType := 'double';
  result := r;
end;

// EmitFloatToStr — FloatToStr(x) → malloc(64) + snprintf("%.17g").
// (v0.6.1: %.17g round-trips doubles exactly; %.6 truncated small values.)
function TLLVMGenerator.EmitFloatToStr(v: TExpression): String;
var
  r, buf, fmtPtr, val: String;
begin
  val := self.EmitExprTyped(v);
  r := self.Tmp();
  buf := self.Tmp();
  self.WriteLine('  ' + buf + ' = call ptr @malloc(i64 64)');
  fmtPtr := self.PtrTo(self.AddString('%.17g'), 6);
  self.WriteLine('  ' + r + ' = call i32 (ptr, i64, ptr, ...) @snprintf(ptr ' + buf + ', i64 64, ptr ' + fmtPtr + ', double ' + val + ')');
  self.LastType := 'ptr';
  result := buf;
end;

function TLLVMGenerator.EmitStrToInt(arg: TExpression): String;
var
  v, r: String;
begin
  v := self.EmitExpr(arg);
  r := self.Tmp();
  self.WriteLine('  ' + r + ' = call i64 @atoll(ptr ' + v + ')');
  result := r;
end;

// EmitReadFile — ReadFile(path) → fopen/fseek/ftell/malloc/fread → heap string.
function TLLVMGenerator.EmitReadFile(arg: TExpression): String;
var
  v, modePtr, fp, retSlot, emptyPtr, nullCk, okLbl, exitLbl: String;
  sizeReg, allocSize, buf, got, term, r: String;
begin
  v := self.EmitExpr(arg);
  self.NeedReadFile := true;
  modePtr := self.PtrTo(self.AddString('r'), 2);
  fp := self.Tmp();
  self.WriteLine('  ' + fp + ' = call ptr @fopen(ptr ' + v + ', ptr ' + modePtr + ')');
  retSlot := self.Tmp();
  self.WriteLine('  ' + retSlot + ' = alloca ptr, align 8');
  emptyPtr := self.PtrTo(self.AddString(''), 1);
  self.WriteLine('  store ptr ' + emptyPtr + ', ptr ' + retSlot);
  nullCk := self.Tmp();
  self.WriteLine('  ' + nullCk + ' = icmp eq ptr ' + fp + ', null');
  okLbl := self.Label();
  exitLbl := self.Label();
  self.WriteLine('  br i1 ' + nullCk + ', label %' + exitLbl + ', label %' + okLbl);
  self.WriteLine(okLbl + ':');
  self.WriteLine('  call i32 @fseek(ptr ' + fp + ', i64 0, i32 2)');
  sizeReg := self.Tmp();
  self.WriteLine('  ' + sizeReg + ' = call i64 @ftell(ptr ' + fp + ')');
  self.WriteLine('  call i32 @fseek(ptr ' + fp + ', i64 0, i32 0)');
  allocSize := self.Tmp();
  self.WriteLine('  ' + allocSize + ' = add i64 ' + sizeReg + ', 1');
  buf := self.Tmp();
  self.WriteLine('  ' + buf + ' = call ptr @malloc(i64 ' + allocSize + ')');
  got := self.Tmp();
  self.WriteLine('  ' + got + ' = call i64 @fread(ptr ' + buf + ', i64 1, i64 ' + sizeReg + ', ptr ' + fp + ')');
  term := self.Tmp();
  self.WriteLine('  ' + term + ' = getelementptr inbounds i8, ptr ' + buf + ', i64 ' + got);
  self.WriteLine('  store i8 0, ptr ' + term);
  self.WriteLine('  call i32 @fclose(ptr ' + fp + ')');
  self.WriteLine('  store ptr ' + buf + ', ptr ' + retSlot);
  self.WriteLine('  br label %' + exitLbl);
  self.WriteLine(exitLbl + ':');
  r := self.Tmp();
  self.WriteLine('  ' + r + ' = load ptr, ptr ' + retSlot);
  result := r;
end;


// EmitCaseConv — LowerCase(s)/UpperCase(s) → heap copy with tolower/toupper
// per char. Mirrors host emitCall's builtin.
function TLLVMGenerator.EmitCaseConv(which, arg: TExpression): String;
var
  src, n, sizeReg, buf, fn, headerLbl: String;
  i, icur, cond, srcp, ch, chext, res, resc, dstp, inext, term: String;
begin
  src := self.EmitExpr(arg);
  self.NeedToLower := true;
  n := self.Tmp();
  self.WriteLine('  ' + n + ' = call i64 @strlen(ptr noundef ' + self.NullGuardString(src) + ')');
  sizeReg := self.Tmp();
  self.WriteLine('  ' + sizeReg + ' = add i64 ' + n + ', 1');
  buf := self.Tmp();
  self.WriteLine('  ' + buf + ' = call ptr @malloc(i64 ' + sizeReg + ')');
  if which = 'UpperCase' then fn := 'toupper'
  else fn := 'tolower';
  i := self.Tmp();
  self.WriteLine('  ' + i + ' = alloca i64, align 8');
  self.WriteLine('  store i64 0, ptr ' + i);
  headerLbl := self.Label();
  self.WriteLine('  br label %' + headerLbl);
  self.WriteLine(headerLbl + ':');
  icur := self.Tmp();
  self.WriteLine('  ' + icur + ' = load i64, ptr ' + i);
  cond := self.Tmp();
  self.WriteLine('  ' + cond + ' = icmp slt i64 ' + icur + ', ' + n);
  self.WriteLine('  br i1 ' + cond + ', label %lbl_body, label %lbl_exit');
  self.WriteLine('lbl_body:');
  srcp := self.Tmp();
  self.WriteLine('  ' + srcp + ' = getelementptr inbounds i8, ptr ' + src + ', i64 ' + icur);
  ch := self.Tmp();
  self.WriteLine('  ' + ch + ' = load i8, ptr ' + srcp);
  chext := self.Tmp();
  self.WriteLine('  ' + chext + ' = zext i8 ' + ch + ' to i32');
  res := self.Tmp();
  self.WriteLine('  ' + res + ' = call i32 @' + fn + '(i32 ' + chext + ')');
  resc := self.Tmp();
  self.WriteLine('  ' + resc + ' = trunc i32 ' + res + ' to i8');
  dstp := self.Tmp();
  self.WriteLine('  ' + dstp + ' = getelementptr inbounds i8, ptr ' + buf + ', i64 ' + icur);
  self.WriteLine('  store i8 ' + resc + ', ptr ' + dstp);
  inext := self.Tmp();
  self.WriteLine('  ' + inext + ' = add i64 ' + icur + ', 1');
  self.WriteLine('  store i64 ' + inext + ', ptr ' + i);
  self.WriteLine('  br label %' + headerLbl);
  self.WriteLine('lbl_exit:');
  term := self.Tmp();
  self.WriteLine('  ' + term + ' = getelementptr inbounds i8, ptr ' + buf + ', i64 ' + n);
  self.WriteLine('  store i8 0, ptr ' + term);
  result := buf;
end;

// ============================================================================
// WriteLn / Write
// ============================================================================

function TLLVMGenerator.EmitWriteLn(args: array of TExpression): String;
var
  i: Integer;
  v, t, guarded, cat, boollit: String;
  buf, pos, dst, rest, fmtPtr: String;
begin
  buf := self.Tmp();
  self.WriteLine('  ' + buf + ' = call ptr @malloc(i64 4096)');
  self.WriteLine('  store i8 0, ptr ' + buf);
  for i := 0 to Length(args) - 1 do
  begin
    if i > 0 then
    begin
      cat := self.Tmp();
      self.WriteLine('  ' + cat + ' = call ptr @strcat(ptr ' + buf + ', ptr ' + self.PtrTo(self.AddString(' '), 2) + ')');
    end;
    v := self.EmitExprTyped(args[i]);
    t := self.LastType;
    if t = 'i64' then
    begin
      fmtPtr := self.PtrTo(self.AddString('%ld'), 4);
      pos := self.Tmp();
      self.WriteLine('  ' + pos + ' = call i64 @strlen(ptr ' + buf + ')');
      dst := self.Tmp();
      self.WriteLine('  ' + dst + ' = getelementptr inbounds i8, ptr ' + buf + ', i64 ' + pos);
      rest := self.Tmp();
      self.WriteLine('  ' + rest + ' = sub i64 4096, ' + pos);
      cat := self.Tmp();
      self.WriteLine('  ' + cat + ' = call i32 (ptr, i64, ptr, ...) @snprintf(ptr ' + dst + ', i64 ' + rest + ', ptr ' + fmtPtr + ', i64 ' + v + ')');
    end
    else if t = 'i1' then
    begin
      boollit := self.EmitBoolStr(v);
      cat := self.Tmp();
      self.WriteLine('  ' + cat + ' = call ptr @strcat(ptr ' + buf + ', ptr ' + boollit + ')');
    end
    else if t = 'double' then
    begin
      // v0.6.9 P3: reals were falling into the ptr strcat path (null-guarding
      // a double — llc type error). Format like the host's WriteLn ("%.15g").
      fmtPtr := self.PtrTo(self.AddString('%.15g'), 6);
      pos := self.Tmp();
      self.WriteLine('  ' + pos + ' = call i64 @strlen(ptr ' + buf + ')');
      dst := self.Tmp();
      self.WriteLine('  ' + dst + ' = getelementptr inbounds i8, ptr ' + buf + ', i64 ' + pos);
      rest := self.Tmp();
      self.WriteLine('  ' + rest + ' = sub i64 4096, ' + pos);
      cat := self.Tmp();
      self.WriteLine('  ' + cat + ' = call i32 (ptr, i64, ptr, ...) @snprintf(ptr ' + dst + ', i64 ' + rest + ', ptr ' + fmtPtr + ', double ' + v + ')');
    end
    else
    begin
      guarded := self.NullGuardString(v);
      cat := self.Tmp();
      self.WriteLine('  ' + cat + ' = call ptr @strcat(ptr ' + buf + ', ptr ' + guarded + ')');
    end;
  end;
  self.WriteLine('  call i32 @puts(ptr ' + buf + ')');
  result := buf;
end;

function TLLVMGenerator.EmitWrite(args: array of TExpression): String;
begin
  result := self.EmitWriteLn(args);
end;

function TLLVMGenerator.BoolStr1(b: Boolean): String;
begin
  if b then result := '1'
  else result := '0';
end;

function TLLVMGenerator.EmitBoolStr(v: String): String;
var
  r: String;
begin
  r := self.Tmp();
  self.WriteLine('  ' + r + ' = select i1 ' + v + ', ptr ' + self.PtrTo(self.AddString('true'), 5) + ', ptr ' + self.PtrTo(self.AddString('false'), 6));
  result := r;
end;

// ============================================================================
// Class / member / array / is-as (P2)
// ============================================================================

// ---- class layout bookkeeping (mirrors host ClassInfo/FieldInfo/MethodInfo) --

function TLLVMGenerator.ClassEmitted(cname: String): Boolean;
begin
  // v0.6.9 P4: name-list instead of a Boolean-array element write — the
  // element store emitted an i1 into a ptr slot (KylixTToLLVM gap) and broke
  // the verifier. A flat name list is simpler and type-safe.
  result := self.IndexOfStr(self.EmittedNames, cname) >= 0;
end;

procedure TLLVMGenerator.MarkClassEmitted(cname: String);
begin
  if self.IndexOfStr(self.EmittedNames, cname) < 0 then
    append(self.EmittedNames, cname);
end;

function TLLVMGenerator.ClassIndex(cname: String): Integer;
var i: Integer;
begin
  result := -1;
  for i := 0 to Length(self.ClassNames) - 1 do
    if self.ClassNames[i] = cname then result := i;
end;

function TLLVMGenerator.IsClass(tname: String): Boolean;
begin
  result := self.ClassIndex(tname) >= 0;
end;

function TLLVMGenerator.ClassParent(cname: String): String;
var i: Integer;
begin
  result := '';
  i := self.ClassIndex(cname);
  if i >= 0 then result := self.ClassParents[i];
end;

function TLLVMGenerator.ClassHasMethod(cname, mname: String): Boolean;
var i: Integer;
begin
  result := false;
  i := self.ClassIndex(cname);
  if i < 0 then Exit;
  if self.StrContains(self.ClassMethodNames[i], ',' + mname + ',') then result := true;
end;

function TLLVMGenerator.ClassFieldCount(cname: String): Integer;
var i: Integer;
begin
  result := 0;
  i := self.ClassIndex(cname);
  if i < 0 then Exit;
  result := self.ClassFieldCountAt(i);
end;

// Build a class's flattened field/metadata from a (possibly nested type TTypeDecl)
// ClassDecl. Runs during Pass 2. Inherited fields/methods from the parent are
// copied first (so subclass instances include the parent's layout), then own
// fields/methods; overrides reuse the parent's vtable slot. Mirrors host
// buildClassInfo.
procedure TLLVMGenerator.MakeClassInfo(cname: String; cd: TClassDecl);
var
  j, m, mi: Integer;
  parentIdx: Integer;
  myci, k, kf, n: Integer;
  at: TArrayType;
  fslot: Integer;
  kylixVal, mapFlag: String;
  llvmT, kt, ekt: String;
  fld: TVarDecl;
  meth: TFunctionDecl;
begin
  // fresh entry — field tables are comma-strings: "Name1,Name2," per class
  // (same pattern as the method tables; Kylix has no nested arrays).
  append(self.ClassNames, cname);
  append(self.ClassEmittedFlags, false);
  append(self.ClassParents, cd.Parent);
  append(self.ClassFieldNames, '');
  append(self.ClassFieldTypes, '');
  append(self.ClassFieldKylix, '');
  append(self.ClassFieldElemKylix, '');
  append(self.ClassFieldMaps, '');
  append(self.ClassMethodNames, ',');
  append(self.ClassMethodRet, ',');
  append(self.ClassMethodDef, ',');
  append(self.ClassMethodIdx, ',');
  parentIdx := -1;
  if cd.Parent <> '' then parentIdx := self.ClassIndex(cd.Parent);
  myci := self.ClassIndex(cname);
  // copy inherited fields (index 0 = vtable ptr; fields start at 1)
  if parentIdx >= 0 then
  begin
    self.ClassFieldNames[myci] := self.ClassFieldNames[parentIdx];
    self.ClassFieldTypes[myci] := self.ClassFieldTypes[parentIdx];
    self.ClassFieldKylix[myci] := self.ClassFieldKylix[parentIdx];
    self.ClassFieldElemKylix[myci] := self.ClassFieldElemKylix[parentIdx];
    self.ClassFieldMaps[myci] := self.ClassFieldMaps[parentIdx];
    // v0.6.9 P4: flat registry — copy the parent's field entries (child table
    // is a superset; slots are identical). Snapshot Length first: append
    // inside the loop must not extend the scanned range.
    n := Length(self.FlCls);
    for kf := 0 to n - 1 do
    begin
      if self.FlCls[kf] = parentIdx then
      begin
        append(self.FlCls, myci);
        append(self.FlSlot, self.FlSlot[kf]);
        append(self.FlName, self.FlName[kf]);
        append(self.FlType, self.FlType[kf]);
        append(self.FlKylix, self.FlKylix[kf]);
        append(self.FlElem, self.FlElem[kf]);
        append(self.FlMap, self.FlMap[kf]);
      end;
    end;
  end;
  // own fields
  for j := 0 to Length(cd.Fields) - 1 do
  begin
    fld := cd.Fields[j];
    llvmT := 'i64';
    kt := self.TypeExprName(fld.VarType);
    ekt := '';
    if fld.VarType is TArrayType then
    begin
      at := fld.VarType as TArrayType;
      if at.Dynamic then llvmT := '{ ptr, i64, i64 }'
      else llvmT := self.LlvmTypeOfExpr(fld.VarType);
      // bake the array ELEMENT's Kylix type name (e.g. TDiagnostic) so
      // obj.Field[i] can resolve the receiver class for .Member / .Method
      ekt := self.TypeExprName(at.ElementType);
    end
    else if fld.VarType is TMapType then llvmT := 'ptr'
    else if fld.VarType <> nil then llvmT := self.LlvmTypeOfExpr(fld.VarType);
    if llvmT = 'variant' then llvmT := 'ptr';
    for m := 0 to Length(fld.Names) - 1 do
    begin
      kylixVal := kt;
      mapFlag := '0';
      if fld.VarType is TMapType then
      begin
        // map field: store the VALUE type name (e.g. TTokenType / Boolean /
        // String / array) so map reads can coerce (host mapValueKylixType
        // reads mt.ValueType — we bake it into the kylix table).
        kylixVal := self.TypeExprName((fld.VarType as TMapType).ValueType);
        mapFlag := '1';
      end;
      self.ClassFieldNames[myci] := self.ClassFieldNames[myci] + fld.Names[m] + ',';
      self.ClassFieldTypes[myci] := self.ClassFieldTypes[myci] + llvmT + ';';
      self.ClassFieldKylix[myci] := self.ClassFieldKylix[myci] + kylixVal + ',';
      self.ClassFieldElemKylix[myci] := self.ClassFieldElemKylix[myci] + ekt + ',';
      self.ClassFieldMaps[myci] := self.ClassFieldMaps[myci] + mapFlag + ',';
      // v0.6.9 P4: flat registry entry (slot = current field count)
      fslot := self.ClassFieldCountAt(myci);
      append(self.FlCls, myci);
      append(self.FlSlot, fslot);
      append(self.FlName, fld.Names[m]);
      append(self.FlType, llvmT);
      append(self.FlKylix, kylixVal);
      append(self.FlElem, ekt);
      append(self.FlMap, mapFlag);
    end;
  end;
  // methods: inherited first (vtable superset), then own; override reuses slot
  if parentIdx >= 0 then
  begin
    self.ClassMethodNames[myci] := self.ClassMethodNames[parentIdx];
    self.ClassMethodRet[myci] := self.ClassMethodRet[parentIdx];
    self.ClassMethodDef[myci] := self.ClassMethodDef[parentIdx];
    self.ClassMethodIdx[myci] := self.ClassMethodIdx[parentIdx];
    // v0.6.9 P4: flat registry — copy the parent's method entries (same slots)
    n := Length(self.VtCls);
    for k := 0 to n - 1 do
    begin
      if self.VtCls[k] = parentIdx then
      begin
        append(self.VtCls, myci);
        append(self.VtSlot, self.VtSlot[k]);
        append(self.VtName, self.VtName[k]);
        append(self.VtRet, self.VtRet[k]);
        append(self.VtDef, self.VtDef[k]);
      end;
    end;
  end;
  for j := 0 to Length(cd.Methods) - 1 do
  begin
    meth := cd.Methods[j];
    if self.StrContains(self.ClassMethodNames[myci], ',' + meth.Name + ',') then
    begin
      // override: update ret type + defining class at this slot
      mi := self.MethodIndex(myci, meth.Name);
      self.ClassMethodRet[myci] := self.ReplaceSlot(self.ClassMethodRet[myci], mi, self.ClassRetType(meth));
      self.ClassMethodDef[myci] := self.ReplaceSlot(self.ClassMethodDef[myci], mi, cname);
      // v0.6.9 P4: update the flat entry at the same slot
      for k := 0 to Length(self.VtCls) - 1 do
      begin
        if self.VtCls[k] = myci then
        begin
          if self.VtSlot[k] = mi then
          begin
            self.VtRet[k] := self.ClassRetType(meth);
            self.VtDef[k] := cname;
          end;
        end;
      end;
    end
    else
    begin
      // append: vtable idx = current method count
      mi := self.MethodCount(myci);
      self.ClassMethodNames[myci] := self.ClassMethodNames[myci] + meth.Name + ',';
      self.ClassMethodRet[myci] := self.ClassMethodRet[myci] + self.ClassRetType(meth) + ',';
      self.ClassMethodDef[myci] := self.ClassMethodDef[myci] + cname + ',';
      self.ClassMethodIdx[myci] := self.ClassMethodIdx[myci] + self.IntToStrS(mi) + ',';
      // v0.6.9 P4: flat registry entry
      append(self.VtCls, myci);
      append(self.VtSlot, mi);
      append(self.VtName, meth.Name);
      append(self.VtRet, self.ClassRetType(meth));
      append(self.VtDef, cname);
    end;
  end;
end;

function TLLVMGenerator.ClassRetType(meth: TFunctionDecl): String;
var rt, out2: String;
  i: Integer;
begin
  result := 'void';
  if meth.ReturnType <> nil then
  begin
    rt := self.LlvmTypeOfExpr(meth.ReturnType);
    // v0.6.9 P3: tuple/slice types ({ ptr, i64, i64 }) contain commas that
    // would split the comma-separated method table — escape commas to '|'.
    out2 := '';
    for i := 0 to Length(rt) - 1 do
    begin
      if rt[i:i+1] = ',' then out2 := out2 + '|'
      else out2 := out2 + rt[i:i+1];
    end;
    result := out2;
  end;
end;

// comma-str slot helpers — the vtable-related comma strings use a leading and
// trailing comma (e.g. ",Create,Get,"); these helpers split by index.
function TLLVMGenerator.MethodCount(ci: Integer): Integer;
var k: Integer;
begin
  // v0.6.9 P4: flat scan — the old char-at-a-time comma walk was O(M²) with
  // two slices per char and got called 1.4M times (1.3GB of garbage).
  result := 0;
  for k := 0 to Length(self.VtCls) - 1 do
  begin
    if self.VtCls[k] = ci then result := result + 1;
  end;
end;

function TLLVMGenerator.MethodIndex(ci: Integer; mname: String): Integer;
var k: Integer;
begin
  // v0.6.9 P4: flat scan (entries were copied from the parent at registration,
  // so inherited methods resolve without walking the chain).
  result := -1;
  EProg('MI enter vt=' + self.IntToStrS(Length(self.VtCls)) + ' mlen=' + self.IntToStrS(Length(mname)));
  for k := 0 to Length(self.VtCls) - 1 do
  begin
    if self.VtCls[k] = ci then
    begin
      if self.VtName[k] = mname then
      begin
        result := self.VtSlot[k];
        Exit;
      end;
    end;
  end;
end;

function TLLVMGenerator.ReplaceSlot(list: String; idx: Integer; newVal: String): String;
var k: Integer;
  s, out: String;
begin
  // split by comma (list has no leading comma — the ret/def strings don't)
  out := '';
  k := 0;
  s := list;
  while Length(s) > 0 do
  begin
    if s[0:1] = ',' then
    begin
      out := out + ',';
      s := s[1:Length(s)];
      k := k + 1;
    end
    else
    begin
      if k = idx then
      begin
        out := out + newVal;
        while (Length(s) > 0) and (s[0:1] <> ',') do s := s[1:Length(s)];
      end
      else
      begin
        out := out + s[0:1];
        s := s[1:Length(s)];
      end;
    end;
  end;
  result := out;
end;

// ---- array metadata (mirrors host arrayInfo) ----

function TLLVMGenerator.IsArrayVar(name: String): Boolean;
begin
  result := self.IndexOfStr(self.ArrNames, name) >= 0;
end;

function TLLVMGenerator.ArrInfoOf(name: String): Integer;
begin
  result := self.IndexOfStr(self.ArrNames, name);
end;

procedure TLLVMGenerator.RegisterArray(name: String; dyn: Boolean; elemT, elemK: String; size, lb: Integer);
begin
  append(self.ArrNames, name);
  append(self.ArrDynamic, dyn);
  append(self.ArrElem, elemT);
  append(self.ArrElemKylix, elemK);
  append(self.ArrSize, size);
  append(self.ArrLower, lb);
end;

// RegisterArrayFromType — register a dynamic/static array variable from its
// declared type expression.
procedure TLLVMGenerator.RegisterArrayFromType(name: String; vt: TExpression);
var
  at: TArrayType;
  size, lb: Integer;
  elemT, elemK: String;
begin
  if vt is TArrayType then
  begin
    at := vt as TArrayType;
    size := 1;
    lb := 0;
    if at.Size <> nil then size := self.EvalConstInt(at.Size);
    elemT := self.LlvmTypeOfExpr(at.ElementType);
    elemK := self.TypeExprName(at.ElementType);
    self.RegisterArray(name, at.Dynamic, elemT, elemK, size, lb);
  end;
end;

// EmitArrayIndex — arr[i] for a local/param dynamic or static array var.
// Mirrors host emitArrayIndex's local path.
function TLLVMGenerator.EmitArrayIndexLocal(name: String; idxExpr: TExpression; t: String): String;
var
  ai: Integer;
  idxReg, zeroIdx, dataPtrLoc, dataPtr, ptr, loaded: String;
begin
  ai := self.ArrInfoOf(name);
  idxReg := self.EmitExpr(idxExpr);
  zeroIdx := self.Tmp();
  if (self.ArrDynamic[ai] = false) and (self.ArrLower[ai] <> 0) then
    self.WriteLine('  ' + zeroIdx + ' = sub i64 ' + idxReg + ', ' + self.IntToStrS(self.ArrLower[ai]))
  else
    self.WriteLine('  ' + zeroIdx + ' = add i64 ' + idxReg + ', 0');
  if self.ArrDynamic[ai] then
  begin
    dataPtrLoc := self.Tmp();
    self.WriteLine('  ' + dataPtrLoc + ' = getelementptr inbounds { ptr, i64, i64 }, ptr ' + self.ArraySlot(name) + ', i32 0, i32 0');
    dataPtr := self.Tmp();
    self.WriteLine('  ' + dataPtr + ' = load ptr, ptr ' + dataPtrLoc);
    ptr := self.Tmp();
    self.WriteLine('  ' + ptr + ' = getelementptr inbounds ' + self.ArrElem[ai] + ', ptr ' + dataPtr + ', i64 ' + zeroIdx);
  end
  else
  begin
    ptr := self.Tmp();
    self.WriteLine('  ' + ptr + ' = getelementptr inbounds [' + self.IntToStrS(self.ArrSize[ai]) + ' x ' + self.ArrElem[ai] + '], ptr ' + self.ArraySlot(name) + ', i64 0, i64 ' + zeroIdx);
  end;
  // array-of-class element (e.g. local `var xs: array of TDiagnostic`) — report
  // the ELEMENT class name as LastType so a chained .Field/.Method resolves the
  // receiver (arr[i].Line). Non-class elements carry the LLVM type (i64/ptr).
  if self.IsClass(self.ArrElemKylix[ai]) then
    self.LastType := self.ArrElemKylix[ai]
  else
    self.LastType := self.ArrElem[ai];
  loaded := self.Tmp();
  self.WriteLine('  ' + loaded + ' = load ' + self.ArrElem[ai] + ', ptr ' + ptr);
  result := loaded;
end;

// ArraySlot — storage location of an array variable: local/param alloca when
// registered locally, else the main-program global (`@__kylix_g_<name>`).
function TLLVMGenerator.ArraySlot(name: String): String;
begin
  if name = 'Args' then
  begin
    result := '@__kylix_args';
    Exit;
  end;
  if self.HasLocal(name) then
    result := self.LocalReg(name)
  else if self.IndexOfStr(self.GNames, name) >= 0 then
    result := self.GReg(name)
  else
    result := '';
end;

// EmitArrayIndexStore — arr[i] := v (local array var).
procedure TLLVMGenerator.EmitArrayIndexStoreLocal(name: String; idxExpr, valExpr: TExpression);
var
  ai: Integer;
  idxReg, zeroIdx, dataPtrLoc, dataPtr, ptr, valReg: String;
begin
  ai := self.ArrInfoOf(name);
  idxReg := self.EmitExpr(idxExpr);
  zeroIdx := self.Tmp();
  if (self.ArrDynamic[ai] = false) and (self.ArrLower[ai] <> 0) then
    self.WriteLine('  ' + zeroIdx + ' = sub i64 ' + idxReg + ', ' + self.IntToStrS(self.ArrLower[ai]))
  else
    self.WriteLine('  ' + zeroIdx + ' = add i64 ' + idxReg + ', 0');
  if self.ArrDynamic[ai] then
  begin
    dataPtrLoc := self.Tmp();
    self.WriteLine('  ' + dataPtrLoc + ' = getelementptr inbounds { ptr, i64, i64 }, ptr ' + self.ArraySlot(name) + ', i32 0, i32 0');
    dataPtr := self.Tmp();
    self.WriteLine('  ' + dataPtr + ' = load ptr, ptr ' + dataPtrLoc);
    ptr := self.Tmp();
    self.WriteLine('  ' + ptr + ' = getelementptr inbounds ' + self.ArrElem[ai] + ', ptr ' + dataPtr + ', i64 ' + zeroIdx);
  end
  else
  begin
    ptr := self.Tmp();
    self.WriteLine('  ' + ptr + ' = getelementptr inbounds [' + self.IntToStrS(self.ArrSize[ai]) + ' x ' + self.ArrElem[ai] + '], ptr ' + self.ArraySlot(name) + ', i64 0, i64 ' + zeroIdx);
  end;
  valReg := self.EmitExprTyped(valExpr);
  self.ArrElem[ai] := self.LastType;
  self.WriteLine('  store ' + self.ArrElem[ai] + ' ' + valReg + ', ptr ' + ptr);
end;

// EmitAppend — append(slice, elem) → new {ptr,len,cap} slice (SSA value).
// Mirrors host emitAppend byte-for-byte (extractvalue + malloc + memcpy).
function TLLVMGenerator.EmitAppend(sliceArg, elemArg: TExpression): String;
var
  sliceVal, elemReg, elemT, dataPtr, oldLen, newLen, newSize, newData: String;
  oldBytes, elemSlot, s1, s2, s3: String;
begin
  sliceVal := self.EmitExprTyped(sliceArg);
  elemReg := self.EmitExprTyped(elemArg);
  elemT := self.LastType;
  if self.IsClass(elemT) then elemT := 'ptr';
  dataPtr := self.Tmp();
  self.WriteLine('  ' + dataPtr + ' = extractvalue { ptr, i64, i64 } ' + sliceVal + ', 0');
  oldLen := self.Tmp();
  self.WriteLine('  ' + oldLen + ' = extractvalue { ptr, i64, i64 } ' + sliceVal + ', 1');
  newLen := self.Tmp();
  self.WriteLine('  ' + newLen + ' = add i64 ' + oldLen + ', 1');
  newSize := self.Tmp();
  self.WriteLine('  ' + newSize + ' = mul i64 ' + newLen + ', 8');
  newData := self.Tmp();
  self.WriteLine('  ' + newData + ' = call ptr @malloc(i64 ' + newSize + ')');
  oldBytes := self.Tmp();
  self.WriteLine('  ' + oldBytes + ' = mul i64 ' + oldLen + ', 8');
  self.NeedMemcpy := true;
  self.WriteLine('  call ptr @memcpy(ptr ' + newData + ', ptr ' + dataPtr + ', i64 ' + oldBytes + ')');
  elemSlot := self.Tmp();
  self.WriteLine('  ' + elemSlot + ' = getelementptr inbounds ' + elemT + ', ptr ' + newData + ', i64 ' + oldLen);
  self.WriteLine('  store ' + elemT + ' ' + elemReg + ', ptr ' + elemSlot);
  s1 := self.Tmp();
  self.WriteLine('  ' + s1 + ' = insertvalue { ptr, i64, i64 } undef, ptr ' + newData + ', 0');
  s2 := self.Tmp();
  self.WriteLine('  ' + s2 + ' = insertvalue { ptr, i64, i64 } ' + s1 + ', i64 ' + newLen + ', 1');
  s3 := self.Tmp();
  self.WriteLine('  ' + s3 + ' = insertvalue { ptr, i64, i64 } ' + s2 + ', i64 ' + newLen + ', 2');
  result := s3;
end;

procedure TLLVMGenerator.EmitAppendStmt(sliceArg, elemArg: TExpression);
var
  newSlice, classT, selfReg, objReg, gep: String;
  ci, fi: Integer;
  mem: TMemberExpression;
begin
  newSlice := self.EmitAppend(sliceArg, elemArg);
  // v0.6.9 P3: statement-style `append(slice, elem)` is a mutating call — the
  // new slice must be stored back to the original variable/field. Without this,
  // `append(l.Items, d)` discards the result and l.Items stays {buf,0,0} →
  // later self.Items[i] reads the length slot as a ptr → segfault. Mirrors
  // host pkg/llvmgen/stmt.go.
  if sliceArg is TMemberExpression then
  begin
    mem := sliceArg as TMemberExpression;
    classT := '';
    if mem.Obj is TIdentifier then
    begin
      if (mem.Obj as TIdentifier).Value = 'self' then
        classT := self.CurClassName
      else
        classT := self.LocalKylix((mem.Obj as TIdentifier).Value);
      if classT = '' then classT := self.GKylix((mem.Obj as TIdentifier).Value);
    end;
    if self.IsClass(classT) then
    begin
      if mem.Obj is TIdentifier then
      begin
        if (mem.Obj as TIdentifier).Value = 'self' then
          selfReg := '%self'
        else
        begin
          if self.HasLocal((mem.Obj as TIdentifier).Value) then
          begin
            objReg := self.LocalReg((mem.Obj as TIdentifier).Value);
            selfReg := self.Tmp();
            self.WriteLine('  ' + selfReg + ' = load ptr, ptr ' + objReg);
          end
          else
          begin
            objReg := self.GReg((mem.Obj as TIdentifier).Value);
            selfReg := self.Tmp();
            self.WriteLine('  ' + selfReg + ' = load ptr, ptr ' + objReg);
          end;
        end;
      end
      else
        selfReg := self.EmitExpr(mem.Obj);
      ci := self.ClassIndex(classT);
      fi := self.FieldIndex(classT, mem.Member);
      if fi >= 0 then
      begin
        gep := self.Tmp();
        self.WriteLine('  ' + gep + ' = getelementptr inbounds %' + classT + ', ptr ' + selfReg + ', i32 0, i32 ' + self.IntToStrS(fi + 1));
        self.WriteLine('  store { ptr, i64, i64 } ' + newSlice + ', ptr ' + gep);
        Exit;
      end;
    end;
  end;
  if sliceArg is TIdentifier then
  begin
    if self.HasLocal((sliceArg as TIdentifier).Value) then
      self.WriteLine('  store { ptr, i64, i64 } ' + newSlice + ', ptr ' + self.LocalReg((sliceArg as TIdentifier).Value))
    else if self.IndexOfStr(self.GNames, (sliceArg as TIdentifier).Value) >= 0 then
      self.WriteLine('  store { ptr, i64, i64 } ' + newSlice + ', ptr ' + self.GReg((sliceArg as TIdentifier).Value));
  end;
end;

// ---- field/method lookup helpers (comma-string based, mirror host) ----

function TLLVMGenerator.ClassFieldCountAt(ci: Integer): Integer;
var k: Integer;
begin
  // v0.6.9 P4: flat scan (was char-at-a-time O(F²))
  result := 0;
  for k := 0 to Length(self.FlCls) - 1 do
  begin
    if self.FlCls[k] = ci then result := result + 1;
  end;
end;

function TLLVMGenerator.FieldIndex(cname, fname: String): Integer;
var ci, k: Integer;
begin
  // v0.6.9 P4: flat scan (was char-at-a-time O(F²) with two slices per char)
  result := -1;
  ci := self.ClassIndex(cname);
  if ci < 0 then Exit;
  for k := 0 to Length(self.FlCls) - 1 do
  begin
    if self.FlCls[k] = ci then
    begin
      if self.FlName[k] = fname then
      begin
        result := self.FlSlot[k];
        Exit;
      end;
    end;
  end;
end;

function TLLVMGenerator.FieldIdxOf(cname, fname: String): Integer;
begin
  result := self.FieldIndex(cname, fname) + 1; // offset 0 = vtable ptr
end;

function TLLVMGenerator.FieldLLVM(cname, fname: String): String;
var ci, k: Integer;
begin
  // v0.6.9 P4: flat scan (was O(F²) via FieldNameAt per candidate)
  result := 'i64';
  ci := self.ClassIndex(cname);
  if ci < 0 then Exit;
  for k := 0 to Length(self.FlCls) - 1 do
  begin
    if self.FlCls[k] = ci then
    begin
      if self.FlName[k] = fname then
      begin
        result := self.FlType[k];
        Exit;
      end;
    end;
  end;
end;

function TLLVMGenerator.FieldNameAt(ci, fi: Integer): String;
var k: Integer;
begin
  // v0.6.9 P4: flat scan
  result := '';
  for k := 0 to Length(self.FlCls) - 1 do
  begin
    if self.FlCls[k] = ci then
    begin
      if self.FlSlot[k] = fi then
      begin
        result := self.FlName[k];
        Exit;
      end;
    end;
  end;
end;


function TLLVMGenerator.FieldKylixAt(ci, fi: Integer): String;
var k: Integer;
begin
  // v0.6.9 P4: flat scan
  result := '';
  for k := 0 to Length(self.FlCls) - 1 do
  begin
    if self.FlCls[k] = ci then
    begin
      if self.FlSlot[k] = fi then
      begin
        result := self.FlKylix[k];
        Exit;
      end;
    end;
  end;
end;

function TLLVMGenerator.FieldElemKylixAt(ci, fi: Integer): String;
var k: Integer;
begin
  // v0.6.9 P4: flat scan
  result := '';
  for k := 0 to Length(self.FlCls) - 1 do
  begin
    if self.FlCls[k] = ci then
    begin
      if self.FlSlot[k] = fi then
      begin
        result := self.FlElem[k];
        Exit;
      end;
    end;
  end;
end;

function TLLVMGenerator.FieldTypeAt(ci, fi: Integer): String;
var k: Integer;
begin
  // v0.6.9 P4: flat scan (was char-at-a-time O(F²) with two slices per char)
  result := '';
  for k := 0 to Length(self.FlCls) - 1 do
  begin
    if self.FlCls[k] = ci then
    begin
      if self.FlSlot[k] = fi then
      begin
        result := self.FlType[k];
        Exit;
      end;
    end;
  end;
end;

function TLLVMGenerator.FieldMapAt(ci, fi: Integer): Boolean;
var k: Integer;
begin
  // v0.6.9 P4: flat scan
  result := false;
  for k := 0 to Length(self.FlCls) - 1 do
  begin
    if self.FlCls[k] = ci then
    begin
      if self.FlSlot[k] = fi then
      begin
        if self.FlMap[k] = '1' then result := true;
        Exit;
      end;
    end;
  end;
end;

function TLLVMGenerator.GKylix(name: String): String;
var i: Integer;
begin
  result := '';
  i := self.IndexOfStr(self.GNames, name);
  if i >= 0 then result := self.GKylixs[i];
end;

function TLLVMGenerator.MethodRetAt(ci, mi: Integer): String;
var k: Integer;
begin
  // v0.6.9 P4: flat scan. VtRet stores the ESCAPED ret (',' → '|') — unescape.
  result := 'void';
  for k := 0 to Length(self.VtCls) - 1 do
  begin
    if self.VtCls[k] = ci then
    begin
      if self.VtSlot[k] = mi then
      begin
        result := self.UnescapePipe(self.VtRet[k]);
        Exit;
      end;
    end;
  end;
end;

function TLLVMGenerator.MethodNameAt(ci, mi: Integer): String;
var k: Integer;
begin
  // v0.6.9 P4: flat scan
  result := '';
  for k := 0 to Length(self.VtCls) - 1 do
  begin
    if self.VtCls[k] = ci then
    begin
      if self.VtSlot[k] = mi then
      begin
        result := self.VtName[k];
        Exit;
      end;
    end;
  end;
end;

function TLLVMGenerator.DefClassAt(ci, mi: Integer): String;
var k: Integer;
begin
  // v0.6.9 P4: flat scan
  result := '';
  for k := 0 to Length(self.VtCls) - 1 do
  begin
    if self.VtCls[k] = ci then
    begin
      if self.VtSlot[k] = mi then
      begin
        result := self.VtDef[k];
        Exit;
      end;
    end;
  end;
end;

function TLLVMGenerator.MethodIndexAt(ci, mi: Integer): Integer;
var k: Integer;
begin
  // v0.6.9 P4: flat scan — the stored vtable idx IS the slot
  result := -1;
  for k := 0 to Length(self.VtCls) - 1 do
  begin
    if self.VtCls[k] = ci then
    begin
      if self.VtSlot[k] = mi then
      begin
        result := self.VtSlot[k];
        Exit;
      end;
    end;
  end;
end;

// KylixTToLLVM — LLVM scalar type for a Kylix element type name (used for
// dynamic array element stores; Boolean arrays hold i1 elements, not ptr).
function TLLVMGenerator.KylixTToLLVM(k: String): String;
var lo: String;
begin
  lo := LowerCase(k);
  if (lo = 'boolean') or (lo = 'bool') then result := 'i1'
  else if (lo = 'integer') or (lo = 'int64') or (lo = 'int') or (lo = 'longint') then result := 'i64'
  else if (lo = 'real') or (lo = 'double') or (lo = 'float') then result := 'double'
  else result := 'ptr';
end;

// EmitRecordResultInit — heap-allocate a zeroed record for a `result` slot
// whose function returns a record by value. `result.Field := x` GEPs through
// this pointer; without it the slot holds garbage (ReadNumber SEGV, x8=0x53b).
// No-op when retKylix is not a record.
procedure TLLVMGenerator.EmitRecordResultInit(retKylix: String);
var ci, i, size: Integer;
  ft, rec: String;
begin
  if self.IsRecordType(retKylix) = false then Exit;
  ci := self.ClassIndex(retKylix);
  size := 8;
  for i := 0 to self.ClassFieldCountAt(ci) - 1 do
  begin
    ft := self.FieldTypeAt(ci, i);
    size := size + self.LlvmTypeSize(ft);
  end;
  rec := self.Tmp();
  self.WriteLine('  ' + rec + ' = call ptr @calloc(i64 1, i64 ' + self.IntToStrS(size) + ')');
  self.WriteLine('  store ptr ' + rec + ', ptr %result');
end;

// UnescapePipe — restore ',' from the '|' escapes ClassRetType baked (flat
// registry keeps the escaped form so tuple ret types stay one token).
function TLLVMGenerator.UnescapePipe(s: String): String;
var i: Integer;
  out2: String;
begin
  out2 := '';
  for i := 0 to Length(s) - 1 do
  begin
    if s[i:i+1] = '|' then out2 := out2 + ','
    else out2 := out2 + s[i:i+1];
  end;
  result := out2;
end;

// EvalDec parses a decimal string to an Integer (the only int parsing helper
// that does not depend on StrToInt — the emitter avoids needing it at emit
// time since vtable indices are small constants).
function TLLVMGenerator.EvalDec(s: String): Integer;
var
  v, i, d: Integer;
begin
  v := 0;
  for i := 0 to Length(s) - 1 do
  begin
    if (s[i:i+1] >= '0') and (s[i:i+1] <= '9') then
    begin
      d := Ord(s[i:i+1]) - 48;
      v := v * 10 + d;
    end;
  end;
  result := v;
end;

// EmitConstructor — allocate a class instance: malloc(8 + Σfield sizes),
// store the vtable ptr at [0], zero-init map/slice fields, call Create if
// present. Mirrors host emitConstructor.
function TLLVMGenerator.EmitConstructor(cname: String): String;
var
  ci, i, size: Integer;
  allocReg, vtablePtr, slot, tbl, r: String;
  hasCreate: Boolean;
  ctypes: array of String;
  cfmaps: array of Boolean;
begin
  ci := self.ClassIndex(cname);
  if ci < 0 then
  begin
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = inttoptr i64 0 to ptr ; unknown class ' + cname);
    result := r;
    Exit;
  end;
  size := 8;
  ctypes := [];
  for i := 0 to self.ClassFieldCountAt(ci) - 1 do
    append(ctypes, self.FieldTypeAt(ci,i));
  for i := 0 to Length(ctypes) - 1 do
  begin
    if ctypes[i] = '{ ptr, i64, i64 }' then size := size + 24
    else if ctypes[i] = 'double' then size := size + 8
    else size := size + 8;
  end;
  allocReg := self.Tmp();
  // v0.6.9 P3: calloc (zero-filled) instead of malloc — pointer fields
  // (TParser.CurToken etc.) were left as garbage and dereferenced before
  // their first assignment crashed the emitted compiler.
  self.WriteLine('  ' + allocReg + ' = call ptr @calloc(i64 1, i64 ' + self.IntToStrS(size) + ')');
  vtablePtr := self.Tmp();
  self.WriteLine('  ' + vtablePtr + ' = getelementptr inbounds %' + cname + ', ptr ' + allocReg + ', i32 0, i32 0');
  self.WriteLine('  store ptr @' + cname + '_vtable, ptr ' + vtablePtr);
  // map fields → htab_new; dynamic slice fields → zero
  cfmaps := [];
  for i := 0 to self.ClassFieldCountAt(ci) - 1 do
    append(cfmaps, self.FieldMapAt(ci,i));
  ctypes := [];
  for i := 0 to self.ClassFieldCountAt(ci) - 1 do
    append(ctypes, self.FieldTypeAt(ci,i));
  for i := 0 to Length(ctypes) - 1 do
  begin
    if cfmaps[i] then
    begin
      self.NeedHashtab := true;
      slot := self.Tmp();
      self.WriteLine('  ' + slot + ' = getelementptr inbounds %' + cname + ', ptr ' + allocReg + ', i32 0, i32 ' + self.IntToStrS(i + 1));
      tbl := self.Tmp();
      self.WriteLine('  ' + tbl + ' = call ptr @__kylix_htab_new()');
      self.WriteLine('  store ptr ' + tbl + ', ptr ' + slot);
    end
    else if ctypes[i] = '{ ptr, i64, i64 }' then
    begin
      slot := self.Tmp();
      self.WriteLine('  ' + slot + ' = getelementptr inbounds %' + cname + ', ptr ' + allocReg + ', i32 0, i32 ' + self.IntToStrS(i + 1));
      self.WriteLine('  store { ptr, i64, i64 } zeroinitializer, ptr ' + slot);
    end;
  end;
  // call Create if the class (or an ancestor) declares it
  hasCreate := self.ClassHasMethod(cname, 'Create');
  if hasCreate then
    self.WriteLine('  call void @' + cname + '_Create(ptr ' + allocReg + ')');
  result := allocReg;
end;

function TLLVMGenerator.EmitMember(member: TMemberExpression; t: String): String;
var
  r, selfReg, objReg, classT, loaded: String;
  ci, idx, fi: Integer;
begin
  EProg('MEM ' + member.Member);
  // Constructor pattern: TFoo.Create — fresh heap-allocated instance.
  if member.Member = 'Create' then
  begin
    if member.Obj is TIdentifier then
    begin
      idx := self.ClassIndex((member.Obj as TIdentifier).Value);
      if idx >= 0 then
      begin
        self.MemberType := 'ptr';
        self.LastType := 'ptr';
        result := self.EmitConstructor((member.Obj as TIdentifier).Value);
        Exit;
      end;
    end;
  end;
  // resolve receiver's class (self / local / global class-typed variable)
  classT := '';
  // v0.6.9 P4 DBG: report receiver resolution for member reads
  if member.Obj is TIdentifier then
  begin
    EProg('MEMOBJ ' + member.Member + ' recv=' + (member.Obj as TIdentifier).Value + ' lk=' + self.LocalKylix((member.Obj as TIdentifier).Value));
  end;
  if member.Obj is TIdentifier then
  begin
    if (member.Obj as TIdentifier).Value = 'self' then
      classT := self.CurClassName
    else
      classT := self.LocalKylix((member.Obj as TIdentifier).Value);
    if classT = '' then classT := self.GKylix((member.Obj as TIdentifier).Value);
  end
  else if member.Obj is TIndexExpression then
  begin
    // arr[i].Field — the element is a class-typed array entry (e.g.
    // self.Errors[i].Line). EmitExpr on the index already loaded the element
    // ptr and set LastType to the ELEMENT class name (see
    // TryClassFieldArrayIndex / EmitArrayIndexLocal); resolve the field from
    // that class and treat the loaded ptr as the receiver.
    selfReg := self.EmitExpr(member.Obj);
    if self.IsClass(self.LastType) then
    begin
      classT := self.LastType;
      ci := self.ClassIndex(classT);
      fi := self.FieldIndex(classT, member.Member);
      if fi >= 0 then
      begin
        r := self.Tmp();
        self.WriteLine('  ' + r + ' = getelementptr inbounds %' + classT + ', ptr ' + selfReg + ', i32 0, i32 ' + self.IntToStrS(self.FieldIdxOf(classT, member.Member)));
        self.MemberType := self.FieldLLVM(classT, member.Member);
        if self.MemberType = 'variant' then self.MemberType := 'ptr';
        loaded := self.Tmp();
        self.WriteLine('  ' + loaded + ' = load ' + self.MemberType + ', ptr ' + r);
        // chained member: same LastType policy as the field branch above
        if self.IsClass(self.FieldKylixAt(ci, fi)) then
          self.LastType := self.FieldKylixAt(ci, fi)
        else
          self.LastType := self.MemberType;
        result := loaded;
        Exit;
      end;
    end
  end
  else if member.Obj is TMemberExpression then
  begin
    // v0.6.9 P3: chained member a.b.C (e.g. self.PeekToken.TokenType) —
    // emit the inner chain; its LastType reports the inner field's class
    // name, and its register is the receiver for this field's GEP.
    selfReg := self.EmitExpr(member.Obj);
    if self.IsClass(self.LastType) then
    begin
      classT := self.LastType;
      ci := self.ClassIndex(classT);
      fi := self.FieldIndex(classT, member.Member);
      if fi >= 0 then
      begin
        r := self.Tmp();
        self.WriteLine('  ' + r + ' = getelementptr inbounds %' + classT + ', ptr ' + selfReg + ', i32 0, i32 ' + self.IntToStrS(self.FieldIdxOf(classT, member.Member)));
        self.MemberType := self.FieldLLVM(classT, member.Member);
        if self.MemberType = 'variant' then self.MemberType := 'ptr';
        loaded := self.Tmp();
        self.WriteLine('  ' + loaded + ' = load ' + self.MemberType + ', ptr ' + r);
        if self.IsClass(self.FieldKylixAt(ci, fi)) then
          self.LastType := self.FieldKylixAt(ci, fi)
        else
          self.LastType := self.MemberType;
        result := loaded;
        Exit;
      end;
    end;
  end
  else if member.Obj is TTypeCastExpression then
  begin
    // v0.6.9 P4: `(decl as TFunctionDecl).Body` — the cast reports its target
    // class via LastType (EmitAsExpr); emit the receiver once here and fall
    // through to the normal field-read path below.
    selfReg := self.EmitExpr(member.Obj);
    if self.IsClass(self.LastType) then classT := self.LastType;
  end;
  EProg('CHK ' + classT + ' ci=' + self.IntToStrS(self.ClassIndex(classT)) + ' cn=' + self.IntToStrS(Length(self.ClassNames)));
  if self.IsClass(classT) then
  begin
    if member.Obj is TIdentifier then
    begin
      if (member.Obj as TIdentifier).Value = 'self' then
        selfReg := '%self'
      else
      begin
        if self.HasLocal((member.Obj as TIdentifier).Value) then
        begin
          objReg := self.LocalReg((member.Obj as TIdentifier).Value);
          selfReg := self.Tmp();
          self.WriteLine('  ' + selfReg + ' = load ptr, ptr ' + objReg);
        end
        else
        begin
          objReg := self.GReg((member.Obj as TIdentifier).Value);
          selfReg := self.Tmp();
          self.WriteLine('  ' + selfReg + ' = load ptr, ptr ' + objReg);
        end;
      end;
    end
    else
    begin
      // e.g. member chain a.b.C
      selfReg := self.EmitExpr(member.Obj);
    end;
    ci := self.ClassIndex(classT);
    fi := self.FieldIndex(classT, member.Member);
    EProg('FIELD ' + classT + '.' + member.Member + ' fi=' + self.IntToStrS(fi));
    if fi >= 0 then
    begin
      r := self.Tmp();
      self.WriteLine('  ' + r + ' = getelementptr inbounds %' + classT + ', ptr ' + selfReg + ', i32 0, i32 ' + self.IntToStrS(self.FieldIdxOf(classT, member.Member)));
      self.MemberType := self.FieldLLVM(classT, member.Member);
      if self.MemberType = 'variant' then self.MemberType := 'ptr';
      loaded := self.Tmp();
      self.WriteLine('  ' + loaded + ' = load ' + self.MemberType + ', ptr ' + r);
      // chained member: if the field's Kylix type is a class/record, report it
      // as LastType so a subsequent .Field / .Method resolves the receiver.
      if self.IsClass(self.FieldKylixAt(ci, fi)) then
        self.LastType := self.FieldKylixAt(ci, fi)
      else
        self.LastType := self.MemberType;
      result := loaded;
      Exit;
    end;
  end;
  // v0.6.9 P3: bare method statement `self.Foo;` (no parens) routes here as
  // a member read — if the name is a zero-arg METHOD, call it instead.
  if self.IsClass(classT) then
  begin
    ci := self.ClassIndex(classT);
    fi := self.MethodIndex(ci, member.Member);
    if fi >= 0 then
    begin
      selfReg := '%self';
      methT := self.MethodRetAt(ci, fi);
      if methT = 'variant' then methT := 'ptr';
      if methT = 'void' then
      begin
        vtableGEP := self.Tmp();
        self.WriteLine('  ' + vtableGEP + ' = getelementptr inbounds %' + classT + ', ptr %self, i32 0, i32 0');
        vtablePtr := self.Tmp();
        self.WriteLine('  ' + vtablePtr + ' = load ptr, ptr ' + vtableGEP);
        fnPtrLoc := self.Tmp();
        self.WriteLine('  ' + fnPtrLoc + ' = getelementptr inbounds [' + self.IntToStrS(self.MethodCount(ci)) + ' x ptr], ptr ' + vtablePtr + ', i32 0, i32 ' + self.IntToStrS(fi));
        fnPtr := self.Tmp();
        self.WriteLine('  ' + fnPtr + ' = load ptr, ptr ' + fnPtrLoc);
        self.WriteLine('  call void ' + fnPtr + '(ptr %self)');
        r := self.Tmp();
        self.WriteLine('  ' + r + ' = add i64 0, 0 ; void call');
        self.MemberType := 'i64';
        self.LastType := 'i64';
        result := r;
        Exit;
      end;
    end;
  end;
  // not a class field — P3 stub (unsupported member)
  self.MemberType := 'ptr';
  self.LastType := 'ptr';
  r := self.Tmp();
  self.WriteLine('  ' + r + ' = inttoptr i64 0 to ptr ; member ' + member.Member + ' (unhandled)');
  result := r;
end;

function TLLVMGenerator.EmitMethodCallWithArgs(member: TMemberExpression; margs: array of TExpression; t: String): String;
var
  r, objReg, selfReg, classT, methT, fnPtr: String;
  ci, fi: Integer;
  extFn: String;
  vtablePtr, fnPtrLoc, vtableGEP, argList, argReg: String;
  objName: String;
  nargs: Integer;
  mm: String;
begin
  // v0.6.9 P4: emit recursion circuit breaker. A corrupted/garbage AST node
  // can make the emitter re-emit the same call from inside its own emission
  // (observed: self.TypeExprName infinitely re-entering) — each level mallocs
  // the full call IR → the 6-9GB self-emit OOM. Statements reset the depth,
  // so a single statement's legitimate call nesting stays far below this.
  self.EmitDepth := self.EmitDepth + 1;
  if self.EmitDepth > 128 then
  begin
    EProg('DEPTH-CUT at ' + member.Member);
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = add i64 0, 0 ; emit depth cut');
    self.MemberType := 'i64';
    self.EmitDepth := self.EmitDepth - 1;
    result := r;
    Exit;
  end;
  // v0.6.9 P4 DBG: stderr probe for runaway argument lists
  if Length(margs) > 16 then
  begin
    EProg('DBGMCWA n=' + self.IntToStrS(Length(margs)));
  end;
  EProg('MCWA ' + member.Member);
  // Constructor with args: TFoo.Create(...) — allocate + (P2: init).
  if member.Member = 'Create' then
  begin
    if member.Obj is TIdentifier then
    begin
      ci := self.ClassIndex((member.Obj as TIdentifier).Value);
      if ci >= 0 then
      begin
        self.MemberType := 'ptr';
        result := self.EmitConstructor((member.Obj as TIdentifier).Value);
        Exit;
      end;
    end;
  end;
  classT := '';
  if member.Obj is TIdentifier then
  begin
    if (member.Obj as TIdentifier).Value = 'self' then
      classT := self.CurClassName
    else
      classT := self.LocalKylix((member.Obj as TIdentifier).Value);
    if classT = '' then classT := self.GKylix((member.Obj as TIdentifier).Value);
  end
  else if member.Obj is TMemberExpression then
  begin
    // v0.6.9 P3: chained receiver `self.Lex.NextToken()` — emit the inner
    // member chain; its LastType reports the receiver's class name.
    selfReg := self.EmitExpr(member.Obj);
    classT := self.LastType;
  end
  else if member.Obj is TTypeCastExpression then
  begin
    // v0.6.9 P4: `(decl as TFunctionDecl).Body` — the cast reports its target
    // class via LastType (EmitAsExpr); emit the receiver once here.
    selfReg := self.EmitExpr(member.Obj);
    if self.IsClass(self.LastType) then classT := self.LastType;
  end;
  if not self.IsClass(classT) then
  begin
    // v0.6.9 P3: stdlib wrapper classes (TCache / THttpClient) are not user
    // classes — dispatch their methods to the baked IR segments.
    r := self.TryStdlibMethodCall(classT, member.Member, member.Obj, margs);
    if r <> '' then
    begin
      self.MemberType := self.LastType;
      result := r;
      Exit;
    end;
    // receiver expression's type unknown here (e.g. chained) — P3 stub
    self.MemberType := 'i64';
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = add i64 0, 0 ; method call (unhandled receiver)');
    result := r;
    Exit;
  end;
  if member.Obj is TIdentifier then
  begin
    if (member.Obj as TIdentifier).Value = 'self' then
        selfReg := '%self'
    else
    begin
      // v0.6.9 P4 DBG: trap runaway strings feeding the receiver load
      objName := (member.Obj as TIdentifier).Value;
      if Length(objName) > 128 then
      begin
        self.WriteLine('  ; DBG huge-ident len=' + self.IntToStrS(Length(objName)));
        objName := 'SEGBIG';
      end;
      if self.HasLocal(objName) then
      begin
        objReg := self.LocalReg(objName);
        selfReg := self.Tmp();
        if Length(selfReg) > 128 then
        begin
          self.WriteLine('  ; DBG huge-selfreg-load len=' + self.IntToStrS(Length(selfReg)));
          selfReg := '%dbg';
        end;
        self.WriteLine('  ' + selfReg + ' = load ptr, ptr ' + objReg);
      end
      else
      begin
        objReg := self.GReg(objName);
        selfReg := self.Tmp();
        if Length(selfReg) > 128 then
        begin
          self.WriteLine('  ; DBG huge-selfreg-load len=' + self.IntToStrS(Length(selfReg)));
          selfReg := '%dbg';
        end;
        self.WriteLine('  ' + selfReg + ' = load ptr, ptr ' + objReg);
      end;
    end;
  end
  else if member.Obj is TMemberExpression then
  begin
    // v0.6.9 P3: chained receiver already emitted in the classT resolution
    // above — selfReg holds the receiver register, do not emit twice.
  end
  else if member.Obj is TTypeCastExpression then
  begin
    // v0.6.9 P4: already emitted in the classT resolution above.
  end
  else
    selfReg := self.EmitExpr(member.Obj);
  // method metadata
  ci := self.ClassIndex(classT);
  fi := self.MethodIndex(ci, member.Member);
  if fi < 0 then
  begin
    // v0.6.9 P3: dot-name external methods (@Class_Method, emitted by
    // EmitFunctionDecl with a leading self) take self + args directly;
    // annotation-generated methods (IsValid on [Required] entities) stub true.
    extFn := classT + '_' + member.Member;
    if self.IndexOfStr(self.FNames, extFn) >= 0 then
    begin
      argList := 'ptr ' + selfReg;
  if Length(selfReg) > 128 then
  begin
    self.WriteLine('  ; DBG huge-selfreg2 len=' + self.IntToStrS(Length(selfReg)));
    selfReg := '%dbg';
    argList := 'ptr %dbg';
  end;
      if Length(selfReg) > 128 then
      begin
        self.WriteLine('  ; DBG huge-selfreg2 len=' + self.IntToStrS(Length(selfReg)));
        selfReg := '%dbg';
        argList := 'ptr %dbg';
      end;
      nargs := Length(margs);
      if nargs > 32 then
      begin
        self.WriteLine('  ; DBG huge-margs len=' + self.IntToStrS(nargs));
        nargs := 32;
      end;
      for i := 0 to nargs - 1 do
      begin
        argReg := self.EmitExprTyped(margs[i]);
        if Length(argReg) > 128 then
        begin
          self.WriteLine('  ; DBG huge-argreg len=' + self.IntToStrS(Length(argReg)));
          argReg := '%dbg';
        end;
        // v0.6.9 P4: normalize LastType — a class-field read reports the
        // field's KYLIX class name (e.g. 'TExpression'), which is not an LLVM
        // type; class args pass as ptr.
        if self.IsClass(self.LastType) then
          argList := argList + ', ptr ' + argReg
        else
          argList := argList + ', ' + self.LastType + ' ' + argReg;
        if Length(argList) > 2048 then
        begin
          self.WriteLine('  ; DBG arglist-capped-ext len=' + self.IntToStrS(Length(argList)) + ' i=' + self.IntToStrS(i));
          argList := 'ptr %self';
        end;
      end;
      methT := self.FRet[self.IndexOfStr(self.FNames, extFn)];
      if methT = '' then methT := 'i64';
      if Length(argList) > 512 then
      begin
        self.WriteLine('  ; DBG huge-arglist-ext len=' + self.IntToStrS(Length(argList)));
        argList := 'ptr %self';
      end;
      if methT = 'void' then
      begin
        self.WriteLine('  call void @' + extFn + '(' + argList + ')');
        r := self.Tmp();
        self.WriteLine('  ' + r + ' = add i64 0, 0 ; void call');
        self.MemberType := 'i64';
        result := r;
        Exit;
      end;
      r := self.Tmp();
      self.WriteLine('  ' + r + ' = call ' + methT + ' @' + extFn + '(' + argList + ')');
      self.MemberType := methT;
      result := r;
      Exit;
    end;
    r := self.Tmp();
    mm := member.Member;
    if Length(mm) > 128 then
    begin
      self.WriteLine('  ; DBG huge-member len=' + self.IntToStrS(Length(mm)) + ' head=' + mm[0:80]);
      mm := 'SEGBIG';
    end;
    self.WriteLine('  ' + r + ' = add i1 1, 0 ; method ' + mm + ' not emitted (stub true)');
    self.MemberType := 'i1';
    result := r;
    Exit;
  end;
  methT := self.MethodRetAt(ci, fi);
  if methT = 'variant' then methT := 'ptr';
  // v0.6.9 P4 DBG: catch whichever operand is a runaway (garbage) string
  if Length(selfReg) > 128 then
  begin
    self.WriteLine('  ; DBG huge-selfreg len=' + self.IntToStrS(Length(selfReg)));
    selfReg := '%dbg';
  end;
  if Length(methT) > 128 then
  begin
    self.WriteLine('  ; DBG huge-metht len=' + self.IntToStrS(Length(methT)));
    methT := 'i64';
  end;
  // load vtable ptr from struct[0]
  vtableGEP := self.Tmp();
  self.WriteLine('  ' + vtableGEP + ' = getelementptr inbounds %' + classT + ', ptr ' + selfReg + ', i32 0, i32 0');
  vtablePtr := self.Tmp();
  self.WriteLine('  ' + vtablePtr + ' = load ptr, ptr ' + vtableGEP);
  fnPtrLoc := self.Tmp();
  self.WriteLine('  ' + fnPtrLoc + ' = getelementptr inbounds [' + self.IntToStrS(self.MethodCount(ci)) + ' x ptr], ptr ' + vtablePtr + ', i32 0, i32 ' + self.IntToStrS(fi));
  fnPtr := self.Tmp();
  self.WriteLine('  ' + fnPtr + ' = load ptr, ptr ' + fnPtrLoc);
  // call via function pointer (self + args)
  r := self.Tmp();
  argList := 'ptr ' + selfReg;
  nargs := Length(margs);
  if nargs > 32 then
  begin
    self.WriteLine('  ; DBG huge-margs len=' + self.IntToStrS(nargs));
    nargs := 32;
  end;
  for i := 0 to nargs - 1 do
  begin
    if i > 32 then
    begin
      self.WriteLine('  ; DBG margs-runaway len=' + self.IntToStrS(Length(margs)) + ' i=' + self.IntToStrS(i));
      break;
    end;
    argReg := self.EmitExprTyped(margs[i]);
    if Length(argReg) > 128 then
    begin
      self.WriteLine('  ; DBG huge-argreg len=' + self.IntToStrS(Length(argReg)));
      argReg := '%dbg';
    end;
    if self.LastType = 'ptr' then argList := argList + ', ptr ' + argReg
    else if self.LastType = 'i1' then argList := argList + ', i1 ' + argReg
    else if self.LastType = 'double' then argList := argList + ', double ' + argReg
    else if self.LastType = '{ ptr, i64, i64 }' then argList := argList + ', { ptr, i64, i64 } ' + argReg
    else if self.IsClass(self.LastType) then argList := argList + ', ptr ' + argReg
    else argList := argList + ', i64 ' + argReg;
    if Length(argList) > 2048 then
    begin
      self.WriteLine('  ; DBG arglist-capped-vt len=' + self.IntToStrS(Length(argList)) + ' i=' + self.IntToStrS(i));
      argList := 'ptr %self';
    end;
  end;
  if Length(argList) > 512 then
  begin
    self.WriteLine('  ; DBG huge-arglist-vt len=' + self.IntToStrS(Length(argList)));
    argList := 'ptr %self';
  end;
  if methT = 'void' then
    self.WriteLine('  call void ' + fnPtr + '(' + argList + ')')
  else
    self.WriteLine('  ' + r + ' = call ' + methT + ' ' + fnPtr + '(' + argList + ')');
  if methT = 'void' then
  begin
    self.MemberType := 'void';
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = add i64 0, 0 ; void call');
    result := r;
  end
  else
  begin
    self.MemberType := methT;
    result := r;
  end;
end;

function TLLVMGenerator.EmitIsExpr(e: TIsExpression; t: String): String;
var
  r, selfReg, objReg, classT, target: String;
  nullCk, trueLbl, falseLbl, exitLbl, objVT, trueR, falseR: String;
begin
  self.LastType := 'i1';
  target := self.TypeExprName(e.TargetType);
  // class target → runtime subtype check via vtable edge table
  if self.IsClass(target) then
  begin
    classT := '';
    if e.Expression is TIdentifier then
    begin
      if (e.Expression as TIdentifier).Value = 'self' then
        classT := self.CurClassName
      else
        classT := self.LocalKylix((e.Expression as TIdentifier).Value);
      if classT = '' then classT := self.GKylix((e.Expression as TIdentifier).Value);
    end;
    // resolve the object pointer (self / local / global class-typed variable)
    if e.Expression is TIdentifier then
    begin
      if (e.Expression as TIdentifier).Value = 'self' then
        selfReg := '%self'
      else
      begin
        if self.HasLocal((e.Expression as TIdentifier).Value) then
        begin
          objReg := self.LocalReg((e.Expression as TIdentifier).Value);
          selfReg := self.Tmp();
          self.WriteLine('  ' + selfReg + ' = load ptr, ptr ' + objReg);
        end
        else if self.IndexOfStr(self.GNames, (e.Expression as TIdentifier).Value) >= 0 then
        begin
          objReg := self.GReg((e.Expression as TIdentifier).Value);
          selfReg := self.Tmp();
          self.WriteLine('  ' + selfReg + ' = load ptr, ptr ' + objReg);
        end
        else
          selfReg := self.EmitExpr(e.Expression);
      end;
    end
    else
      selfReg := self.EmitExpr(e.Expression);
    // null guard → false
    nullCk := self.Tmp();
    self.WriteLine('  ' + nullCk + ' = icmp eq ptr ' + selfReg + ', null');
    trueLbl := self.Label();
    falseLbl := self.Label();
    exitLbl := self.Label();
    self.WriteLine('  br i1 ' + nullCk + ', label %' + falseLbl + ', label %' + trueLbl);
    self.WriteLine(trueLbl + ':');
    objVT := self.Tmp();
    self.WriteLine('  ' + objVT + ' = load ptr, ptr ' + selfReg);
    trueR := self.Tmp();
    self.WriteLine('  ' + trueR + ' = call i1 @__kylix_class_is_a(ptr ' + objVT + ', ptr @' + target + '_vtable)');
    self.NeedClassRTTI := true;
    self.WriteLine('  br label %' + exitLbl);
    self.WriteLine(falseLbl + ':');
    falseR := self.Tmp();
    self.WriteLine('  ' + falseR + ' = add i1 0, 0 ; null is ' + target + ' = false');
    self.WriteLine('  br label %' + exitLbl);
    self.WriteLine(exitLbl + ':');
    r := self.Tmp();
    self.WriteLine('  ' + r + ' = phi i1 [ ' + trueR + ', %' + trueLbl + ' ], [ ' + falseR + ', %' + falseLbl + ' ]');
    result := r;
    Exit;
  end;
  // v0.6.9 P4: unregistered target still gets a real vtable comparison —
  // gen2's Pass 0 runs `decl is TTypeDecl` while cn=1 (only hand-baked
  // TProgram), and the old constant-false fallback killed ALL class dispatch
  // in gen2. The target's vtable constant always exists in the output IR
  // (ast.klx's classes are emitted in Pass 2).
  selfReg := self.EmitExpr(e.Expression);
  objVT := self.Tmp();
  self.WriteLine('  ' + objVT + ' = load ptr, ptr ' + selfReg);
  r := self.Tmp();
  self.WriteLine('  ' + r + ' = call i1 @__kylix_class_is_a(ptr ' + objVT + ', ptr @' + target + '_vtable)');
  self.NeedClassRTTI := true;
  result := r;
end;

function TLLVMGenerator.EmitAsExpr(e: TTypeCastExpression; t: String): String;
var tn: String;
begin
  self.LastType := 'ptr';
  result := self.EmitExpr(e.Expression);
  // v0.6.9 P4: report the CAST's target class name as LastType — `at := e as
  // TArrayType` must register `at` with Kylix type TArrayType, or a following
  // `at.Dynamic` member read resolves no receiver class (unhandled stub →
  // `br i1 ptr` verifier error). TargetType read via a local (as-chain safe).
  tn := self.TypeExprName(e.TargetType);
  if tn <> '' then
  begin
    if self.IsClass(tn) then self.LastType := tn;
  end;
end;

function TLLVMGenerator.EmitArrayIndex(idx: TIndexExpression; t: String): String;
var
  leftName, r: String;
begin
  // local/param array var: arr[i]
  if idx.Left is TIdentifier then
  begin
    leftName := (idx.Left as TIdentifier).Value;
    if self.IsArrayVar(leftName) then
    begin
      result := self.EmitArrayIndexLocal(leftName, idx.Index, t);
      Exit;
    end;
  end;
  // class-field dynamic array: obj.Field[i] — load the slice struct from the
  // field slot (GEP), then extract data ptr + GEP element. TryClassFieldArrayIndex
  // / TryClassFieldMapIndexGet return Boolean only and hand the loaded element
  // register back through LastArrayReg (see class field decl above).
  if idx.Left is TMemberExpression then
  begin
    if self.TryClassFieldArrayIndex(idx, t) then
    begin
      result := self.LastArrayReg;
      Exit;
    end;
    if self.TryClassFieldMapIndexGet(idx, t) then
    begin
      result := self.LastArrayReg;
      Exit;
    end;
  end;
  // local/global map var: m[key] → htab_get with value-type coercion.
  if idx.Left is TIdentifier then
  begin
    leftName := (idx.Left as TIdentifier).Value;
    if self.IsLocalMap(leftName) then
    begin
      result := self.EmitMapIndexGet(leftName, idx.Index, self.MapValueType(leftName));
      Exit;
    end;
    if self.GMapValueType(leftName) <> '' then
    begin
      result := self.EmitMapIndexGet(leftName, idx.Index, self.GMapValueType(leftName));
      Exit;
    end;
  end;
  // unsupported index target (map / variant — P3)
  self.LastType := 'i64';
  r := self.Tmp();
  self.WriteLine('  ' + r + ' = add i64 0, 0 ; array index (unhandled)');
  result := r;
end;

// EmitMapIndexGet — m[key] for a map local/global (the htab slot holds a ptr
// to the htab handle). Mirrors host emitMapIndexGet + mapReadResult:
//   - Boolean value → icmp ne ptr, null (presence; miss → false)
//   - Integer/enum → null-guard then atoll → i64 (miss → 0)
//   - String → null-guard → ptr (miss → "")
//   - array-of-T value → zero slice { null, 0, 0 } (absent; Length=0)
function TLLVMGenerator.EmitMapIndexGet(name: String; keyExpr: TExpression; valueKylix: String): String;
var
  tbl, keyReg, r, guarded, conv, b, z: String;
begin
  tbl := self.Tmp();
  if self.HasLocal(name) then
    self.WriteLine('  ' + tbl + ' = load ptr, ptr ' + self.LocalReg(name))
  else
    self.WriteLine('  ' + tbl + ' = load ptr, ptr ' + self.GReg(name));
  self.NeedHashtab := true;
  keyReg := self.EmitExpr(keyExpr);
  r := self.Tmp();
  self.WriteLine('  ' + r + ' = call ptr @__kylix_htab_get(ptr ' + tbl + ', ptr ' + keyReg + ')');
  // v0.6.9 P3: Variant-valued maps (map[String] Variant) read back as boxes —
  // htab_get_variant returns the shared nilbox on a miss.
  if valueKylix = 'Variant' then
  begin
    b := self.Tmp();
    self.WriteLine('  ' + b + ' = call ptr @__kylix_htab_get_variant(ptr ' + tbl + ', ptr ' + keyReg + ')');
    self.LastType := 'ptr';
    result := b;
    Exit;
  end;
  if self.IsMapArrayValue(valueKylix) then
  begin
    // absent value (arrays can't round-trip through the string htab) → zero slice
    z := self.Tmp();
    self.WriteLine('  ' + z + ' = insertvalue { ptr, i64, i64 } zeroinitializer, ptr null, 0');
    self.LastType := '{ ptr, i64, i64 }';
    result := z;
    Exit;
  end;
  if self.IsBooleanKylix(valueKylix) then
  begin
    b := self.Tmp();
    self.WriteLine('  ' + b + ' = icmp ne ptr ' + r + ', null');
    self.LastType := 'i1';
    result := b;
    Exit;
  end;
  guarded := self.NullGuardString(r);
  if self.IsIntegerKylix(valueKylix) then
  begin
    self.NeedAtoll := true;
    conv := self.Tmp();
    self.WriteLine('  ' + conv + ' = call i64 @atoll(ptr ' + guarded + ')');
    self.LastType := 'i64';
    result := conv;
    Exit;
  end;
  self.LastType := 'ptr';
  result := guarded;
end;

// TryClassFieldMapIndexGet — obj.Field[key] where Field is a map-typed class
// field → GEP the field's htab slot + htab_get (mirrors host
// emitMapFieldIndexGet). Array-valued maps return a zero slice.
function TLLVMGenerator.TryClassFieldMapIndexGet(idx: TIndexExpression; t: String): Boolean;
var
  mem: TMemberExpression;
  classT, selfReg, objReg, valueKylix, tbl, keyReg, r, guarded, conv, b, z: String;
  ci, fi: Integer;
  ctypes: array of String;
begin
  result := false;
  mem := idx.Left as TMemberExpression;
  classT := '';
  if mem.Obj is TIdentifier then
  begin
    if (mem.Obj as TIdentifier).Value = 'self' then
      classT := self.CurClassName
    else
      classT := self.LocalKylix((mem.Obj as TIdentifier).Value);
    if classT = '' then classT := self.GKylix((mem.Obj as TIdentifier).Value);
  end
  else if mem.Obj is TIndexExpression then
  begin
    // v0.6.9 P4: `progs[pi].Declarations[i]` — the member's receiver is an
    // index expression; emit it once (LastType carries the element class).
    selfReg := self.EmitExpr(mem.Obj);
    if self.IsClass(self.LastType) then classT := self.LastType;
  end;
  if not self.IsClass(classT) then Exit;
  ci := self.ClassIndex(classT);
  fi := self.FieldIndex(classT, mem.Member);
  if fi < 0 then Exit;
  if not self.FieldMapAt(ci, fi) then Exit;
  valueKylix := self.FieldMapValueKylix(ci, fi);
  // resolve self/obj ptr (mirrors TryClassFieldArrayIndex)
  if mem.Obj is TIdentifier then
  begin
    if (mem.Obj as TIdentifier).Value = 'self' then
        selfReg := '%self'
    else
    begin
      if self.HasLocal((mem.Obj as TIdentifier).Value) then
      begin
        objReg := self.LocalReg((mem.Obj as TIdentifier).Value);
        selfReg := self.Tmp();
        self.WriteLine('  ' + selfReg + ' = load ptr, ptr ' + objReg);
      end
      else
      begin
        objReg := self.GReg((mem.Obj as TIdentifier).Value);
        selfReg := self.Tmp();
        self.WriteLine('  ' + selfReg + ' = load ptr, ptr ' + objReg);
      end;
    end;
  end
  else
    selfReg := self.EmitExpr(mem.Obj);
  // field slot → htab handle
  tbl := self.Tmp();
  self.WriteLine('  ' + tbl + ' = getelementptr inbounds %' + classT + ', ptr ' + selfReg + ', i32 0, i32 ' + self.IntToStrS(fi + 1));
  self.NeedHashtab := true;
  keyReg := self.EmitExpr(idx.Index);
  r := self.Tmp();
  self.WriteLine('  ' + r + ' = call ptr @__kylix_htab_get(ptr ' + tbl + ', ptr ' + keyReg + ')');
  if self.IsMapArrayValue(valueKylix) then
  begin
    z := self.Tmp();
    self.WriteLine('  ' + z + ' = insertvalue { ptr, i64, i64 } zeroinitializer, ptr null, 0');
    self.LastArrayReg := z;
    self.LastType := '{ ptr, i64, i64 }';
    result := true;
    Exit;
  end;
  if self.IsBooleanKylix(valueKylix) then
  begin
    b := self.Tmp();
    self.WriteLine('  ' + b + ' = icmp ne ptr ' + r + ', null');
    self.LastArrayReg := b;
    self.LastType := 'i1';
    result := true;
    Exit;
  end;
  guarded := self.NullGuardString(r);
  if self.IsIntegerKylix(valueKylix) then
  begin
    self.NeedAtoll := true;
    conv := self.Tmp();
    self.WriteLine('  ' + conv + ' = call i64 @atoll(ptr ' + guarded + ')');
    self.LastArrayReg := conv;
    self.LastType := 'i64';
    result := true;
    Exit;
  end;
  self.LastArrayReg := guarded;
  self.LastType := 'ptr';
  result := true;
end;

// TryClassFieldArrayIndex — obj.Field[i] where Field is a class field of type
// array of T (dynamic slice). Returns true and sets t/result on success.
function TLLVMGenerator.TryClassFieldArrayIndex(idx: TIndexExpression; t: String): Boolean;
var
  mem: TMemberExpression;
  classT, selfReg, objReg, fieldT, elemK: String;
  ci, fi, i: Integer;
  idxReg, zeroIdx, dataPtrLoc, dataPtr, dataPtr2, ptr, loaded: String;
  ctypes: array of String;
  elemLLVM: String;
begin
  result := false;
  mem := idx.Left as TMemberExpression;
  classT := '';
  if mem.Obj is TIdentifier then
  begin
    if (mem.Obj as TIdentifier).Value = 'self' then
      classT := self.CurClassName
    else
      classT := self.LocalKylix((mem.Obj as TIdentifier).Value);
    if classT = '' then classT := self.GKylix((mem.Obj as TIdentifier).Value);
  end;
  if not self.IsClass(classT) then Exit;
  ci := self.ClassIndex(classT);
  fi := self.FieldIndex(classT, mem.Member);
  if fi < 0 then Exit;
  ctypes := [];
  for i := 0 to self.ClassFieldCountAt(ci) - 1 do
    append(ctypes, self.FieldTypeAt(ci,i));
  fieldT := ctypes[fi];
  if fieldT <> '{ ptr, i64, i64 }' then Exit;
  // resolve self/obj ptr
  if mem.Obj is TIdentifier then
  begin
    if (mem.Obj as TIdentifier).Value = 'self' then
        selfReg := '%self'
    else
    begin
      if self.HasLocal((mem.Obj as TIdentifier).Value) then
      begin
        objReg := self.LocalReg((mem.Obj as TIdentifier).Value);
        selfReg := self.Tmp();
        self.WriteLine('  ' + selfReg + ' = load ptr, ptr ' + objReg);
      end
      else
      begin
        objReg := self.GReg((mem.Obj as TIdentifier).Value);
        selfReg := self.Tmp();
        self.WriteLine('  ' + selfReg + ' = load ptr, ptr ' + objReg);
      end;
    end;
  end
  else if mem.Obj is TIndexExpression then
  begin
    // v0.6.9 P4: already emitted in the classT resolution above.
  end
  else
    selfReg := self.EmitExpr(mem.Obj);
  // data ptr = GEP field slot (index fi+1) → load {ptr,len,cap} → extract 0
  dataPtrLoc := self.Tmp();
  self.WriteLine('  ' + dataPtrLoc + ' = getelementptr inbounds %' + classT + ', ptr ' + selfReg + ', i32 0, i32 ' + self.IntToStrS(fi + 1));
  dataPtr := self.Tmp();
  self.WriteLine('  ' + dataPtr + ' = load { ptr, i64, i64 }, ptr ' + dataPtrLoc);
  dataPtr2 := self.Tmp();
  self.WriteLine('  ' + dataPtr2 + ' = extractvalue { ptr, i64, i64 } ' + dataPtr + ', 0');
  idxReg := self.EmitExpr(idx.Index);
  zeroIdx := self.Tmp();
  self.WriteLine('  ' + zeroIdx + ' = add i64 ' + idxReg + ', 0');
  // array-of-class element (e.g. Errors: array of TDiagnostic) → element is a
  // heap ptr; GEP in ptr and load ptr, and report the ELEMENT class so a
  // following .Member / .Method resolves the receiver.
  elemK := self.FieldElemKylixAt(ci, fi);
  // v0.6.9 P4: String elements are ptr-typed too — tagging them 'i64' made
  // `self.Output := self.OutputChunks[0]` ptrtoint the handle and the next
  // strlen dereferenced an integer (SIGBUS). Normalize ptr-like element types.
  if elemK = 'String' then
  begin
    elemLLVM := 'ptr';
    self.LastType := 'ptr';
  end
  else if (elemK <> '') and self.IsClass(elemK) then
  begin
    elemLLVM := 'ptr';
    self.LastType := elemK;
  end
  else
  begin
    elemLLVM := 'i64';
    self.LastType := 'i64';
  end;
  ptr := self.Tmp();
  self.WriteLine('  ' + ptr + ' = getelementptr inbounds ' + elemLLVM + ', ptr ' + dataPtr2 + ', i64 ' + zeroIdx);
  loaded := self.Tmp();
  self.WriteLine('  ' + loaded + ' = load ' + elemLLVM + ', ptr ' + ptr);
  self.LastArrayReg := loaded;
  result := true;
end;

// JoinStr joins a string array with a delimiter.
function TLLVMGenerator.JoinStr(arr: array of String; sep: String): String;
var
  i: Integer;
  s: String;
begin
  s := '';
  for i := 0 to Length(arr) - 1 do
  begin
    if i > 0 then s := s + sep;
    s := s + arr[i];
  end;
  result := s;
end;

// ============================================================================
// Hash-table runtime (map[K]V backing store)
// ============================================================================
// Mirrors host pkg/llvmgen/stdlib_hashtab.go byte-for-byte: separate chaining
// with 256 buckets; header = {ptr buckets, i64 size} (16B); node =
// {ptr key, ptr value, ptr next} (24B). Keys strdup'd on insert; values stored
// as-is. Emitted once per module when NeedHashtab is set.
//
//   htab_new()            -> ptr
//   htab_hash(key)        -> i64  (djb2 masked & 255)
//   htab_find(t,key)      -> ptr  (node or null)
//   htab_put(t,key,val)   -> void
//   htab_get(t,key)       -> ptr  (value or null on miss)
//   htab_has(t,key)       -> i1
//   htab_del(t,key)       -> void
//   htab_size(t)          -> i64
//   htab_clear(t)         -> void
//   htab_strdup(s)        -> ptr

procedure TLLVMGenerator.EmitHashtabBodies;
begin
  self.EmitHashtabNew();
  self.EmitHashtabHash();
  self.EmitHashtabFind();
  self.EmitHashtabPut();
  self.EmitHashtabGet();
  self.EmitHashtabHas();
  self.EmitHashtabDel();
  self.EmitHashtabSize();
  self.EmitHashtabClear();
  self.EmitHashtabStrdup();
end;

// htab_new: ptr @__kylix_htab_new()
procedure TLLVMGenerator.EmitHashtabNew;
var
  hdr, buckets, sizePtr: String;
begin
  self.WriteLine('define ptr @__kylix_htab_new() {');
  self.WriteLine('entry:');
  hdr := self.Tmp();
  self.WriteLine('  ' + hdr + ' = call ptr @malloc(i64 16)');
  buckets := self.Tmp();
  self.WriteLine('  ' + buckets + ' = call ptr @malloc(i64 2048)');
  self.WriteLine('  call void @llvm.memset.p0.i64(ptr ' + buckets + ', i8 0, i64 2048, i1 false)');
  self.WriteLine('  store ptr ' + buckets + ', ptr ' + hdr);
  sizePtr := self.Tmp();
  self.WriteLine('  ' + sizePtr + ' = getelementptr inbounds i8, ptr ' + hdr + ', i64 8');
  self.WriteLine('  store i64 0, ptr ' + sizePtr);
  self.WriteLine('  ret ptr ' + hdr);
  self.WriteLine('}');
  self.WriteLine('');
end;

// htab_hash: i64 @__kylix_htab_hash(ptr %key) — djb2, masked to bucket range.
procedure TLLVMGenerator.EmitHashtabHash;
var
  hSlot, pSlot, condLbl, bodyLbl, exitLbl: String;
  curP, c, isZero, cv, curH, h33, newH, nextP, finalH, masked: String;
begin
  self.WriteLine('define i64 @__kylix_htab_hash(ptr %key) {');
  self.WriteLine('entry:');
  hSlot := self.Tmp();
  self.WriteLine('  ' + hSlot + ' = alloca i64, align 8');
  self.WriteLine('  store i64 5381, ptr ' + hSlot);
  pSlot := self.Tmp();
  self.WriteLine('  ' + pSlot + ' = alloca ptr, align 8');
  self.WriteLine('  store ptr %key, ptr ' + pSlot);
  condLbl := self.Label();
  bodyLbl := self.Label();
  exitLbl := self.Label();
  self.WriteLine('  br label %' + condLbl);
  self.WriteLine(condLbl + ':');
  curP := self.Tmp();
  self.WriteLine('  ' + curP + ' = load ptr, ptr ' + pSlot);
  c := self.Tmp();
  self.WriteLine('  ' + c + ' = load i8, ptr ' + curP);
  isZero := self.Tmp();
  self.WriteLine('  ' + isZero + ' = icmp eq i8 ' + c + ', 0');
  self.WriteLine('  br i1 ' + isZero + ', label %' + exitLbl + ', label %' + bodyLbl);
  self.WriteLine(bodyLbl + ':');
  cv := self.Tmp();
  self.WriteLine('  ' + cv + ' = zext i8 ' + c + ' to i64');
  curH := self.Tmp();
  self.WriteLine('  ' + curH + ' = load i64, ptr ' + hSlot);
  h33 := self.Tmp();
  self.WriteLine('  ' + h33 + ' = mul i64 ' + curH + ', 33');
  newH := self.Tmp();
  self.WriteLine('  ' + newH + ' = add i64 ' + h33 + ', ' + cv);
  self.WriteLine('  store i64 ' + newH + ', ptr ' + hSlot);
  nextP := self.Tmp();
  self.WriteLine('  ' + nextP + ' = getelementptr inbounds i8, ptr ' + curP + ', i64 1');
  self.WriteLine('  store ptr ' + nextP + ', ptr ' + pSlot);
  self.WriteLine('  br label %' + condLbl);
  self.WriteLine(exitLbl + ':');
  finalH := self.Tmp();
  self.WriteLine('  ' + finalH + ' = load i64, ptr ' + hSlot);
  masked := self.Tmp();
  self.WriteLine('  ' + masked + ' = and i64 ' + finalH + ', 255');
  self.WriteLine('  ret i64 ' + masked);
  self.WriteLine('}');
  self.WriteLine('');
end;

// htab_find: ptr @__kylix_htab_find(ptr %t, ptr %key) — node or null.
procedure TLLVMGenerator.EmitHashtabFind;
var
  buckets, idx, bucketPtr, nodeSlot, firstNode, condLbl, bodyLbl: String;
  exitFoundLbl, exitMissLbl: String;
  node, isNull, keyPtr, nodeKey, cmp, eq, nextPtr, nxt: String;
begin
  self.WriteLine('define ptr @__kylix_htab_find(ptr %t, ptr %key) {');
  self.WriteLine('entry:');
  buckets := self.Tmp();
  self.WriteLine('  ' + buckets + ' = load ptr, ptr %t');
  idx := self.Tmp();
  self.WriteLine('  ' + idx + ' = call i64 @__kylix_htab_hash(ptr %key)');
  bucketPtr := self.Tmp();
  self.WriteLine('  ' + bucketPtr + ' = getelementptr inbounds ptr, ptr ' + buckets + ', i64 ' + idx);
  nodeSlot := self.Tmp();
  self.WriteLine('  ' + nodeSlot + ' = alloca ptr, align 8');
  firstNode := self.Tmp();
  self.WriteLine('  ' + firstNode + ' = load ptr, ptr ' + bucketPtr);
  self.WriteLine('  store ptr ' + firstNode + ', ptr ' + nodeSlot);
  condLbl := self.Label();
  bodyLbl := self.Label();
  exitFoundLbl := self.Label();
  exitMissLbl := self.Label();
  self.WriteLine('  br label %' + condLbl);
  self.WriteLine(condLbl + ':');
  node := self.Tmp();
  self.WriteLine('  ' + node + ' = load ptr, ptr ' + nodeSlot);
  isNull := self.Tmp();
  self.WriteLine('  ' + isNull + ' = icmp eq ptr ' + node + ', null');
  self.WriteLine('  br i1 ' + isNull + ', label %' + exitMissLbl + ', label %' + bodyLbl);
  self.WriteLine(bodyLbl + ':');
  keyPtr := self.Tmp();
  self.WriteLine('  ' + keyPtr + ' = getelementptr inbounds i8, ptr ' + node + ', i64 0');
  nodeKey := self.Tmp();
  self.WriteLine('  ' + nodeKey + ' = load ptr, ptr ' + keyPtr);
  cmp := self.Tmp();
  self.WriteLine('  ' + cmp + ' = call i32 @strcmp(ptr ' + nodeKey + ', ptr %key)');
  eq := self.Tmp();
  self.WriteLine('  ' + eq + ' = icmp eq i32 ' + cmp + ', 0');
  self.WriteLine('  br i1 ' + eq + ', label %' + exitFoundLbl + ', label %next');
  self.WriteLine('next:');
  nextPtr := self.Tmp();
  self.WriteLine('  ' + nextPtr + ' = getelementptr inbounds i8, ptr ' + node + ', i64 16');
  nxt := self.Tmp();
  self.WriteLine('  ' + nxt + ' = load ptr, ptr ' + nextPtr);
  self.WriteLine('  store ptr ' + nxt + ', ptr ' + nodeSlot);
  self.WriteLine('  br label %' + condLbl);
  self.WriteLine(exitFoundLbl + ':');
  self.WriteLine('  ret ptr ' + node);
  self.WriteLine(exitMissLbl + ':');
  self.WriteLine('  ret ptr null');
  self.WriteLine('}');
  self.WriteLine('');
end;

// htab_put: void @__kylix_htab_put(ptr %t, ptr %key, ptr %val)
procedure TLLVMGenerator.EmitHashtabPut;
var
  existing, hasExisting, updateLbl, insertLbl: String;
  valPtr, newNode, keyField, dup, valField, buckets, idx, bucketPtr: String;
  oldHead, nextField, sizePtr, curSize, newSize: String;
begin
  self.WriteLine('define void @__kylix_htab_put(ptr %t, ptr %key, ptr %val) {');
  self.WriteLine('entry:');
  existing := self.Tmp();
  self.WriteLine('  ' + existing + ' = call ptr @__kylix_htab_find(ptr %t, ptr %key)');
  hasExisting := self.Tmp();
  self.WriteLine('  ' + hasExisting + ' = icmp ne ptr ' + existing + ', null');
  updateLbl := self.Label();
  insertLbl := self.Label();
  self.WriteLine('  br i1 ' + hasExisting + ', label %' + updateLbl + ', label %' + insertLbl);
  self.WriteLine(updateLbl + ':');
  valPtr := self.Tmp();
  self.WriteLine('  ' + valPtr + ' = getelementptr inbounds i8, ptr ' + existing + ', i64 8');
  self.WriteLine('  store ptr %val, ptr ' + valPtr);
  self.WriteLine('  ret void');
  self.WriteLine(insertLbl + ':');
  newNode := self.Tmp();
  self.WriteLine('  ' + newNode + ' = call ptr @malloc(i64 24)');
  keyField := self.Tmp();
  self.WriteLine('  ' + keyField + ' = getelementptr inbounds i8, ptr ' + newNode + ', i64 0');
  dup := self.Tmp();
  self.WriteLine('  ' + dup + ' = call ptr @__kylix_htab_strdup(ptr %key)');
  self.WriteLine('  store ptr ' + dup + ', ptr ' + keyField);
  valField := self.Tmp();
  self.WriteLine('  ' + valField + ' = getelementptr inbounds i8, ptr ' + newNode + ', i64 8');
  self.WriteLine('  store ptr %val, ptr ' + valField);
  buckets := self.Tmp();
  self.WriteLine('  ' + buckets + ' = load ptr, ptr %t');
  idx := self.Tmp();
  self.WriteLine('  ' + idx + ' = call i64 @__kylix_htab_hash(ptr %key)');
  bucketPtr := self.Tmp();
  self.WriteLine('  ' + bucketPtr + ' = getelementptr inbounds ptr, ptr ' + buckets + ', i64 ' + idx);
  oldHead := self.Tmp();
  self.WriteLine('  ' + oldHead + ' = load ptr, ptr ' + bucketPtr);
  nextField := self.Tmp();
  self.WriteLine('  ' + nextField + ' = getelementptr inbounds i8, ptr ' + newNode + ', i64 16');
  self.WriteLine('  store ptr ' + oldHead + ', ptr ' + nextField);
  self.WriteLine('  store ptr ' + newNode + ', ptr ' + bucketPtr);
  sizePtr := self.Tmp();
  self.WriteLine('  ' + sizePtr + ' = getelementptr inbounds i8, ptr %t, i64 8');
  curSize := self.Tmp();
  self.WriteLine('  ' + curSize + ' = load i64, ptr ' + sizePtr);
  newSize := self.Tmp();
  self.WriteLine('  ' + newSize + ' = add i64 ' + curSize + ', 1');
  self.WriteLine('  store i64 ' + newSize + ', ptr ' + sizePtr);
  self.WriteLine('  ret void');
  self.WriteLine('}');
  self.WriteLine('');
end;

// htab_get: ptr @__kylix_htab_get(ptr %t, ptr %key) — value or null on miss.
procedure TLLVMGenerator.EmitHashtabGet;
var
  node, isNull, retNullLbl, retValLbl, valPtr, v: String;
begin
  self.WriteLine('define ptr @__kylix_htab_get(ptr %t, ptr %key) {');
  self.WriteLine('entry:');
  node := self.Tmp();
  self.WriteLine('  ' + node + ' = call ptr @__kylix_htab_find(ptr %t, ptr %key)');
  isNull := self.Tmp();
  self.WriteLine('  ' + isNull + ' = icmp eq ptr ' + node + ', null');
  retNullLbl := self.Label();
  retValLbl := self.Label();
  self.WriteLine('  br i1 ' + isNull + ', label %' + retNullLbl + ', label %' + retValLbl);
  self.WriteLine(retNullLbl + ':');
  self.WriteLine('  ret ptr null');
  self.WriteLine(retValLbl + ':');
  valPtr := self.Tmp();
  self.WriteLine('  ' + valPtr + ' = getelementptr inbounds i8, ptr ' + node + ', i64 8');
  v := self.Tmp();
  self.WriteLine('  ' + v + ' = load ptr, ptr ' + valPtr);
  self.WriteLine('  ret ptr ' + v);
  self.WriteLine('}');
  self.WriteLine('');
end;

// htab_has: i1 @__kylix_htab_has(ptr %t, ptr %key)
procedure TLLVMGenerator.EmitHashtabHas;
var
  node, r: String;
begin
  self.WriteLine('define i1 @__kylix_htab_has(ptr %t, ptr %key) {');
  self.WriteLine('entry:');
  node := self.Tmp();
  self.WriteLine('  ' + node + ' = call ptr @__kylix_htab_find(ptr %t, ptr %key)');
  r := self.Tmp();
  self.WriteLine('  ' + r + ' = icmp ne ptr ' + node + ', null');
  self.WriteLine('  ret i1 ' + r);
  self.WriteLine('}');
  self.WriteLine('');
end;

// htab_del: void @__kylix_htab_del(ptr %t, ptr %key)
procedure TLLVMGenerator.EmitHashtabDel;
var
  buckets, idx, bucketPtr, prevSlot, curSlot, firstCur: String;
  condLbl, bodyLbl, notFoundLbl, foundLbl: String;
  cur, isNull, keyPtr, curKey, cmp, eq, nextField, newCur: String;
  curNext, nextVal, prevPtr, sizePtr, curSize, newSize: String;
begin
  self.WriteLine('define void @__kylix_htab_del(ptr %t, ptr %key) {');
  self.WriteLine('entry:');
  buckets := self.Tmp();
  self.WriteLine('  ' + buckets + ' = load ptr, ptr %t');
  idx := self.Tmp();
  self.WriteLine('  ' + idx + ' = call i64 @__kylix_htab_hash(ptr %key)');
  bucketPtr := self.Tmp();
  self.WriteLine('  ' + bucketPtr + ' = getelementptr inbounds ptr, ptr ' + buckets + ', i64 ' + idx);
  prevSlot := self.Tmp();
  self.WriteLine('  ' + prevSlot + ' = alloca ptr, align 8');
  self.WriteLine('  store ptr ' + bucketPtr + ', ptr ' + prevSlot);
  curSlot := self.Tmp();
  self.WriteLine('  ' + curSlot + ' = alloca ptr, align 8');
  firstCur := self.Tmp();
  self.WriteLine('  ' + firstCur + ' = load ptr, ptr ' + bucketPtr);
  self.WriteLine('  store ptr ' + firstCur + ', ptr ' + curSlot);
  condLbl := self.Label();
  bodyLbl := self.Label();
  notFoundLbl := self.Label();
  foundLbl := self.Label();
  self.WriteLine('  br label %' + condLbl);
  self.WriteLine(condLbl + ':');
  cur := self.Tmp();
  self.WriteLine('  ' + cur + ' = load ptr, ptr ' + curSlot);
  isNull := self.Tmp();
  self.WriteLine('  ' + isNull + ' = icmp eq ptr ' + cur + ', null');
  self.WriteLine('  br i1 ' + isNull + ', label %' + notFoundLbl + ', label %' + bodyLbl);
  self.WriteLine(bodyLbl + ':');
  keyPtr := self.Tmp();
  self.WriteLine('  ' + keyPtr + ' = getelementptr inbounds i8, ptr ' + cur + ', i64 0');
  curKey := self.Tmp();
  self.WriteLine('  ' + curKey + ' = load ptr, ptr ' + keyPtr);
  cmp := self.Tmp();
  self.WriteLine('  ' + cmp + ' = call i32 @strcmp(ptr ' + curKey + ', ptr %key)');
  eq := self.Tmp();
  self.WriteLine('  ' + eq + ' = icmp eq i32 ' + cmp + ', 0');
  self.WriteLine('  br i1 ' + eq + ', label %' + foundLbl + ', label %advance');
  self.WriteLine('advance:');
  nextField := self.Tmp();
  self.WriteLine('  ' + nextField + ' = getelementptr inbounds i8, ptr ' + cur + ', i64 16');
  self.WriteLine('  store ptr ' + nextField + ', ptr ' + prevSlot);
  newCur := self.Tmp();
  self.WriteLine('  ' + newCur + ' = load ptr, ptr ' + nextField);
  self.WriteLine('  store ptr ' + newCur + ', ptr ' + curSlot);
  self.WriteLine('  br label %' + condLbl);
  self.WriteLine(foundLbl + ':');
  curNext := self.Tmp();
  self.WriteLine('  ' + curNext + ' = getelementptr inbounds i8, ptr ' + cur + ', i64 16');
  nextVal := self.Tmp();
  self.WriteLine('  ' + nextVal + ' = load ptr, ptr ' + curNext);
  prevPtr := self.Tmp();
  self.WriteLine('  ' + prevPtr + ' = load ptr, ptr ' + prevSlot);
  self.WriteLine('  store ptr ' + nextVal + ', ptr ' + prevPtr);
  self.WriteLine('  call void @free(ptr ' + cur + ')');
  sizePtr := self.Tmp();
  self.WriteLine('  ' + sizePtr + ' = getelementptr inbounds i8, ptr %t, i64 8');
  curSize := self.Tmp();
  self.WriteLine('  ' + curSize + ' = load i64, ptr ' + sizePtr);
  newSize := self.Tmp();
  self.WriteLine('  ' + newSize + ' = sub i64 ' + curSize + ', 1');
  self.WriteLine('  store i64 ' + newSize + ', ptr ' + sizePtr);
  self.WriteLine('  ret void');
  self.WriteLine(notFoundLbl + ':');
  self.WriteLine('  ret void');
  self.WriteLine('}');
  self.WriteLine('');
end;

// htab_size: i64 @__kylix_htab_size(ptr %t)
procedure TLLVMGenerator.EmitHashtabSize;
var
  sizePtr, s: String;
begin
  self.WriteLine('define i64 @__kylix_htab_size(ptr %t) {');
  self.WriteLine('entry:');
  sizePtr := self.Tmp();
  self.WriteLine('  ' + sizePtr + ' = getelementptr inbounds i8, ptr %t, i64 8');
  s := self.Tmp();
  self.WriteLine('  ' + s + ' = load i64, ptr ' + sizePtr);
  self.WriteLine('  ret i64 ' + s);
  self.WriteLine('}');
  self.WriteLine('');
end;

// htab_clear: void @__kylix_htab_clear(ptr %t) — free all nodes, reset size.
procedure TLLVMGenerator.EmitHashtabClear;
var
  buckets, iSlot, condLbl, bodyLbl, exitLbl: String;
  curI, done, bucketPtr, nodeSlot, firstNode, innerCond, innerBody: String;
  node, isEmpty, nextField, nxt, nextI, sizePtr: String;
begin
  self.WriteLine('define void @__kylix_htab_clear(ptr %t) {');
  self.WriteLine('entry:');
  buckets := self.Tmp();
  self.WriteLine('  ' + buckets + ' = load ptr, ptr %t');
  iSlot := self.Tmp();
  self.WriteLine('  ' + iSlot + ' = alloca i64, align 8');
  self.WriteLine('  store i64 0, ptr ' + iSlot);
  condLbl := self.Label();
  bodyLbl := self.Label();
  exitLbl := self.Label();
  self.WriteLine('  br label %' + condLbl);
  self.WriteLine(condLbl + ':');
  curI := self.Tmp();
  self.WriteLine('  ' + curI + ' = load i64, ptr ' + iSlot);
  done := self.Tmp();
  self.WriteLine('  ' + done + ' = icmp sge i64 ' + curI + ', 256');
  self.WriteLine('  br i1 ' + done + ', label %' + exitLbl + ', label %' + bodyLbl);
  self.WriteLine(bodyLbl + ':');
  bucketPtr := self.Tmp();
  self.WriteLine('  ' + bucketPtr + ' = getelementptr inbounds ptr, ptr ' + buckets + ', i64 ' + curI);
  nodeSlot := self.Tmp();
  self.WriteLine('  ' + nodeSlot + ' = alloca ptr, align 8');
  firstNode := self.Tmp();
  self.WriteLine('  ' + firstNode + ' = load ptr, ptr ' + bucketPtr);
  self.WriteLine('  store ptr ' + firstNode + ', ptr ' + nodeSlot);
  innerCond := self.Label();
  innerBody := self.Label();
  self.WriteLine('  br label %' + innerCond);
  self.WriteLine(innerCond + ':');
  node := self.Tmp();
  self.WriteLine('  ' + node + ' = load ptr, ptr ' + nodeSlot);
  isEmpty := self.Tmp();
  self.WriteLine('  ' + isEmpty + ' = icmp eq ptr ' + node + ', null');
  self.WriteLine('  br i1 ' + isEmpty + ', label %bucket_done, label %' + innerBody);
  self.WriteLine(innerBody + ':');
  nextField := self.Tmp();
  self.WriteLine('  ' + nextField + ' = getelementptr inbounds i8, ptr ' + node + ', i64 16');
  nxt := self.Tmp();
  self.WriteLine('  ' + nxt + ' = load ptr, ptr ' + nextField);
  self.WriteLine('  call void @free(ptr ' + node + ')');
  self.WriteLine('  store ptr ' + nxt + ', ptr ' + nodeSlot);
  self.WriteLine('  br label %' + innerCond);
  self.WriteLine('bucket_done:');
  self.WriteLine('  store ptr null, ptr ' + bucketPtr);
  nextI := self.Tmp();
  self.WriteLine('  ' + nextI + ' = add i64 ' + curI + ', 1');
  self.WriteLine('  store i64 ' + nextI + ', ptr ' + iSlot);
  self.WriteLine('  br label %' + condLbl);
  self.WriteLine(exitLbl + ':');
  sizePtr := self.Tmp();
  self.WriteLine('  ' + sizePtr + ' = getelementptr inbounds i8, ptr %t, i64 8');
  self.WriteLine('  store i64 0, ptr ' + sizePtr);
  self.WriteLine('  ret void');
  self.WriteLine('}');
  self.WriteLine('');
end;

// htab_strdup: ptr @__kylix_htab_strdup(ptr %s) — malloc+strcpy helper.
procedure TLLVMGenerator.EmitHashtabStrdup;
var
  ln, plus1, buf: String;
begin
  self.WriteLine('define ptr @__kylix_htab_strdup(ptr %s) {');
  self.WriteLine('entry:');
  ln := self.Tmp();
  self.WriteLine('  ' + ln + ' = call i64 @strlen(ptr %s)');
  plus1 := self.Tmp();
  self.WriteLine('  ' + plus1 + ' = add i64 ' + ln + ', 1');
  buf := self.Tmp();
  self.WriteLine('  ' + buf + ' = call ptr @malloc(i64 ' + plus1 + ')');
  self.WriteLine('  call ptr @strcpy(ptr ' + buf + ', ptr %s)');
  self.WriteLine('  ret ptr ' + buf);
  self.WriteLine('}');
  self.WriteLine('');
end;

// ============================================================================
// Class RTTI — @__kylix_classtab edge table + @__kylix_class_is_a helper
// ============================================================================
// Mirrors host pkg/llvmgen/rtti.go byte-for-byte: the vtable pointer of a class
// instance is a unique global constant, so pointer equality identifies a class;
// a child→parent vtable edge table (with each entry named %__kylix_class_edge)
// supports `obj is TClass` / `obj as TClass` subtype queries.
//
// Edge collection: iterate ClassNames (classes only — records never register in
// ClassNames; MakeClassInfo is only called for class decls), skip classes with
// no parent, then sort edges by child name (insertion sort — no sort.Strings in
// the bootstrap) to match host sort.Strings determinism.
//
// The helper is the v0.6.1 no-phi + memory-based version: %c/%i live in allocas
// and are load/stored per iteration. The old SSA-phi loop hung forever when the
// bootstrap compiler (58-class edge table) ran it.
// Emitted once per module when NeedClassRTTI is set (insertion point next to
// the EmitHashtabBodies call in EmitPrograms / EmitProgram).
procedure TLLVMGenerator.EmitClassRuntime;
var
  n, i, j: Integer;
  cname, pname: String;
  edgesC: array of String;
  edgesP: array of String;
  tmpC, tmpP: String;
  line: String;
  // helper emitter temps
  cSlot, iSlot, eq, condLbl, loopLbl, c, ii, oob, bodyLbl: String;
  slot, cvtPtr, cvt, iscur, foundLbl, loopNextLbl: String;
  pvtPtr, par, match, found2Lbl, i1r: String;
  retTrueLbl, retFalseLbl: String;
begin
  // 1. collect child→parent edges (deterministic: insert-sort by child name)
  n := 0;
  for i := 0 to Length(self.ClassNames) - 1 do
    if self.ClassParents[i] <> '' then
    begin
      append(edgesC, self.ClassNames[i]);
      append(edgesP, self.ClassParents[i]);
      n := n + 1;
    end;
  // insertion sort on edgesC (swap edgesP in lockstep) — mirrors sort.Strings
  for i := 1 to n - 1 do
  begin
    tmpC := edgesC[i];
    tmpP := edgesP[i];
    j := i;
    while (j > 0) and (edgesC[j-1] > tmpC) do
    begin
      edgesC[j] := edgesC[j-1];
      edgesP[j] := edgesP[j-1];
      j := j - 1;
    end;
    edgesC[j] := tmpC;
    edgesP[j] := tmpP;
  end;

  if n = 0 then
  begin
    // no class hierarchy — is/as class checks trivially false unless child==parent
    self.WriteLine('@__kylix_classtab = constant [0 x { ptr, ptr }] zeroinitializer');
    self.WriteLine('define i1 @__kylix_class_is_a(ptr %child, ptr %parent) {');
    self.WriteLine('entry:');
    eq := self.Tmp();
    self.WriteLine('  ' + eq + ' = icmp eq ptr %child, %parent');
    self.WriteLine('  ret i1 ' + eq);
    self.WriteLine('}');
    self.WriteLine('');
    Exit;
  end;

  // named struct type for one edge (LLVM requires named struct types for
  // array-of-struct constants; anonymous { ptr, ptr } triggers parse errors)
  self.WriteLine('%__kylix_class_edge = type { ptr, ptr }');
  line := '@__kylix_classtab = constant [' + self.IntToStrS(n) + ' x %__kylix_class_edge] [ ';
  for i := 0 to n - 1 do
  begin
    if i > 0 then line := line + ', ';
    line := line + '%__kylix_class_edge { ptr @' + edgesC[i] + '_vtable, ptr @' + edgesP[i] + '_vtable }';
  end;
  line := line + ' ]';
  self.WriteLine(line);
  self.WriteLine('');

  // define i1 @__kylix_class_is_a(ptr %child, ptr %parent)
  // Walks the child→parent chain: scan the edge table for the current child's
  // vtable; when found, if its parent matches %parent return true, else move
  // up one level (c = parent) and RESTART the scan from index 0. Memory-based
  // state (%c_slot/%i_slot) — the SSA-phi version hung in the bootstrap.
  self.WriteLine('define i1 @__kylix_class_is_a(ptr %child, ptr %parent) {');
  self.WriteLine('entry:');
  cSlot := self.Tmp();
  self.WriteLine('  ' + cSlot + ' = alloca ptr, align 8');
  iSlot := self.Tmp();
  self.WriteLine('  ' + iSlot + ' = alloca i64, align 8');
  self.WriteLine('  store ptr %child, ptr ' + cSlot);
  self.WriteLine('  store i64 0, ptr ' + iSlot);
  eq := self.Tmp();
  self.WriteLine('  ' + eq + ' = icmp eq ptr %child, %parent');
  retTrueLbl := self.Label();
  loopLbl := self.Label();
  self.WriteLine('  br i1 ' + eq + ', label %' + retTrueLbl + ', label %' + loopLbl);
  self.WriteLine(loopLbl + ':');
  c := self.Tmp();
  self.WriteLine('  ' + c + ' = load ptr, ptr ' + cSlot);
  ii := self.Tmp();
  self.WriteLine('  ' + ii + ' = load i64, ptr ' + iSlot);
  oob := self.Tmp();
  self.WriteLine('  ' + oob + ' = icmp eq i64 ' + ii + ', ' + self.IntToStrS(n));
  retFalseLbl := self.Label();
  bodyLbl := self.Label();
  self.WriteLine('  br i1 ' + oob + ', label %' + retFalseLbl + ', label %' + bodyLbl);
  self.WriteLine(bodyLbl + ':');
  slot := self.Tmp();
  self.WriteLine('  ' + slot + ' = getelementptr inbounds [' + self.IntToStrS(n) + ' x %__kylix_class_edge], ptr @__kylix_classtab, i64 0, i64 ' + ii);
  cvtPtr := self.Tmp();
  self.WriteLine('  ' + cvtPtr + ' = getelementptr inbounds %__kylix_class_edge, ptr ' + slot + ', i32 0, i32 0');
  cvt := self.Tmp();
  self.WriteLine('  ' + cvt + ' = load ptr, ptr ' + cvtPtr);
  iscur := self.Tmp();
  self.WriteLine('  ' + iscur + ' = icmp eq ptr ' + cvt + ', ' + c);
  foundLbl := self.Label();
  loopNextLbl := self.Label();
  self.WriteLine('  br i1 ' + iscur + ', label %' + foundLbl + ', label %' + loopNextLbl);
  self.WriteLine(foundLbl + ':');
  pvtPtr := self.Tmp();
  self.WriteLine('  ' + pvtPtr + ' = getelementptr inbounds %__kylix_class_edge, ptr ' + slot + ', i32 0, i32 1');
  par := self.Tmp();
  self.WriteLine('  ' + par + ' = load ptr, ptr ' + pvtPtr);
  match := self.Tmp();
  self.WriteLine('  ' + match + ' = icmp eq ptr ' + par + ', %parent');
  found2Lbl := self.Label();
  self.WriteLine('  br i1 ' + match + ', label %' + retTrueLbl + ', label %' + found2Lbl);
  self.WriteLine(found2Lbl + ':');
  self.WriteLine('  store ptr ' + par + ', ptr ' + cSlot);
  self.WriteLine('  store i64 0, ptr ' + iSlot);
  self.WriteLine('  br label %' + loopLbl);
  self.WriteLine(loopNextLbl + ':');
  i1r := self.Tmp();
  self.WriteLine('  ' + i1r + ' = add i64 ' + ii + ', 1');
  self.WriteLine('  store i64 ' + i1r + ', ptr ' + iSlot);
  self.WriteLine('  br label %' + loopLbl);
  self.WriteLine(retTrueLbl + ':');
  self.WriteLine('  ret i1 true');
  self.WriteLine(retFalseLbl + ':');
  self.WriteLine('  ret i1 false');
  self.WriteLine('}');
  self.WriteLine('');
end;

end.
